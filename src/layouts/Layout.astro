---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Icon from '../components/Icon.astro';
import UtnMark from '../components/UtnMark.astro';
import UserBar from '../components/UserBar.astro';
import LoginModal from '../components/LoginModal.astro';
import Bienvenida from '../components/Bienvenida.astro';

export type Tab = 'materias' | 'finales' | 'mis' | 'ayuda' | 'escribir';
export interface Crumb { label: string; href?: string }

interface Props {
  title: string;
  description?: string;
  /** Imagen para previsualización en WhatsApp/Twitter (opcional) */
  ogImage?: string;
  /** JSON-LD (Datos Estructurados) en formato string para Google (opcional) */
  schema?: string;
  /** Pestaña del banner que queda marcada */
  tab?: Tab;
  /** Migas de pan ("Estás en: …"). La última es la página actual. */
  crumbs?: Crumb[];
  /** Clase extra del foro (por ejemplo "home") */
  forumClass?: string;
  /** Panel de admin: mantiene su diseño oscuro original adentro del foro */
  legacy?: boolean;
}

const {
  title,
  description = 'Reseñas reales de materias, cátedras y profesores de Ingeniería en Sistemas — UTN FRC. Elegí mejor tu cursada.',
  ogImage = '/og-image.png',
  schema,
  tab,
  crumbs,
  forumClass,
  legacy = false,
} = Astro.props;

const user = Astro.locals.user;
const canonicalURL = Astro.url.href;
const siteURL = Astro.url.origin;
const ogImageUrl = new URL(ogImage, siteURL).href;
const anio = new Date().getFullYear();
const cur = (t: Tab) => (tab === t ? 'page' : undefined);
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content="UTN FRC, reseñas materias UTN, opiniones cátedras UTN, ingeniería en sistemas, UTN Córdoba, cursada UTN, profesores UTN FRC, materias sistemas UTN" />
    <meta name="author" content="Patricio Valentín Andrade" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#133d68" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="UTN REP" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {legacy && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
      </>
    )}
    <title>{title}</title>

    <!-- Modo noche: se decide antes de pintar para que no parpadee -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "UTN REP",
      "url": siteURL,
      "description": "Reseñas y opiniones de materias, cátedras y profesores de Ingeniería en Sistemas de la UTN FRC.",
      "inLanguage": "es-AR",
      "publisher": {
        "@type": "Organization",
        "name": "UTN REP"
      }
    })} />

    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="foro">
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class:list={['forum', forumClass]}>
      <header class="banner">
        <div class="holes" aria-hidden="true"><i></i><i></i><i></i></div>
        <a class="logo" href="/" aria-label="UTN REP, ver todas las materias">
          <UtnMark />
          <span><b>UTN <span>REP</span></b><small>Reseñas de Ingeniería en Sistemas, UTN Facultad Regional Córdoba</small></span>
        </a>
        <div class="search" id="search-container">
          <form role="search" action="/buscar" method="get" id="search-form">
            <label class="sr" for="search-input">Buscar materia, curso o profesor</label>
            <input id="search-input" type="search" name="q" placeholder="Buscar materia, curso o profe" autocomplete="off"
              role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" />
            <button class="btn secondary" type="submit"><Icon name="search" /><span>Buscar</span></button>
          </form>
          <span class="hint">Probá con "paradigmas", "2K3" o el apellido de un profe</span>
          <div id="search-results" class="suggest hidden" role="listbox" aria-label="Resultados"></div>
        </div>
        <nav class="tabs" aria-label="Secciones">
          <a href="/" aria-current={cur('materias')}><Icon name="book" />Materias</a>
          <a href="/finales" aria-current={cur('finales')} data-nuevo="finales"><Icon name="final" />Experiencias de finales</a>
          {user && <a href="/mis-resenas" aria-current={cur('mis')}><Icon name="user" />Mis reseñas</a>}
          <a href="/sobre" aria-current={cur('ayuda')}><Icon name="info" />¿Cómo funciona?</a>
          <a class="write-tab" href="/nueva-resena" aria-current={cur('escribir')}><Icon name="pen" /> Escribir una reseña</a>
        </nav>
      </header>

      <UserBar user={user} />

      {crumbs && crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Estás en">
          <span>Estás en:</span>
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">›</span>}
              {i === crumbs.length - 1 || !c.href
                ? <strong aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.label}</strong>
                : <a href={c.href}>{c.label}</a>}
            </>
          ))}
          {tab !== 'materias' && <a class="up" href="/">Ver todas las materias</a>}
        </nav>
      )}

      <main id="contenido">
        {legacy ? <div class="legacy"><slot /></div> : <slot />}
      </main>

      <footer class="foot">
        <span>
          <a href="/sobre">¿Cómo funciona?</a> | <a href="/terminos">Términos y condiciones</a> | <a href="mailto:patriciovandrade@gmail.com?subject=Error%20en%20UTN%20REP">Reportar un error</a> | <a class="cafe-link" href="https://cafecito.app/utnrep" target="_blank" rel="noopener noreferrer"><Icon name="cup" /> Invitame un cafecito</a>
        </span>
        <span>Desarrollado por Patricio Valentín Andrade, {anio}</span>
      </footer>

      <nav class="bottombar" aria-label="Navegación rápida">
        <a href="/" aria-current={cur('materias')}><Icon name="book" /><span>Materias</span></a>
        <a href="/finales" aria-current={cur('finales')}><Icon name="final" /><span>Finales</span></a>
        <a class="write" href="/nueva-resena" aria-current={cur('escribir')}><Icon name="pen" /><span>Escribir</span></a>
        {user
          ? <a href="/mis-resenas" aria-current={cur('mis')}><Icon name="user" /><span>Mis reseñas</span></a>
          : <button type="button" data-login><Icon name="user" /><span>Ingresar</span></button>}
      </nav>
    </div>

    {!user && <LoginModal />}
    {!legacy && <Bienvenida />}

    <Analytics />
  </body>
</html>

<script>
  // ========== ÚLTIMA VISITA ==========
  import { visitaAnterior, textoVisita } from '../scripts/visitas';
  const anteriorVisita = visitaAnterior();
  const spanVisita = document.getElementById('ultima-visita');
  if (spanVisita && anteriorVisita) spanVisita.textContent = `Tu última visita: ${textoVisita(anteriorVisita)}`;

  // "N nuevas" en la pestaña de finales: contadas desde tu visita anterior
  async function finalesNuevos(desde: number) {
    let fechas: string[] | null = null;
    try {
      const c = JSON.parse(sessionStorage.getItem('finalesUltimas') || 'null');
      if (c && Date.now() - c.t < 5 * 60 * 1000) fechas = c.fechas;
    } catch {}
    if (!fechas) {
      const r = await fetch('/api/finales/ultimas.json').catch(() => null);
      if (!r?.ok) return;
      fechas = ((await r.json()).fechas || []) as string[];
      try { sessionStorage.setItem('finalesUltimas', JSON.stringify({ t: Date.now(), fechas })); } catch {}
    }
    const n = fechas.filter((f) => new Date(f).getTime() > desde).length;
    if (!n) return;
    document.querySelectorAll<HTMLAnchorElement>('a[href="/finales"]').forEach((a) => {
      if (!a.closest('.tabs, .bottombar') || a.querySelector('.nuevo-tag')) return;
      const tag = document.createElement('span');
      a.querySelector('.nuevo-pill')?.remove();
      tag.className = 'nuevo-tag';
      tag.textContent = a.closest('.bottombar') ? String(n) : `${n} nueva${n !== 1 ? 's' : ''}`;
      a.append(tag);
    });
  }
  if (anteriorVisita) finalesNuevos(anteriorVisita);
</script>

<script>
  // ========== MODO NOCHE ==========
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const pintar = () => toggle?.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false');
  pintar();
  toggle?.addEventListener('click', () => {
    const nuevo = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', nuevo);
    try { localStorage.setItem('tema', nuevo); } catch {}
    pintar();
  });
</script>

<script>
  // ========== BUSCADOR DEL BANNER ==========
  // Los datos se piden una sola vez, la primera vez que se usa el buscador.
  type Materia = { id: number; nombre: string; nivel: number };
  type Curso = { id: number; materiaId: number; curso: string; turno: string | null };
  type Profe = { id: number; nombre: string; materias: string[] };
  type Datos = { materias: Materia[]; cursos: Curso[]; profesores: Profe[] };

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const box = document.getElementById('search-results') as HTMLElement | null;
  const container = document.getElementById('search-container');
  const form = document.getElementById('search-form') as HTMLFormElement | null;

  let datos: Datos | null = null;
  let pedido: Promise<Datos | null> | null = null;
  let sel = -1;

  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  function resaltar(texto: string, q: string) {
    const i = norm(texto).indexOf(q);
    if (i < 0 || !q) return esc(texto);
    return esc(texto.slice(0, i)) + '<mark>' + esc(texto.slice(i, i + q.length)) + '</mark>' + esc(texto.slice(i + q.length));
  }
  const turnoCorto: Record<string, string> = { 'MAÑANA': 'Mañana', 'TARDE': 'Tarde', 'NOCHE': 'Noche' };

  function cargar() {
    if (!pedido) {
      pedido = fetch('/api/buscar.json')
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => (datos = d))
        .catch(() => null);
    }
    return pedido;
  }

  function cerrar() {
    box?.classList.add('hidden');
    input?.setAttribute('aria-expanded', 'false');
    sel = -1;
  }

  function opciones() {
    return Array.from(box?.querySelectorAll<HTMLAnchorElement>('a') || []);
  }

  function marcar(i: number) {
    const ops = opciones();
    ops.forEach((a, j) => {
      a.classList.toggle('sel', j === i);
      a.setAttribute('aria-selected', j === i ? 'true' : 'false');
    });
    sel = i;
    if (ops[i]) {
      input?.setAttribute('aria-activedescendant', ops[i].id);
      ops[i].scrollIntoView({ block: 'nearest' });
    }
  }

  function pintarResultados() {
    if (!input || !box) return;
    const q = norm(input.value.trim());
    if (q.length < 2) return cerrar();
    if (!datos) {
      box.innerHTML = '<div class="none">Buscando…</div>';
      box.classList.remove('hidden');
      return;
    }
    const nombreMateria = new Map(datos.materias.map((m) => [m.id, m.nombre]));
    const materias = datos.materias.filter((m) => norm(m.nombre).includes(q)).slice(0, 6);
    const qCurso = q.replace(/\s+/g, '');
    const cursos = /^\d[a-z]\d*$/.test(qCurso)
      ? datos.cursos.filter((c) => norm(c.curso).startsWith(qCurso)).slice(0, 8)
      : [];
    const profes = datos.profesores.filter((p) => norm(p.nombre).includes(q)).slice(0, 6);

    let html = '';
    let n = 0;
    const item = (href: string, izq: string, der: string) =>
      `<a id="sr-${n++}" role="option" href="${href}"><span>${izq}</span><span>${der}</span></a>`;
    if (materias.length) {
      html += '<h4>Materias</h4>' + materias.map((m) => item(`/materia/${m.id}`, resaltar(m.nombre, q), `${m.nivel}.º año`)).join('');
    }
    if (cursos.length) {
      html += '<h4>Cursos</h4>' + cursos.map((c) => item(`/dictado/${c.id}`, `<b>${esc(c.curso)}</b> ${esc(nombreMateria.get(c.materiaId) || '')}`, esc(turnoCorto[c.turno || ''] || c.turno || ''))).join('');
    }
    if (profes.length) {
      html += '<h4>Profesores</h4>' + profes.map((p) => item(`/profesor/${p.id}`, resaltar(p.nombre, q), esc(p.materias.slice(0, 2).join(', ') + (p.materias.length > 2 ? '…' : '')))).join('');
    }
    box.innerHTML = html || '<div class="none">No encontramos nada con eso. Probá con otra palabra.</div>';
    box.classList.remove('hidden');
    input.setAttribute('aria-expanded', 'true');
    sel = -1;
  }

  if (input && box) {
    let t: ReturnType<typeof setTimeout>;
    input.addEventListener('focus', () => { cargar(); });
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(async () => {
        pintarResultados();
        if (!datos) { await cargar(); pintarResultados(); }
      }, 120);
    });
    input.addEventListener('keydown', (e) => {
      const ops = opciones();
      if (e.key === 'ArrowDown' && ops.length) { e.preventDefault(); marcar((sel + 1) % ops.length); }
      else if (e.key === 'ArrowUp' && ops.length) { e.preventDefault(); marcar(sel <= 0 ? ops.length - 1 : sel - 1); }
      else if (e.key === 'Escape') { cerrar(); }
    });
    // Enter con una sugerencia marcada va directo; si no, a la página de resultados
    form?.addEventListener('submit', (e) => {
      const ops = opciones();
      if (sel >= 0 && ops[sel]) {
        e.preventDefault();
        window.location.href = ops[sel].href;
      } else if (!input.value.trim()) {
        e.preventDefault();
      }
    });
    document.addEventListener('click', (e) => {
      if (container && !container.contains(e.target as Node)) cerrar();
    });
  }
</script>

<script>
  // ========== VENTANA DE INGRESO ==========
  const modal = document.getElementById('login-modal');

  function abrir() {
    if (!modal) return;
    modal.classList.add('open');
    (document.getElementById('ml-nombre') as HTMLInputElement | null)?.focus();

    // Guardar la página actual para volver después de entrar
    const currentPage = window.location.pathname + window.location.search;
    const returnTo = encodeURIComponent(currentPage);
    const googleLink = document.getElementById('oauth-google') as HTMLAnchorElement | null;
    const githubLink = document.getElementById('oauth-github') as HTMLAnchorElement | null;
    if (googleLink) googleLink.href = '/api/auth/login?provider=google&returnTo=' + returnTo;
    if (githubLink) githubLink.href = '/api/auth/login?provider=github&returnTo=' + returnTo;
    try { localStorage.setItem('auth_returnTo', currentPage); } catch {}
    try { document.cookie = `auth_returnTo=${encodeURIComponent(currentPage)};path=/;max-age=600;SameSite=Lax`; } catch {}
  }

  function cerrarModal() {
    modal?.classList.remove('open');
  }

  // Permite abrir el ingreso desde cualquier script (por ej. al votar sin sesión)
  (window as any).openLoginModal = abrir;

  if (modal) {
    document.querySelectorAll('[data-login]').forEach((b) => b.addEventListener('click', abrir));
    document.getElementById('close-modal')?.addEventListener('click', cerrarModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) cerrarModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) cerrarModal(); });

    // Pestañas
    const tabEmail = document.getElementById('tab-email');
    const tabSocial = document.getElementById('tab-social');
    const panelEmail = document.getElementById('panel-email');
    const panelSocial = document.getElementById('panel-social');
    const elegir = (mail: boolean) => {
      tabEmail?.setAttribute('aria-selected', String(mail));
      tabSocial?.setAttribute('aria-selected', String(!mail));
      if (panelEmail) panelEmail.style.display = mail ? 'grid' : 'none';
      if (panelSocial) panelSocial.style.display = mail ? 'none' : 'grid';
    };
    tabEmail?.addEventListener('click', () => elegir(true));
    tabSocial?.addEventListener('click', () => elegir(false));

    // Link por mail
    const mlSubmit = document.getElementById('ml-submit') as HTMLButtonElement | null;
    const mlNombre = document.getElementById('ml-nombre') as HTMLInputElement | null;
    const mlEmail = document.getElementById('ml-email') as HTMLInputElement | null;
    const mlMsg = document.getElementById('ml-msg');

    const aviso = (tipo: 'ok' | 'bad', contenido: string | Node[]) => {
      if (!mlMsg) return;
      mlMsg.className = `msg ${tipo}`;
      if (typeof contenido === 'string') mlMsg.textContent = contenido;
      else mlMsg.replaceChildren(...contenido);
    };

    if (mlSubmit && mlNombre && mlEmail && mlMsg) {
      const original = mlSubmit.innerHTML;

      mlSubmit.addEventListener('click', async () => {
        const nombre = mlNombre.value.trim();
        const email = mlEmail.value.trim().toLowerCase();

        if (!nombre || nombre.length < 4) return aviso('bad', 'Escribí tu nombre y apellido.');
        if (!email || !email.includes('@')) return aviso('bad', 'Escribí un mail válido.');

        mlSubmit.disabled = true;
        mlSubmit.innerHTML = '<span class="spin"></span> Enviando…';
        mlMsg.classList.add('hidden');

        try {
          const res = await fetch('/api/auth/magic-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, nombre, returnTo: window.location.pathname + window.location.search }),
          });
          const data = await res.json();

          if (!res.ok) {
            aviso('bad', data.error || 'No pudimos mandar el link.');
            mlSubmit.disabled = false;
            mlSubmit.innerHTML = original;
            return;
          }

          const detalle = document.createElement('span');
          const fuerte = document.createElement('strong');
          fuerte.textContent = email;
          detalle.append('Lo mandamos a ', fuerte, '.');
          aviso('ok', [document.createTextNode('Revisá tu bandeja de entrada (y el spam). '), detalle]);
          mlNombre.disabled = true;
          mlEmail.disabled = true;

          // Espera de 30 s antes de poder reenviar
          let cooldown = 30;
          const texto = () => `Reenviar en ${cooldown} s`;
          mlSubmit.textContent = texto();
          const cd = setInterval(() => {
            cooldown--;
            if (cooldown <= 0) {
              clearInterval(cd);
              mlSubmit.disabled = false;
              mlSubmit.innerHTML = original;
              mlNombre.disabled = false;
              mlEmail.disabled = false;
            } else {
              mlSubmit.textContent = texto();
            }
          }, 1000);

          // Si entra desde otra pestaña, recargar esta
          window.addEventListener('focus', () => window.location.reload());
          window.addEventListener('storage', (e: StorageEvent) => {
            if (e.key === 'supabase.auth.token' || e.key?.startsWith('sb-')) window.location.reload();
          });
        } catch {
          aviso('bad', 'Error de conexión. Probá de nuevo.');
          mlSubmit.disabled = false;
          mlSubmit.innerHTML = original;
        }
      });
    }
  }
</script>

<script>
  // Volver a la página donde estaba antes de entrar
  try {
    const returnTo = localStorage.getItem('auth_returnTo');
    if (returnTo) {
      const isLoggedIn = !!document.querySelector('[data-logout]');
      const currentPage = window.location.pathname + window.location.search;
      const isSafePath = returnTo.startsWith('/') && !returnTo.startsWith('//') && !returnTo.startsWith('/\\');
      if (isLoggedIn && isSafePath && returnTo !== currentPage) {
        localStorage.removeItem('auth_returnTo');
        document.cookie = 'auth_returnTo=;path=/;max-age=0';
        window.location.replace(returnTo);
      } else if (isLoggedIn || !isSafePath) {
        localStorage.removeItem('auth_returnTo');
        document.cookie = 'auth_returnTo=;path=/;max-age=0';
      }
    }
  } catch {}
</script>
