---
import Layout from '../../layouts/Layout.astro';
import HeaderNav from '../../components/HeaderNav.astro';
import { supabase } from '../../lib/supabase';
import { isAdmin } from '../../lib/admin';

const user = Astro.locals.user;
const userIsAdmin = isAdmin(user?.id);

const { id } = Astro.params;

// Traer dictado con curso, materia y profesores
const { data: dictado, error } = await supabase
  .from('dictados')
  .select(`
    id, curso_id, materia_id,
    es_contracuatrimestral,
    periodo_dictado,        
    es_intensivo,
    updated_at,
    created_at,           
    cursos ( identificador, anio_carrera, turno ),
    materias ( id, nombre, nivel, es_electiva, puntos_electiva ),
    dictado_profesores (
      updated_at,
      created_at,
      profesores ( id, nombre_completo )
    )
  `)
  .eq('id', id)
  .single();

if (error || !dictado) {
  return Astro.redirect('/404');
}
if (error) {
  console.error("ERROR DETALLADO DE SUPABASE:", error);
}
function tiempoRelativo(fecha: string): string {
  const diff = Date.now() - new Date(fecha).getTime();
  const dias = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (dias === 0) return 'Hoy';
  if (dias === 1) return 'Ayer';
  if (dias < 30) return `Hace ${dias} días`;
  if (dias < 365) return `Hace ${Math.floor(dias / 30)} mes${Math.floor(dias / 30) > 1 ? 'es' : ''}`;
  return `Hace ${Math.floor(dias / 365)} año${Math.floor(dias / 365) > 1 ? 's' : ''}`;
}

// ── CALCULAR ÚLTIMA ACTUALIZACIÓN (Ignorando reseñas) ──
const fechas: string[] = [dictado?.updated_at, dictado?.created_at].filter(Boolean) as string[];

// Si se modificaron o agregaron profesores, también lo tenemos en cuenta
if (dictado?.dictado_profesores) {
  dictado.dictado_profesores.forEach((dp: any) => {
    if (dp.updated_at) fechas.push(dp.updated_at);
    if (dp.created_at) fechas.push(dp.created_at);
  });
}

// Obtenemos la fecha más reciente de todas las recolectadas
const fechaActualizacion = fechas.length > 0 
  ? new Date(Math.max(...fechas.map(f => new Date(f).getTime()))).toISOString()
  : null;



const ultimaActualizacionStr = fechaActualizacion ? tiempoRelativo(fechaActualizacion) : null;

const curso = Array.isArray((dictado as any).cursos) ? (dictado as any).cursos[0] : (dictado as any).cursos;
const materia = Array.isArray((dictado as any).materias) ? (dictado as any).materias[0] : (dictado as any).materias;
const dictadoProfesores = Array.isArray((dictado as any).dictado_profesores) ? (dictado as any).dictado_profesores : [];

function getCursadaInfo(cursoData: any) {
  const periodo = cursoData?.periodo_dictado;
  const esAnual = periodo === 'ANUAL';
  const esContracuatrimestral = Boolean(cursoData?.es_contracuatrimestral) && !esAnual;
  const esIntensivo = Boolean(cursoData?.es_intensivo);

  const label = periodo === 'PRIMER_CUATRIMESTRE'
    ? 'Dictado en el primer cuatrimestre'
    : periodo === 'SEGUNDO_CUATRIMESTRE'
      ? 'Dictado en el segundo cuatrimestre'
      : periodo === 'ANUAL'
        ? 'Dictado anual'
        : 'Periodo de dictado sin definir';

  const description = periodo === 'ANUAL'
    ? 'Esta materia se cursa de forma anual, por lo que no corresponde marcarla como contracuatrimestral.'
    : esContracuatrimestral
      ? 'Se dicta en el cuatrimestre contrario al normal para esta materia.'
      : 'Se desarrolla en el cuatrimestre indicado para esta cursada.';

  return { label, description, esAnual, esContracuatrimestral, esIntensivo };
}

const cursadaInfo = getCursadaInfo(curso);

// Traer reseñas
const { data: resenas } = await supabase
  .from('resenas')
  .select('*')
  .eq('dictado_id', id)
  .order('created_at', { ascending: false });

const resenasData = resenas || [];

// Estadísticas
const totalResenas = resenasData.length;
let promedio = 0;
let distribucion = [0, 0, 0, 0, 0];

if (totalResenas > 0) {
  const suma = resenasData.reduce((acc, r) => acc + r.calificacion_general, 0);
  promedio = suma / totalResenas;
  resenasData.forEach(r => {
    const idx = Math.min(Math.max(Math.round(r.calificacion_general) - 1, 0), 4);
    distribucion[idx]++;
  });
}

// Colores por nivel
const nivelColors: Record<number, { bg: string; light: string; accent: string; badge: string }> = {
  1: { bg: "from-blue-500 to-blue-600", light: "text-blue-200", accent: "bg-blue-900/30 text-blue-400", badge: "bg-blue-500" },
  2: { bg: "from-green-500 to-green-600", light: "text-green-200", accent: "bg-green-900/30 text-green-400", badge: "bg-green-500" },
  3: { bg: "from-orange-500 to-orange-600", light: "text-orange-200", accent: "bg-orange-900/30 text-orange-400", badge: "bg-orange-500" },
  4: { bg: "from-red-500 to-red-600", light: "text-red-200", accent: "bg-red-900/30 text-red-400", badge: "bg-red-500" },
  5: { bg: "from-purple-500 to-purple-600", light: "text-purple-200", accent: "bg-purple-900/30 text-purple-400", badge: "bg-purple-500" },
};

const nivel = materia?.nivel || 1;
const colors = nivelColors[nivel] || nivelColors[1];

function estrellas(n: number): string {
  return '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
}

---

<Layout title={`${curso?.identificador || ''} - ${materia?.nombre || ''} - UTN REP`} hasFloatingButton={totalResenas > 0}>

  <header class={`bg-gradient-to-r ${colors.bg} text-white relative overflow-hidden`}>
    <div class="absolute inset-0 dot-pattern opacity-30"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8 lg:pb-12">
      <HeaderNav user={user} />
      <a href={`/materia/${materia?.id}?from=nivel`} class={`inline-flex items-center gap-2 ${colors.light} hover:text-white mb-2 transition-colors text-sm`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Volver a {materia?.nombre}
      </a>
      
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <span class={`text-sm font-medium ${colors.light} uppercase tracking-wider`}>
            {materia?.nombre} · {nivel}º Año
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold tracking-tight mt-1">
            {curso?.identificador}
          </h1>
          <div class="flex flex-wrap items-center gap-2 mt-2">
            <span class="inline-block text-sm font-semibold bg-white/20 backdrop-blur px-3 py-1 rounded-lg uppercase tracking-wide">
              Turno {curso?.turno}
            </span>
            {materia?.es_electiva && (
            <span class="inline-flex items-center gap-1 text-sm font-semibold bg-purple-400/20 text-purple-100 px-3 py-1 rounded-lg backdrop-blur">
              Electiva ({materia?.puntos_electiva || 0} pts)
            </span>
            )}
            {cursadaInfo.esContracuatrimestral && (
              <span class="inline-flex items-center gap-1 text-sm font-semibold bg-amber-400/20 text-amber-100 px-3 py-1 rounded-lg backdrop-blur" title="Se dicta en el cuatrimestre contrario al normal">
                Contracuatrimestre
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-white/20 text-[11px] font-bold">i</span>
              </span>
            )}
            {!cursadaInfo.esAnual && curso?.periodo_dictado && (
              <span class="inline-flex items-center gap-1 text-sm font-semibold bg-white/15 text-white/90 px-3 py-1 rounded-lg backdrop-blur">
                {cursadaInfo.label}
              </span>
            )}
            {cursadaInfo.esAnual && (
              <span class="inline-flex items-center gap-1 text-sm font-semibold bg-purple-400/20 text-purple-100 px-3 py-1 rounded-lg backdrop-blur">
                Anual
              </span>
            )}
            {cursadaInfo.esIntensivo && (
              <span class="inline-flex items-center gap-1 text-sm font-semibold bg-cyan-400/20 text-cyan-100 px-3 py-1 rounded-lg backdrop-blur">
                Intensivo
              </span>
            )}
          </div>
        </div>
        
        {totalResenas > 0 && (
          <div class="flex items-center gap-3 bg-white/10 backdrop-blur rounded-2xl px-5 py-4">
            <span class="text-4xl font-extrabold">{promedio.toFixed(1)}</span>
            <div>
              <div class="text-yellow-300 text-lg tracking-wide">{estrellas(promedio)}</div>
              <p class="text-white/70 text-sm">{totalResenas} reseña{totalResenas !== 1 ? 's' : ''}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-6">

        <!-- Información -->
        <section class="mb-8">
          <div class="bg-[#242424] rounded-2xl border border-neutral-700/60 p-6">
            <h2 class="text-xl sm:text-2xl font-heading font-bold text-neutral-100 mb-4">Información de la Cátedra</h2>
            
            {(!materia?.es_electiva && !dictado?.periodo_dictado && !dictado?.es_intensivo && !dictado?.es_contracuatrimestral) ? (
              <p class="text-sm text-neutral-500 italic">No hay información de cursada cargada para esta cátedra.</p>
            ) : (
              <div class="flex flex-wrap gap-2">
                {materia?.es_electiva && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-purple-300 bg-purple-500/10 border border-purple-500/20 px-3 py-1.5 rounded-full shrink-0">
                    Electiva ({materia?.puntos_electiva || 0} pts)
                  </span>
                )}
                {dictado?.periodo_dictado === 'PRIMER_CUATRIMESTRE' && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-300 bg-blue-500/10 border border-blue-500/20 px-3 py-1.5 rounded-full shrink-0">
                    1° cuatrimestre
                  </span>
                )}
                {dictado?.periodo_dictado === 'SEGUNDO_CUATRIMESTRE' && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-green-300 bg-green-500/10 border border-green-500/20 px-3 py-1.5 rounded-full shrink-0">
                    2° cuatrimestre
                  </span>
                )}
                {dictado?.periodo_dictado === 'ANUAL' && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-purple-300 bg-purple-500/10 border border-purple-500/20 px-3 py-1.5 rounded-full shrink-0">
                    Anual
                  </span>
                )}
                {dictado?.es_intensivo && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-amber-300 bg-amber-500/10 border border-amber-500/20 px-3 py-1.5 rounded-full shrink-0">
                    Intensivo
                  </span>
                )}
                {dictado?.es_contracuatrimestral && (
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-amber-300 bg-amber-500/10 border border-amber-500/20 px-3 py-1.5 rounded-full shrink-0" title="Se dicta en el cuatrimestre contrario al normal">
                    Contracuatrimestre
                    <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-amber-500/20 text-[10px] font-bold">i</span>
                  </span>
                )}
              </div>
            )}

            {ultimaActualizacionStr && (
              <div class="mt-5 pt-4 border-t border-neutral-700/40 flex items-center gap-2 text-xs text-neutral-500 font-medium">
                <svg class="w-4 h-4 text-neutral-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Información actualizada {ultimaActualizacionStr}</span>
              </div>
            )}
          </div>
        </section>

        <!-- Equipo Docente -->
        <div class="bg-[#242424] rounded-2xl border border-neutral-700/60 p-6">
          <h3 class="font-heading font-bold text-neutral-100 mb-4 flex items-center gap-2">
            <span class="text-lg"><svg class="w-5 h-5 text-neutral-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></span> Equipo Docente
          </h3>
          <ul class="space-y-3">
            {dictadoProfesores.map((dp: any) => (
              <li class="flex items-center gap-3">
                <div class={`w-9 h-9 ${colors.badge} rounded-full flex items-center justify-center text-white font-bold text-sm`}>
                  {dp.profesores.nombre_completo.charAt(0)}
                </div>
                <span class="text-sm font-medium text-neutral-300">{dp.profesores.nombre_completo}</span>
              </li>
            ))}
            {dictadoProfesores.length === 0 && (
              <li class="text-neutral-500 italic text-sm">Sin profesores asignados</li>
            )}
          </ul>
        </div>

        <!-- Distribución -->
        {totalResenas > 0 && (
          <div class="bg-[#242424] rounded-2xl border border-neutral-700/60 p-6">
            <h3 class="font-heading font-bold text-neutral-100 mb-4 flex items-center gap-2">
              <span class="text-lg"><svg class="w-5 h-5 text-neutral-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg></span> Distribución
            </h3>
            <div class="space-y-2">
              {[5, 4, 3, 2, 1].map((star) => {
                const count = distribucion[star - 1];
                const pct = totalResenas > 0 ? (count / totalResenas) * 100 : 0;
                return (
                  <div class="flex items-center gap-3 text-sm">
                    <span class="w-4 text-right font-medium text-neutral-400">{star}</span>
                    <span class="text-yellow-500">★</span>
                    <div class="flex-1 bg-neutral-800 rounded-full h-2.5 overflow-hidden">
                      <div 
                        class={`h-full ${colors.badge} rounded-full transition-all`} 
                        style={`width: ${pct}%`}
                      ></div>
                    </div>
                    <span class="w-8 text-right text-neutral-500 text-xs">{count}</span>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Botón escribir reseña (desktop) -->
        {totalResenas > 0 && (
          <div class="hidden lg:block">
            <a href={`/nueva-resena?dictado=${id}&from=/dictado/${id}`} class={`w-full bg-gradient-to-r ${colors.bg} hover:opacity-90 text-white font-bold text-lg px-8 py-4 rounded-2xl shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.157a2.625 2.625 0 000-3.711z" />
                <path d="M10.74 15.394l6.5-6.5-3.71-3.71-6.5 6.5a1.5 1.5 0 00-.4.73l-.84 4.2a.75.75 0 00.916.916l4.2-.84a1.5 1.5 0 00.73-.4z" />
              </svg>
              Escribir una reseña
            </a>
          </div>
        )}
      </div>

      <!-- Reseñas -->
      <div class="lg:col-span-2">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-heading font-bold text-neutral-100 flex items-center gap-3">
            <span class="bg-amber-900/30 text-amber-400 p-2 rounded-xl"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg></span>
            Reseñas
            {totalResenas > 0 && (
              <span class="text-sm font-normal text-neutral-500">({totalResenas})</span>
            )}
          </h2>
          
          {totalResenas > 1 && (
            <select id="sort-select" class="text-sm border border-neutral-700 rounded-xl px-3 py-2 bg-[#242424] text-neutral-400 focus:outline-none focus:ring-2 focus:ring-amber-300">
              <option value="newest">Más recientes</option>
              <option value="oldest">Más antiguas</option>
              <option value="highest">Mayor calificación</option>
              <option value="lowest">Menor calificación</option>
            </select>
          )}
        </div>

        {resenasData.length > 0 ? (
          <>
          <div class="space-y-4" id="reviews-list">
            {resenasData.map((resena, idx) => (
              <div class={`review-card bg-[#242424] rounded-2xl border border-neutral-700/60 p-5 sm:p-6 hover:shadow-md transition-shadow ${idx >= 10 ? 'review-extra hidden' : ''}`}
                   data-date={resena.created_at} 
                   data-rating={resena.calificacion_general}
                   data-id={resena.id}
                   data-user-id={resena.user_id}>
                
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3">
                    <div class={`w-10 h-10 ${resena.es_anonima ? 'bg-neutral-700' : colors.badge} rounded-full flex items-center justify-center text-white font-bold text-sm`}>
                      {resena.es_anonima ? (
                        <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      ) : (
                        (resena.nombre_usuario || 'U').charAt(0).toUpperCase()
                      )}
                    </div>
                    <div>
                      <div class="flex items-center gap-1.5">
                        <p class="font-semibold text-neutral-100 text-sm flex items-center gap-2 flex-wrap">
                          <span>
                            {resena.es_anonima ? 'Anónimo' : (resena.nombre_usuario || 'Estudiante')}
                            {resena.es_anonima && userIsAdmin && (
                              <span class="text-[10px] text-red-400/70 font-normal ml-1" title="Visible solo para admin">({resena.nombre_usuario})</span>
                            )}
                          </span>
                          
                          {resena.condicion_final === 'PROMOCIONADO' && (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-green-900/30 text-green-400 border border-green-800/50 uppercase tracking-wide">
                              Promocionado
                            </span>
                          )}
                          {resena.condicion_final === 'REGULAR' && (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-yellow-900/30 text-yellow-400 border border-yellow-800/50 uppercase tracking-wide">
                              Regular
                            </span>
                          )}
                          {resena.condicion_final === 'LIBRE' && (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-red-900/30 text-red-400 border border-red-800/50 uppercase tracking-wide">
                              Libre
                            </span>
                          )}
                        </p>
                        {resena.es_alumno_utn && (
                          <span class="inline-flex items-center gap-0.5 bg-blue-900/40 text-blue-400 text-[10px] font-bold px-1.5 py-0.5 rounded-full border border-blue-700/50" title="Alumno verificado de UTN FRC">
                            <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                            UTN
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-neutral-500 mt-0.5">
                        {resena.anio_cursado ? `Cursó en ${resena.anio_cursado}` : ''}
                        {resena.anio_cursado && resena.created_at ? ' · ' : ''}
                        {resena.created_at ? tiempoRelativo(resena.created_at) : ''}
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 flex-shrink-0">
                    <span class="text-yellow-500 text-lg">{estrellas(resena.calificacion_general)}</span>
                    <span class="font-bold text-neutral-300 text-sm">{resena.calificacion_general}</span>
                  </div>
                </div>
                
                {resena.comentario && (
                  <p class="review-comment text-neutral-400 text-sm leading-relaxed">
                    {resena.comentario}
                  </p>
                )}

                <div class="review-edit-form hidden mt-3">
                  <textarea class="edit-textarea w-full px-3 py-2 rounded-xl border border-neutral-700 bg-[#1a1a1a] text-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400/50 resize-none" rows="3">{resena.comentario}</textarea>
                  <div class="flex gap-2 mt-2">
                    <button class="save-edit-btn text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-white px-4 py-1.5 rounded-lg transition-colors cursor-pointer">Guardar</button>
                    <button class="cancel-edit-btn text-xs font-semibold text-neutral-400 hover:text-neutral-200 px-3 py-1.5 transition-colors cursor-pointer">Cancelar</button>
                  </div>
                </div>

                <div class="flex items-center justify-between mt-3 pt-3 border-t border-neutral-700/40">
                  
                  {(user?.id === resena.user_id || userIsAdmin) ? (
                    <div class="flex items-center gap-3">
                      {user?.id === resena.user_id && (
                        <button class="edit-btn text-xs text-amber-400 hover:text-amber-300 flex items-center gap-1 cursor-pointer transition-colors">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                          Editar
                        </button>
                      )}
                      <button class="delete-btn text-xs text-red-400/70 hover:text-red-400 flex items-center gap-1 cursor-pointer transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Eliminar
                      </button>
                    </div>
                  ) : (
                    <div></div>
                  )}

                  <div class="flex items-center gap-3">
                    
                    <button 
                      class="btn-votar flex items-center gap-1.5 bg-[#2a2a2a] hover:bg-[#333333] text-neutral-400 px-2.5 py-1.5 rounded-lg transition-colors border border-neutral-700/50 active:scale-95 text-xs font-semibold"
                      data-id={resena.id}
                      data-votos={resena.votos_utilidad || 0}
                      title="Marcar como útil"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                      </svg>
                      <span class="votos-count">{resena.votos_utilidad || 0}</span>
                    </button>

                    {user && user.id !== resena.user_id && (
                      <button class="report-btn text-xs text-neutral-600 hover:text-red-400 flex items-center gap-1 cursor-pointer transition-colors" title="Reportar reseña">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
                        Reportar
                      </button>
                    )}
                  </div>

                </div>
              </div>
            ))}
          </div>

          {resenasData.length > 10 && (
            <div class="text-center mt-6">
              <button id="show-more-btn" class="text-sm font-semibold text-amber-400 hover:text-amber-300 bg-amber-900/20 hover:bg-amber-900/30 px-6 py-3 rounded-xl transition-colors cursor-pointer">
                Ver más reseñas ({resenasData.length - 10} restantes)
              </button>
            </div>
          )}
          </>
        ) : (
          <div class="bg-[#242424] p-12 text-center border-2 border-dashed border-neutral-700 rounded-2xl">
            <div class="flex justify-center mb-4">
              <svg class="w-14 h-14 text-neutral-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <h3 class="text-lg font-heading font-bold text-neutral-300 mb-2">Todavía no hay reseñas</h3>
            <p class="text-neutral-500 mb-6">Sé el primero en compartir tu experiencia con este curso.</p>
            <a href={`/nueva-resena?dictado=${id}&from=/dictado/${id}`} class={`inline-flex items-center gap-2 bg-gradient-to-r ${colors.bg} text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition-all active:scale-95`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.157a2.625 2.625 0 000-3.711z" />
                <path d="M10.74 15.394l6.5-6.5-3.71-3.71-6.5 6.5a1.5 1.5 0 00-.4.73l-.84 4.2a.75.75 0 00.916.916l4.2-.84a1.5 1.5 0 00.73-.4z" />
              </svg>
              Sé el primero en dejar una reseña
            </a>
          </div>
        )}
      </div>
    </div>

  </main>

  <!-- Botón flotante móvil -->
  {totalResenas > 0 && (
    <div class="fixed bottom-6 left-4 right-4 sm:left-auto sm:right-8 sm:w-auto z-20 lg:hidden">
      <a href={`/nueva-resena?dictado=${id}&from=/dictado/${id}`} class={`w-full sm:w-auto bg-gradient-to-r ${colors.bg} hover:opacity-90 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2`}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.157a2.625 2.625 0 000-3.711z" />
          <path d="M10.74 15.394l6.5-6.5-3.71-3.71-6.5 6.5a1.5 1.5 0 00-.4.73l-.84 4.2a.75.75 0 00.916.916l4.2-.84a1.5 1.5 0 00.73-.4z" />
        </svg>
        Escribir una reseña
      </a>
    </div>
  )}

  <script>
    function getErrorMessage(err: unknown): string {
      return err instanceof Error ? err.message : 'Error desconocido';
    }

    // ========== PAGINATION ==========
    const showMoreBtn = document.getElementById('show-more-btn') as HTMLButtonElement | null;
    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', () => {
        document.querySelectorAll('.review-extra').forEach(el => {
          el.classList.remove('hidden', 'review-extra');
        });
        showMoreBtn.remove();
      });
    }

    // ========== SORT ==========
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const reviewsList = document.getElementById('reviews-list') as HTMLElement | null;
    
    if (sortSelect && reviewsList) {
      sortSelect.addEventListener('change', () => {
        // Show all when sorting
        document.querySelectorAll('.review-extra').forEach(el => {
          el.classList.remove('hidden', 'review-extra');
        });
        showMoreBtn?.remove();

        const cards = Array.from(reviewsList.querySelectorAll('.review-card'));
        
        cards.sort((a, b) => {
          const dateA = a.getAttribute('data-date') || '';
          const dateB = b.getAttribute('data-date') || '';
          const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
          const ratingB = parseFloat(b.getAttribute('data-rating') || '0');
          
          switch (sortSelect.value) {
            case 'newest': return dateB.localeCompare(dateA);
            case 'oldest': return dateA.localeCompare(dateB);
            case 'highest': return ratingB - ratingA;
            case 'lowest': return ratingA - ratingB;
            default: return 0;
          }
        });
        
        cards.forEach(card => reviewsList.appendChild(card));
      });
    }

    // ========== EDIT ==========
    document.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.review-card') as HTMLElement | null;
        if (!card) return;
        const comment = card.querySelector('.review-comment') as HTMLElement | null;
        const editForm = card.querySelector('.review-edit-form') as HTMLElement | null;
        if (comment) comment.classList.add('hidden');
        if (editForm) editForm.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.cancel-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.review-card') as HTMLElement | null;
        if (!card) return;
        const comment = card.querySelector('.review-comment') as HTMLElement | null;
        const editForm = card.querySelector('.review-edit-form') as HTMLElement | null;
        if (comment) comment.classList.remove('hidden');
        if (editForm) editForm.classList.add('hidden');
      });
    });

    document.querySelectorAll('.save-edit-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.review-card') as HTMLElement | null;
        if (!card) return;
        const resenaId = card.getAttribute('data-id');
        const textarea = card.querySelector('.edit-textarea') as HTMLTextAreaElement | null;
        const newComment = textarea?.value?.trim();

        if (!newComment || newComment.length < 10) {
          alert('El comentario debe tener al menos 10 caracteres.');
          return;
        }

        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = 'Guardando...';

        try {
          const res = await fetch('/api/resenas/' + resenaId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _method: 'PUT', comentario: newComment }),
          });
          const text = await res.text();
          let data;
          try { data = JSON.parse(text); } catch { throw new Error('Error del servidor. Recargá la página e intentá de nuevo.'); }
          if (!res.ok) throw new Error(data.error || 'Error');

          // Update the displayed comment
          const comment = card.querySelector('.review-comment') as HTMLElement | null;
          if (comment) {
            comment.textContent = newComment;
            comment.classList.remove('hidden');
          }
          card.querySelector('.review-edit-form')?.classList.add('hidden');
        } catch (err) {
          alert(getErrorMessage(err));
        } finally {
          (btn as HTMLButtonElement).disabled = false;
          btn.textContent = 'Guardar';
        }
      });
    });

    // ========== DELETE ==========
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Seguro que querés eliminar esta reseña? Esta acción no se puede deshacer.')) return;

        const card = btn.closest('.review-card') as HTMLElement | null;
        if (!card) return;
        const resenaId = card.getAttribute('data-id');

        (btn as HTMLButtonElement).disabled = true;

        try {
          const res = await fetch('/api/resenas/' + resenaId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _method: 'DELETE' }),
          });
          const text = await res.text();
          let data;
          try { data = JSON.parse(text); } catch { throw new Error('Error del servidor. Recargá la página e intentá de nuevo.'); }
          if (!res.ok) throw new Error(data.error || 'Error al eliminar.');

          card.style.transition = 'opacity 0.3s, transform 0.3s';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => card.remove(), 300);
        } catch (err) {
          alert(getErrorMessage(err));
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });

    // ========== REPORT ==========
    document.querySelectorAll('.report-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.review-card') as HTMLElement | null;
        if (!card) return;
        const resenaId = parseInt(card.getAttribute('data-id') || '0');

        if (!confirm('¿Querés reportar esta reseña como inapropiada?')) return;

        (btn as HTMLButtonElement).disabled = true;

        try {
          const res = await fetch('/api/reportes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ resena_id: resenaId, motivo: 'Contenido inapropiado' }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Error');

          btn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Reportada';
          btn.classList.remove('text-neutral-600', 'hover:text-red-400');
          btn.classList.add('text-neutral-500');
          (btn as HTMLButtonElement).disabled = true;
        } catch (err) {
          alert(getErrorMessage(err));
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const botonesVotar = document.querySelectorAll('.btn-votar');

      // Cargamos los IDs de las reseñas que el usuario ya votó en este dispositivo
      const votosGuardados: string[] = JSON.parse(localStorage.getItem('utn_votos') || '[]');

      botonesVotar.forEach((elemento) => {
        const btn = elemento as HTMLButtonElement; 
        const id = btn.getAttribute('data-id');

        if (!id) return;

        const countSpan = btn.querySelector('.votos-count');
        const icon = btn.querySelector('svg');

        // Estado inicial: si ya la votó antes, la mostramos iluminada en amarillo
        if (votosGuardados.includes(id)) {
          btn.classList.add('bg-amber-500/10', 'text-amber-400', 'border-amber-500/30');
          btn.classList.remove('bg-[#2a2a2a]', 'text-neutral-400', 'border-neutral-700/50');
          if (icon) icon.setAttribute('fill', 'currentColor');
        }

        btn.addEventListener('click', async () => {
          const yaVoto = votosGuardados.includes(id);
          let accion = 'votar';
          const currentVotos = parseInt(countSpan?.textContent || '0') || 0;

          if (yaVoto) {
            // --- DESVOTAR --- (Quitar me gusta)
            accion = 'desvotar';
            const index = votosGuardados.indexOf(id);
            if (index > -1) votosGuardados.splice(index, 1);

            // UI: Volver el botón a su estado neutro y restar 1
            if (countSpan) countSpan.textContent = Math.max(0, currentVotos - 1).toString();
            btn.classList.remove('bg-amber-500/10', 'text-amber-400', 'border-amber-500/30');
            btn.classList.add('bg-[#2a2a2a]', 'text-neutral-400', 'border-neutral-700/50');
            if (icon) icon.setAttribute('fill', 'none');
          } else {
            // --- VOTAR --- (Dar me gusta)
            accion = 'votar';
            votosGuardados.push(id);

            // UI: Pintar el botón de amarillo y sumar 1
            if (countSpan) countSpan.textContent = (currentVotos + 1).toString();
            btn.classList.add('bg-amber-500/10', 'text-amber-400', 'border-amber-500/30');
            btn.classList.remove('bg-[#2a2a2a]', 'text-neutral-400', 'border-neutral-700/50');
            if (icon) icon.setAttribute('fill', 'currentColor');
          }

          // Guardar actualización de estado localmente
          localStorage.setItem('utn_votos', JSON.stringify(votosGuardados));

          // Enviar la petición asincrónica al backend
          try {
            await fetch('/api/resenas/votar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ resena_id: id, accion })
            });
          } catch (error) {
            console.error('Error al registrar la acción de voto:', error);
          }
        });
      });
    });
  </script>

</Layout>
