---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import CursoChips from '../../components/CursoChips.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import ShareButton from '../../components/ShareButton.astro';
import { supabase, createSupabaseServerClient } from '../../lib/supabase';
import { supabaseAdmin } from '../../lib/supabase-admin';
import { isAdmin } from '../../lib/admin';
import { anioLabel, nota, tiempoRelativo } from '../../lib/format';

const user = Astro.locals.user;
const userIsAdmin = isAdmin(user?.id);

const { id } = Astro.params;

// Curso con materia y profesores
const { data: dictado, error } = await supabase
  .from('dictados')
  .select(`
    id, curso_id, materia_id,
    es_contracuatrimestral,
    periodo_dictado,
    es_intensivo,
    updated_at,
    created_at,
    cursos ( identificador, anio_carrera, turno ),
    materias ( id, nombre, nivel, es_electiva, puntos_electiva ),
    dictado_profesores (
      updated_at,
      created_at,
      profesores ( id, nombre_completo )
    )
  `)
  .eq('id', id)
  .single();

if (error || !dictado) {
  if (error) console.error('[dictado] Error de Supabase:', error.message);
  return Astro.redirect('/404');
}

// Última actualización de la información del curso (sin contar reseñas)
const fechas: string[] = [dictado.updated_at, dictado.created_at].filter(Boolean) as string[];
(dictado.dictado_profesores || []).forEach((dp: any) => {
  if (dp.updated_at) fechas.push(dp.updated_at);
  if (dp.created_at) fechas.push(dp.created_at);
});
const fechaActualizacion = fechas.length > 0
  ? new Date(Math.max(...fechas.map((f) => new Date(f).getTime()))).toISOString()
  : null;

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);
const curso = one((dictado as any).cursos);
const materia = one((dictado as any).materias);
const profesores = ((dictado as any).dictado_profesores || []).map((dp: any) => one(dp.profesores)).filter(Boolean);

// Reseñas (vista pública: sin user_id y sin nombre en las anónimas)
const { data: resenas } = await supabase
  .from('resenas_publicas')
  .select('*')
  .eq('dictado_id', id)
  .order('created_at', { ascending: false });

const resenasData = resenas || [];
const resenaIds = resenasData.map((r) => r.id);

// Reseñas propias y votos del usuario (RLS: cada uno solo ve sus filas)
let misResenas = new Set<number>();
let misVotos = new Set<number>();
if (user && resenaIds.length > 0) {
  const { client: userClient } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const [{ data: propias }, { data: votos }] = await Promise.all([
    userClient.from('resenas').select('id').eq('dictado_id', id).eq('user_id', user.id),
    userClient.from('votos_resenas').select('resena_id').in('resena_id', resenaIds),
  ]);
  misResenas = new Set((propias || []).map((r) => r.id));
  misVotos = new Set((votos || []).map((v) => v.resena_id));
}

// Nombres reales de las anónimas, solo para admins
let nombresAnonimos: Record<number, string> = {};
if (userIsAdmin && resenasData.some((r) => r.es_anonima)) {
  const { data } = await supabaseAdmin
    .from('resenas')
    .select('id, nombre_usuario')
    .eq('dictado_id', id)
    .eq('es_anonima', true);
  nombresAnonimos = Object.fromEntries((data || []).map((r) => [r.id, r.nombre_usuario]));
}

// Estadísticas
const totalResenas = resenasData.length;
let promedio = 0;
const distribucion = [0, 0, 0, 0, 0];
if (totalResenas > 0) {
  promedio = resenasData.reduce((acc, r) => acc + r.calificacion_general, 0) / totalResenas;
  resenasData.forEach((r) => {
    const idx = Math.min(Math.max(Math.round(r.calificacion_general) - 1, 0), 4);
    distribucion[idx]++;
  });
}
const condiciones = {
  prom: resenasData.filter((r) => r.condicion_final === 'PROMOCIONADO').length,
  reg: resenasData.filter((r) => r.condicion_final === 'REGULAR').length,
  libre: resenasData.filter((r) => r.condicion_final === 'LIBRE').length,
};
const conCondicion = condiciones.prom + condiciones.reg + condiciones.libre;

const nivel = materia?.nivel || 1;
const label = anioLabel(nivel).replace(/^./, (c) => c.toUpperCase());
const escribir = `/nueva-resena?dictado=${id}&from=/dictado/${id}`;
const pct = (n: number) => (conCondicion ? Math.round((n / conCondicion) * 100) : 0);

const [{ count: cantFinales }, { count: cantCursos }] = await Promise.all([
  supabase.from('experiencias_finales').select('id', { count: 'exact', head: true }).eq('materia_id', dictado.materia_id),
  supabase.from('dictados').select('id', { count: 'exact', head: true }).eq('materia_id', dictado.materia_id),
]);
const recienPublicada = Astro.url.searchParams.get('publicada') === '1';
---

<Layout
  title={`${curso?.identificador || ''} - ${materia?.nombre || ''} - UTN REP`}
  tab="materias"
  crumbs={[
    { label: 'Materias', href: '/' },
    { label, href: `/nivel/${nivel}` },
    { label: materia?.nombre || 'Materia', href: `/materia/${materia?.id}` },
    { label: curso?.identificador || 'Curso' },
  ]}
>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <div class="chips">
            <a class:list={['yr', `y${nivel}`]} href={`/nivel/${nivel}`}>{label}</a>
            <a href={`/materia/${materia?.id}`}>{materia?.nombre}</a>
          </div>
          <h1 style="margin-top:4px">{materia?.nombre}, {curso?.identificador}</h1>
          <div style="margin-top:6px">
            <CursoChips
              turno={curso?.turno}
              periodo={dictado.periodo_dictado}
              contra={dictado.es_contracuatrimestral}
              intensivo={dictado.es_intensivo}
              electiva={materia?.es_electiva ? { puntos: materia?.puntos_electiva } : null}
            />
          </div>
        </div>
        <div class="actions">
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir una reseña</a>
          <ShareButton titulo={`Reseñas de ${materia?.nombre}, curso ${curso?.identificador}, en UTN REP`} />
        </div>
      </div>

      {recienPublicada && (
        <div class="notice ok" id="aviso-publicada">
          <Icon name="check" />
          <span>
            <b>¡Listo, tu reseña ya está publicada!</b> Si tus compañeros también cursaron acá, pasales el link así suman la suya.
          </span>
          <ShareButton titulo={`Ya dejé mi reseña de ${materia?.nombre}, ${curso?.identificador}. Sumá la tuya en UTN REP`} label="Pasalo al grupo" />
        </div>
      )}

      {totalResenas > 0 && (
        <div class="summary">
          <div>
            <span class="sub">Promedio del curso</span>
            <span class="big-score">{nota(promedio)} <small>de 5</small></span>
            <Stars value={promedio} />
            <span class="sub">{totalResenas} reseña{totalResenas !== 1 ? 's' : ''}</span>
          </div>
          <div>
            <span class="sub">Cómo lo puntuaron</span>
            <div class="bars dist">
              {[5, 4, 3, 2, 1].map((n) => (
                <div><span>{n} ★</span><i><b style={`width:${Math.round((distribucion[n - 1] / totalResenas) * 100)}%`}></b></i><span class="n">{distribucion[n - 1]}</span></div>
              ))}
            </div>
          </div>
          <div>
            <span class="sub">Cómo les fue</span>
            {conCondicion > 0 ? (
              <div class="facts">
                <div><span class="cond prom">Promocionaron</span><b>{pct(condiciones.prom)} %</b></div>
                <div><span class="cond reg">Regularizaron</span><b>{pct(condiciones.reg)} %</b></div>
                <div><span class="cond libre">Quedaron libres</span><b>{pct(condiciones.libre)} %</b></div>
                <span class="sub">Según {conCondicion} reseña{conCondicion !== 1 ? 's' : ''} que lo contaron.</span>
              </div>
            ) : (
              <span class="sub">Nadie contó todavía si promocionó o regularizó.</span>
            )}
          </div>
        </div>
      )}

      <div class="toolbar">
        <h2>Reseñas {totalResenas > 0 && <span class="sub">({totalResenas})</span>}</h2>
        {totalResenas > 1 && (
          <label class="sub">Ordenar:{' '}
            <select id="sort-select" class="mini" aria-label="Ordenar reseñas">
              <option value="newest">Más recientes</option>
              <option value="oldest">Más antiguas</option>
              <option value="highest">Mayor puntaje</option>
              <option value="lowest">Menor puntaje</option>
              <option value="useful">Más útiles</option>
            </select>
          </label>
        )}
      </div>

      {resenasData.length > 0 ? (
        <>
          <div id="reviews-list" style="display:grid;gap:12px">
            {resenasData.map((resena, idx) => (
              <ReviewCard
                resena={resena}
                hidden={idx >= 10}
                esPropia={misResenas.has(resena.id)}
                votada={misVotos.has(resena.id)}
                logueado={!!user}
                userIsAdmin={userIsAdmin}
                nombreAnonimo={nombresAnonimos[resena.id]}
              />
            ))}
          </div>
          {resenasData.length > 10 && (
            <div>
              <button id="show-more-btn" type="button" class="btn secondary">
                Ver más reseñas ({resenasData.length - 10} restantes)
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="empty">
          <h3>Todavía no hay reseñas</h3>
          <span>Sé la primera persona en contar cómo es cursar en este curso.</span>
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir la primera reseña</a>
        </div>
      )}
    </div>

    <aside class="side" aria-label="Datos del curso">
      <section class="panel">
        <h3>Equipo docente</h3>
        <div class="in">
          {profesores.length > 0 ? (
            <ul class="team">
              {profesores.map((p: any) => <li><a href={`/profesor/${p.id}`}>{p.nombre_completo}</a></li>)}
            </ul>
          ) : (
            <span class="sub">Sin profesores cargados.</span>
          )}
          {fechaActualizacion && (
            <span class="sub"><Icon name="clock" class="ico" /> Información actualizada {tiempoRelativo(fechaActualizacion).toLowerCase()}.</span>
          )}
        </div>
      </section>

      <section class="panel cta">
        <h3>¿Cursaste en este curso?</h3>
        <div class="in">
          <span>Tu reseña ayuda a quien tiene que elegir curso el próximo cuatri.</span>
          <a class="btn primary big" href={escribir}><Icon name="pen" /> Escribir una reseña</a>
        </div>
      </section>

      {(cantCursos || 0) > 1 && (
        <section class="panel">
          <h3>¿Y los otros cursos?</h3>
          <div class="in">
            <span>{materia?.nombre} tiene {cantCursos} cursos. Comparalos por puntaje y por cuántos promocionan.</span>
            <a class="btn secondary" href={`/materia/${materia?.id}/comparar?desde=${id}`}><Icon name="compare" /> Comparar cursos</a>
            <a href={`/materia/${materia?.id}`}>Ver todos los cursos de {materia?.nombre}</a>
          </div>
        </section>
      )}

      <section class="panel">
        <h3>Finales de esta materia</h3>
        <div class="in">
          {cantFinales
            ? <><span>{cantFinales} experiencia{cantFinales !== 1 ? 's' : ''} de cómo toman el final.</span><a class="btn quiet" href={`/finales?materia=${materia?.id}`}><Icon name="final" /> Ver los finales</a></>
            : <><span>Todavía nadie contó cómo es el final.</span><a href="/finales/nuevo">¿Lo rendiste? Contalo</a></>}
        </div>
      </section>
    </aside>
  </div>

  <script>
    import '../../scripts/dictado';
  </script>
</Layout>
