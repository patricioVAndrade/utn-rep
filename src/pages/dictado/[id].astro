---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import CursoChips from '../../components/CursoChips.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import ShareButton from '../../components/ShareButton.astro';
import SeguirMateria from '../../components/SeguirMateria.astro';
import FinalesPanel from '../../components/FinalesPanel.astro';
import { supabase, createSupabaseServerClient } from '../../lib/supabase';
import { supabaseAdmin } from '../../lib/supabase-admin';
import { isAdmin } from '../../lib/admin';
import { autoresDeResenas } from '../../lib/fichas';
import { anioLabel, compararCursos, nota, tiempoRelativo } from '../../lib/format';

const user = Astro.locals.user;
const userIsAdmin = isAdmin(user?.id);

const { id } = Astro.params;

// Curso con materia y profesores
const { data: dictado, error } = await supabase
  .from('dictados')
  .select(`
    id, curso_id, materia_id,
    es_contracuatrimestral,
    periodo_dictado,
    es_intensivo,
    updated_at,
    created_at,
    cursos ( identificador, anio_carrera, turno ),
    materias ( id, nombre, nivel, es_electiva, puntos_electiva ),
    dictado_profesores (
      updated_at,
      created_at,
      profesores ( id, nombre_completo )
    )
  `)
  .eq('id', id)
  .single();

if (error || !dictado) {
  if (error) console.error('[dictado] Error de Supabase:', error.message);
  return Astro.redirect('/404');
}

// Última actualización de la información del curso (sin contar reseñas)
const fechas: string[] = [dictado.updated_at, dictado.created_at].filter(Boolean) as string[];
(dictado.dictado_profesores || []).forEach((dp: any) => {
  if (dp.updated_at) fechas.push(dp.updated_at);
  if (dp.created_at) fechas.push(dp.created_at);
});
const fechaActualizacion = fechas.length > 0
  ? new Date(Math.max(...fechas.map((f) => new Date(f).getTime()))).toISOString()
  : null;

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);
const curso = one((dictado as any).cursos);
const materia = one((dictado as any).materias);
const profesores = ((dictado as any).dictado_profesores || []).map((dp: any) => one(dp.profesores)).filter(Boolean);

// Reseñas (vista pública: sin user_id y sin nombre en las anónimas)
const { data: resenas } = await supabase
  .from('resenas_publicas')
  .select('*')
  .eq('dictado_id', id)
  .order('created_at', { ascending: false });

const resenaIds = (resenas || []).map((r) => r.id);

// Foto y ficha de quien escribió cada reseña con nombre (migración 8)
const autores = await autoresDeResenas(resenaIds);

// Respuestas de la moderación (públicas, migración 4)
const { data: respuestas } = resenaIds.length
  ? await supabase.from('respuestas_moderador').select('resena_id, texto').in('resena_id', resenaIds)
  : { data: [] as any[] };
const respuestaDe = new Map((respuestas || []).map((r: any) => [r.resena_id, r.texto as string]));
const resenasData = (resenas || []).map((r: any) => ({ ...r, respuesta_moderador: respuestaDe.get(r.id) || null }));

// Reseñas propias y votos del usuario (RLS: cada uno solo ve sus filas)
let misResenas = new Set<number>();
let misVotos = new Set<number>();
if (user && resenaIds.length > 0) {
  const { client: userClient } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const [{ data: propias }, { data: votos }] = await Promise.all([
    userClient.from('resenas').select('id').eq('dictado_id', id).eq('user_id', user.id),
    userClient.from('votos_resenas').select('resena_id').in('resena_id', resenaIds),
  ]);
  misResenas = new Set((propias || []).map((r) => r.id));
  misVotos = new Set((votos || []).map((v) => v.resena_id));
}

// Nombres reales de las anónimas, solo para admins
let nombresAnonimos: Record<number, string> = {};
if (userIsAdmin && resenasData.some((r) => r.es_anonima)) {
  const { data } = await supabaseAdmin
    .from('resenas')
    .select('id, nombre_usuario')
    .eq('dictado_id', id)
    .eq('es_anonima', true);
  nombresAnonimos = Object.fromEntries((data || []).map((r) => [r.id, r.nombre_usuario]));
}

// Estadísticas
const totalResenas = resenasData.length;
let promedio = 0;
const distribucion = [0, 0, 0, 0, 0];
if (totalResenas > 0) {
  promedio = resenasData.reduce((acc, r) => acc + r.calificacion_general, 0) / totalResenas;
  resenasData.forEach((r) => {
    const idx = Math.min(Math.max(Math.round(r.calificacion_general) - 1, 0), 4);
    distribucion[idx]++;
  });
}
const condiciones = {
  prom: resenasData.filter((r) => r.condicion_final === 'PROMOCIONADO').length,
  reg: resenasData.filter((r) => r.condicion_final === 'REGULAR').length,
  libre: resenasData.filter((r) => r.condicion_final === 'LIBRE').length,
};
const conCondicion = condiciones.prom + condiciones.reg + condiciones.libre;

const nivel = materia?.nivel || 1;
const label = anioLabel(nivel).replace(/^./, (c) => c.toUpperCase());
const escribir = `/nueva-resena?dictado=${id}&from=/dictado/${id}`;
const pct = (n: number) => (conCondicion ? Math.round((n / conCondicion) * 100) : 0);

// Otros cursos de la misma materia, con su nota
const { data: otrosRaw } = await supabase
  .from('dictados')
  .select('id, cursos ( identificador, turno )')
  .eq('materia_id', dictado.materia_id);
const otrosIds = (otrosRaw || []).map((d: any) => d.id).filter((x: number) => x !== dictado.id);
const statsOtros = new Map<number, { promedio: number; cantidad: number }>();
if (otrosIds.length > 0) {
  const { data } = await supabase.from('stats_dictados').select('dictado_id, cantidad, promedio').in('dictado_id', otrosIds);
  (data || []).forEach((s: any) => statsOtros.set(s.dictado_id, s));
}
const otros = (otrosRaw || [])
  .filter((d: any) => d.id !== dictado.id)
  .map((d: any) => ({ id: d.id, curso: one(d.cursos), st: statsOtros.get(d.id) }))
  .sort((a: any, b: any) => (b.st?.cantidad ? b.st.promedio : -1) - (a.st?.cantidad ? a.st.promedio : -1) || compararCursos(a.curso?.identificador, b.curso?.identificador));
const totalCursos = (otrosRaw || []).length;
---

<Layout
  compartido={{ que: 'este curso', escribir }}
  title={`${curso?.identificador || ''} - ${materia?.nombre || ''} - UTN REP`}
  description={`Reseñas del curso ${curso?.identificador || ''} de ${materia?.nombre || ''} en la UTN FRC: nota, cuántos promocionan y qué dicen los alumnos.`}
  ogImage={`/og/curso/${id}.png`}
  ogTitle={totalResenas
    ? `${materia?.nombre || ''} ${curso?.identificador || ''}: ${promedio.toFixed(1).replace('.', ',')} ★ en ${totalResenas} reseña${totalResenas === 1 ? '' : 's'} | UTN REP`
    : `${materia?.nombre || ''} ${curso?.identificador || ''} | UTN REP`}
  tab="materias"
  crumbs={[
    { label: 'Materias', href: '/' },
    { label, href: `/nivel/${nivel}` },
    { label: materia?.nombre || 'Materia', href: `/materia/${materia?.id}` },
    { label: `Curso ${curso?.identificador || ''}` },
  ]}
>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>{materia?.nombre}</h1>
          <div class="chips" style="margin-top:6px">
            <span class="chip"><b>Curso {curso?.identificador}</b></span>
            <CursoChips
              turno={curso?.turno}
              periodo={dictado.periodo_dictado}
              contra={dictado.es_contracuatrimestral}
              intensivo={dictado.es_intensivo}
              electiva={materia?.es_electiva ? { puntos: materia?.puntos_electiva } : null}
            />
            <a class:list={['chip yr', `y${nivel}`]} href={`/nivel/${nivel}`}>{nivel}.º año</a>
          </div>
        </div>
        <div class="actions">
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir una reseña de este curso</a>
          <ShareButton titulo={`Reseñas de ${materia?.nombre}, curso ${curso?.identificador}, en UTN REP`} />
        </div>
      </div>

      {totalResenas > 0 && (
        <div class="summary">
          <div>
            <span class="sub">Nota del curso</span>
            <span class="big-score">{nota(promedio)} <small>de 5</small></span>
            <Stars value={promedio} />
            <span class="sub">en {totalResenas} reseña{totalResenas !== 1 ? 's' : ''}</span>
          </div>
          <div>
            <span class="sub">Cómo se reparten las estrellas</span>
            <div class="bars dist">
              {[5, 4, 3, 2, 1].map((n) => (
                <div><span>{n} ★</span><i><b style={`width:${Math.round((distribucion[n - 1] / totalResenas) * 100)}%`}></b></i><span class="n">{distribucion[n - 1]}</span></div>
              ))}
            </div>
          </div>
          <div>
            <span class="sub">Lo que cuentan los alumnos</span>
            {conCondicion > 0 ? (
              <div class="facts">
                <div><span>Promocionó</span><b>{pct(condiciones.prom)} %</b></div>
                <div><span>Quedó regular</span><b>{pct(condiciones.reg)} %</b></div>
                <div><span>Quedó libre</span><b>{pct(condiciones.libre)} %</b></div>
                <span class="sub">Según {conCondicion} reseña{conCondicion !== 1 ? 's' : ''} que lo contaron.</span>
              </div>
            ) : (
              <span class="sub">Nadie contó todavía si promocionó o regularizó.</span>
            )}
          </div>
        </div>
      )}

      {resenasData.length > 0 ? (
        <>
          <div class="toolbar" id="resenas">
            <div class="pager" data-pager></div>
            {totalResenas > 1 && (
              <div class="seg" role="group" aria-label="Ordenar reseñas">
                <button type="button" data-orden="useful" aria-pressed="true">Más útiles</button>
                <button type="button" data-orden="newest" aria-pressed="false">Más recientes</button>
                <button type="button" data-orden="lowest" aria-pressed="false">Peor puntaje</button>
              </div>
            )}
          </div>
          <div id="reviews-list" style="display:grid;gap:12px">
            {resenasData.map((resena) => (
              <ReviewCard
                resena={resena}
                esPropia={misResenas.has(resena.id)}
                votada={misVotos.has(resena.id)}
                logueado={!!user}
                userIsAdmin={userIsAdmin}
                nombreAnonimo={nombresAnonimos[resena.id]}
                autor={autores.get(resena.id)}
              />
            ))}
          </div>
          <div class="toolbar">
            <div class="pager" data-pager></div>
            <a href="#contenido" class="sub">Volver arriba</a>
          </div>
        </>
      ) : (
        <div class="empty">
          <h3>Todavía no hay reseñas</h3>
          <span>Sé la primera persona en contar cómo es cursar en este curso.</span>
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir la primera reseña</a>
        </div>
      )}
    </div>

    <aside class="side" aria-label="Datos del curso">
      {materia && <FinalesPanel materiaId={materia.id} />}
      {materia && <SeguirMateria materiaId={materia.id} materiaNombre={materia.nombre} />}

      <section class="panel">
        <h3>Profesores de este curso</h3>
        <div class="in feed">
          {profesores.length > 0
            ? profesores.map((p: any) => <div><a href={`/profesor/${p.id}`}>{p.nombre_completo}</a></div>)
            : <span class="sub">Sin profesores cargados.</span>}
          {fechaActualizacion && (
            <span class="sub"><Icon name="clock" class="ico" /> Información actualizada {tiempoRelativo(fechaActualizacion).toLowerCase()}.</span>
          )}
        </div>
      </section>

      {otros.length > 0 && (
        <section class="panel">
          <h3>Otros cursos de esta materia</h3>
          <div class="in feed">
            {otros.slice(0, 4).map((o: any) => (
              <div>
                <span><a href={`/dictado/${o.id}`}>{o.curso?.identificador || 'Curso'}</a> <CursoChips mini turno={o.curso?.turno} /></span>
                <span class="sub">{o.st?.cantidad ? <><Stars value={o.st.promedio} /> {nota(o.st.promedio)} en {o.st.cantidad} reseña{o.st.cantidad !== 1 ? 's' : ''}</> : 'Sin reseñas todavía'}</span>
              </div>
            ))}
            <a class="btn secondary big" href={`/materia/${materia?.id}/comparar?desde=${id}`} data-nuevo="comparar"><Icon name="compare" /> Comparar los {totalCursos} cursos</a>
          </div>
        </section>
      )}
    </aside>
  </div>

  <script>
    import '../../scripts/dictado';
  </script>
</Layout>
