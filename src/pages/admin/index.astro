---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import Stars from '../../components/Stars.astro';
import { isAdmin } from '../../lib/admin';
import { supabaseAdmin } from '../../lib/supabase-admin';
import { tiempoRelativo } from '../../lib/format';

const user = Astro.locals.user;
if (!user || !isAdmin(user.id)) return Astro.redirect('/');

const DIA = 86400000;
const ahora = Date.now();
const hace7 = new Date(ahora - 7 * DIA).toISOString();
const hace14 = new Date(ahora - 14 * DIA).toISOString();
const hace30 = new Date(ahora - 30 * DIA);
const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);

const [
  { data: reportes },
  { data: resenas30 },
  { count: finalesSemana },
  { count: finalesAntes },
  { data: dictados },
  { data: conProfes },
  { data: stats },
  { data: ultimas },
  { count: linksSemana },
  { count: linksAntes },
] = await Promise.all([
  supabaseAdmin.from('reportes_resenas').select('id, resena_id, created_at').order('created_at', { ascending: true }),
  supabaseAdmin.from('resenas').select('id, user_id, created_at').gte('created_at', hace30.toISOString()).range(0, 9999),
  supabaseAdmin.from('experiencias_finales').select('id', { count: 'exact', head: true }).gte('created_at', hace7),
  supabaseAdmin.from('experiencias_finales').select('id', { count: 'exact', head: true }).gte('created_at', hace14).lt('created_at', hace7),
  supabaseAdmin.from('dictados').select('id, materias ( nombre, nivel ), cursos ( identificador )').range(0, 19999),
  supabaseAdmin.from('dictado_profesores').select('dictado_id').range(0, 49999),
  supabaseAdmin.from('stats_dictados').select('dictado_id, cantidad').range(0, 19999),
  supabaseAdmin.from('resenas').select('id, dictado_id, calificacion_general, created_at, es_anonima, nombre_usuario, dictados ( materias ( nombre ), cursos ( identificador ) )').order('created_at', { ascending: false }).limit(6),
  // Links compartidos (migración 9): personas distintas que abrieron un link con ?de=
  supabaseAdmin.from('aperturas_link').select('codigo', { count: 'exact', head: true }).gte('created_at', hace7),
  supabaseAdmin.from('aperturas_link').select('codigo', { count: 'exact', head: true }).gte('created_at', hace14).lt('created_at', hace7),
]);

// Para hacer hoy
const reportesLista = reportes || [];
const resenasReportadas = new Set(reportesLista.map((r) => r.resena_id)).size;
const masViejo = reportesLista[0]?.created_at;
const tienenProfes = new Set((conProfes || []).map((d) => d.dictado_id));
const sinProfes = (dictados || []).filter((d: any) => !tienenProfes.has(d.id)).map((d: any) => `${one(d.materias)?.nombre || 'Materia'}, ${one(d.cursos)?.identificador || '?'}`);

// Números de la semana contra la anterior
const lista30 = resenas30 || [];
const enRango = (iso: string, desde: number, hasta: number) => { const t = new Date(iso).getTime(); return t >= desde && t < hasta; };
const semana = lista30.filter((r) => enRango(r.created_at, ahora - 7 * DIA, ahora + DIA));
const anterior = lista30.filter((r) => enRango(r.created_at, ahora - 14 * DIA, ahora - 7 * DIA));
const personas = (xs: typeof lista30) => new Set(xs.map((r) => r.user_id).filter(Boolean)).size;
const nuevosReportes = reportesLista.filter((r) => new Date(r.created_at).getTime() >= ahora - 7 * DIA).length;
const comparar = (a: number, b: number) => {
  if (!b) return a ? { cls: 'up', txt: 'la semana pasada no hubo' } : { cls: '', txt: 'igual que la semana pasada' };
  const p = Math.round(((a - b) / b) * 100);
  return p === 0 ? { cls: '', txt: 'igual que la semana pasada' } : { cls: p > 0 ? 'up' : 'down', txt: `${p > 0 ? '▲' : '▼'} ${Math.abs(p)} % vs. la semana pasada` };
};
const kpis = [
  { label: 'Reseñas nuevas', n: semana.length, c: comparar(semana.length, anterior.length) },
  { label: 'Finales contados', n: finalesSemana || 0, c: comparar(finalesSemana || 0, finalesAntes || 0) },
  { label: 'Personas que reseñaron', n: personas(semana), c: comparar(personas(semana), personas(anterior)) },
  { label: 'Links abiertos', n: linksSemana || 0, c: comparar(linksSemana || 0, linksAntes || 0) },
  { label: 'Reportes nuevos', n: nuevosReportes, c: { cls: '', txt: `${resenasReportadas} reseña${resenasReportadas !== 1 ? 's' : ''} sin revisar` } },
];

// Reseñas por día, últimos 30 días
const dias = Array.from({ length: 30 }, (_, i) => {
  const d = new Date(ahora - (29 - i) * DIA);
  return { clave: d.toISOString().slice(0, 10), n: 0, label: d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' }) };
});
const porDia = new Map(dias.map((d) => [d.clave, d]));
lista30.forEach((r) => { const d = porDia.get(r.created_at.slice(0, 10)); if (d) d.n++; });
const maxDia = Math.max(1, ...dias.map((d) => d.n));

// Dónde faltan reseñas: % de cursos con al menos una, por año
const cantidad = new Map((stats || []).map((s) => [s.dictado_id, s.cantidad || 0]));
const NOMBRES = ['', 'Primer año', 'Segundo año', 'Tercer año', 'Cuarto año', 'Quinto año'];
const cobertura = [1, 2, 3, 4, 5].map((n) => {
  const ds = (dictados || []).filter((d: any) => one(d.materias)?.nivel === n);
  const con = ds.filter((d: any) => (cantidad.get(d.id) || 0) > 0).length;
  return { n, total: ds.length, pct: ds.length ? Math.round((con / ds.length) * 100) : 0 };
});

const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-AR', { day: 'numeric', month: 'long' });
---

<Layout title="Resumen - Panel de admin" crumbs={[{ label: 'Panel de admin' }]}>
  <div class="admin-wrap">
    <AdminNav actual="resumen" />
    <div class="admin-main">
      <div class="topic">
        <div>
          <h1>Resumen</h1>
          <p>Últimos 7 días, del {fmt(new Date(ahora - 6 * DIA).toISOString())} a hoy.</p>
        </div>
      </div>

      <section class="todo">
        <h2>Para hacer hoy</h2>
        {resenasReportadas > 0 && (
          <div><i class="r"></i><span><b><a href="/admin/reportes">{resenasReportadas} reseña{resenasReportadas !== 1 ? 's' : ''} reportada{resenasReportadas !== 1 ? 's' : ''} sin revisar</a></b><span class="sub">El reporte más viejo es de {tiempoRelativo(masViejo!).toLowerCase()}.</span></span></div>
        )}
        {sinProfes.length > 0 && (
          <div><i class="a"></i><span><b><a href="/admin/materias">{sinProfes.length} curso{sinProfes.length !== 1 ? 's' : ''} sin profesores cargados</a></b><span class="sub">{sinProfes.slice(0, 3).join('; ')}{sinProfes.length > 3 ? ` y ${sinProfes.length - 3} más` : ''}. Se puede completar con Importar cuatrimestre.</span></span></div>
        )}
        {resenasReportadas === 0 && sinProfes.length === 0 && (
          <div><i></i><span><b>Nada pendiente.</b><span class="sub">No hay reportes ni cursos sin profesores.</span></span></div>
        )}
      </section>

      <div class="stat4">
        {kpis.map((k) => (
          <div><span>{k.label}</span><b>{k.n}</b><em class={k.c.cls}>{k.c.txt}</em></div>
        ))}
      </div>

      <section class="panel">
        <h3>Reseñas por día, últimos 30 días</h3>
        <div class="in">
          <div class="chart" role="img" aria-label={`Reseñas por día. Máximo ${maxDia} en un día.`}>
            {dias.map((d) => <i style={`height:${Math.round((d.n / maxDia) * 100)}%`} title={`${d.label}: ${d.n}`}></i>)}
          </div>
          <div class="chart-x"><span>{dias[0].label}</span><span>{dias[15].label}</span><span>Hoy</span></div>
        </div>
      </section>

      <div class="two">
        <section class="panel">
          <h3>Dónde faltan reseñas</h3>
          <div class="in">
            <div class="bars">
              {cobertura.map((c) => (
                <div title={NOMBRES[c.n]}><span>{c.n}.º año</span><i><b style={`width:${c.pct}%`}></b></i><span class="n">{c.pct} %</span></div>
              ))}
            </div>
            <span class="sub">Porcentaje de cursos con al menos una reseña.</span>
          </div>
        </section>
        <section class="panel">
          <h3>Últimas reseñas</h3>
          <div class="in feed">
            {(ultimas || []).map((r: any) => {
              const d = one(r.dictados);
              return (
                <div>
                  <span><a href={`/dictado/${r.dictado_id}#resena-${r.id}`}>{one(d?.materias)?.nombre}, {one(d?.cursos)?.identificador}</a> <Stars value={r.calificacion_general} /></span>
                  <span class="sub">{tiempoRelativo(r.created_at)}, por {r.es_anonima ? `Anónimo (${r.nombre_usuario || 'sin nombre'})` : r.nombre_usuario || 'Estudiante'}</span>
                </div>
              );
            })}
            <a href="/admin/resenas">Ver todas</a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
