---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import Escudo from '../components/Escudo.astro';
import LogroIcono from '../components/LogroIcono.astro';
import { LOGROS, progresoRango, rango } from '../lib/logros';
import { createSupabaseServerClient } from '../lib/supabase';
import { supabaseAdmin } from '../lib/supabase-admin';
import { DIBUJOS, leerPerfil } from '../lib/perfil';
import { PREFERENCIAS_EDITABLES } from '../lib/avisos';
import { MAIL_POR_DEFECTO } from '../lib/mail';
import { telegramListo } from '../lib/telegram';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/');

const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
const [perfil, { data: auth }, { data: seguidasRaw }, { data: prefsRaw }, { count: cantResenas }, { data: logrosRaw }, { data: telegram }] = await Promise.all([
  leerPerfil(client, user.id),
  client.auth.getUser(),
  client.from('seguimientos').select('materia_id, mail, materias ( id, nombre, nivel )').eq('user_id', user.id).order('created_at', { ascending: true }),
  client.from('preferencias_aviso').select('tipo, canal, activo').eq('user_id', user.id),
  client.from('resenas').select('id', { count: 'exact', head: true }).eq('user_id', user.id),
  client.from('logros_usuario').select('logro, ganado_at').eq('user_id', user.id),
  // Telegram (migración 18); sin la migración, null
  client.from('telegram_cuentas').select('usuario, vinculado_at').eq('user_id', user.id).maybeSingle(),
]);
const hayTelegram = telegramListo();
// Quien eligió la foto de Google antes de la migración 8 todavía no la tiene guardada para las reseñas
if (perfil.foto === 'google' && typeof user.avatar === 'string' && user.avatar.startsWith('https://') && user.avatar.length <= 500) {
  try { await supabaseAdmin.from('perfiles').update({ foto_url: user.avatar }).eq('user_id', user.id).is('foto_url', null); } catch { /* no es grave */ }
}
// Rango y logros (migración 8)
const nResenas = cantResenas || 0;
const miRango = rango(nResenas);
const prog = progresoRango(nResenas);
const ganados = new Set((logrosRaw || []).map((l: any) => l.logro));
const logrosOrden = [...LOGROS.filter((l) => ganados.has(l.id)), ...LOGROS.filter((l) => !ganados.has(l.id))];
// Sin fila, el aviso está prendido
const prendido = (tipos: string[], canal = 'sitio') => !(prefsRaw || []).some((p: any) => tipos.includes(p.tipo) && p.canal === canal && p.activo === false);
// Por mail (migración 17): sin fila, lo de MAIL_POR_DEFECTO
const prendidoMail = (tipos: string[]) => {
  const fila = (prefsRaw || []).find((p: any) => p.tipo === tipos[0] && p.canal === 'mail');
  return fila ? fila.activo !== false : MAIL_POR_DEFECTO[tipos[0]] === true;
};
// Por Telegram (migración 18): sin fila, sí
const prendidoTelegram = (tipos: string[]) => prendido(tipos, 'telegram');
const seguidas = (seguidasRaw || [])
  .map((x: any) => ({ mail: x.mail, materia: Array.isArray(x.materias) ? x.materias[0] : x.materias }))
  .filter((x: any) => x.materia)
  .sort((a: any, b: any) => a.materia.nivel - b.materia.nivel || a.materia.nombre.localeCompare(b.materia.nombre));
const cuenta = auth?.user;
const nombreGoogle = cuenta?.user_metadata?.full_name || cuenta?.user_metadata?.name || user.email.split('@')[0] || 'Usuario';
const nombre = perfil.nombre_mostrar || nombreGoogle;
const proveedor = ({ google: 'Google', github: 'GitHub', email: 'Link por mail' } as Record<string, string>)[cuenta?.app_metadata?.provider || ''] || 'Link por mail';
const desde = cuenta?.created_at ? new Date(cuenta.created_at).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' }) : null;
const pausada = perfil.como_te_fue_pausa_hasta && new Date(perfil.como_te_fue_pausa_hasta).getTime() > Date.now();
---

<Layout title="Mi cuenta - UTN REP" description="Cómo te ven en UTN REP, tus años de cursada y tu cuenta." crumbs={[{ label: 'Mi cuenta' }]}>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>Mi cuenta</h1>
          <p>Lo que ven los demás de vos y cómo querés usar el sitio. Se guarda solo, y te sigue en el celular y en la compu.</p>
        </div>
      </div>

      <form class="form" id="como-te-ven" onsubmit="return false">
        <div class="fhead"><span>Cómo te ven</span><span class="draft-note" data-estado aria-live="polite"></span></div>
        <div class="fgrid">
          <label for="nombre">Nombre a mostrar<small>Sale de tu cuenta de {proveedor === 'Link por mail' ? 'mail' : proveedor}. Podés cambiarlo</small></label>
          <div class="field">
            <input type="text" id="nombre" maxlength="40" value={perfil.nombre_mostrar || ''} placeholder={nombreGoogle} autocomplete="nickname" />
            <span class="help">Sale en tus reseñas con nombre, también en las que ya publicaste. En las anónimas no se muestra nunca. Dejalo vacío para usar "{nombreGoogle}".</span>
          </div>

          <div class="lab" id="lab-foto">Foto<small>Se ve en tus reseñas con nombre</small></div>
          <div class="field">
            <div class="avatar-pick" role="radiogroup" aria-labelledby="lab-foto">
              <label><input type="radio" name="foto" value="inicial" checked={perfil.foto === 'inicial'} /><Avatar nombre={nombre} /><b>Tu inicial</b><small>Recomendada</small></label>
              <label class:list={{ off: !user.avatar }}><input type="radio" name="foto" value="google" checked={perfil.foto === 'google'} disabled={!user.avatar} /><Avatar nombre={nombre} foto="google" google={user.avatar} /><b>Tu foto de {proveedor === 'GitHub' ? 'GitHub' : 'Google'}</b><small>{user.avatar ? 'Te reconocen' : 'No hay foto'}</small></label>
              <label><input type="radio" name="foto" value="dibujo" checked={perfil.foto === 'dibujo'} /><span class="av set">{DIBUJOS.map((d) => <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={d.svg} /></i>)}</span><b>Un dibujo</b><small>Elegís uno de {DIBUJOS.length}</small></label>
            </div>
            <div class:list={['dibujos', { hidden: perfil.foto !== 'dibujo' }]} role="radiogroup" aria-label="Dibujo">
              {DIBUJOS.map((d) => (
                <label title={d.nombre}><input type="radio" name="dibujo" value={d.id} checked={(perfil.dibujo || 1) === d.id} /><Avatar nombre={nombre} foto="dibujo" dibujo={d.id} class="sm" /><span class="sr">{d.nombre}</span></label>
              ))}
            </div>
            {!user.avatar && <span class="help">Si entraste con el link por mail no hay foto: quedan la inicial o un dibujo.</span>}
          </div>

          <div class="lab">Tu ficha</div>
          <div class="field">
            <label class="toggle"><input type="checkbox" id="mostrar-ficha" checked={perfil.mostrar_ficha} /><span class="tg"></span><span>Mostrar mi ficha cuando tocan mi nombre <small class="sub">(rango, cantidad de reseñas y logros, nunca qué materias reseñaste)</small></span></label>
          </div>
        </div>
      </form>

      <section class="panel" id="logros">
        <h3>Rango y logros</h3>
        <div class="in">
          <div class="rank-prog">
            {miRango ? <Escudo rango={miRango.id} /> : <span></span>}
            <div>
              {miRango
                ? <><b>{miRango.nombre}</b>{`, ${nResenas} ${nResenas === 1 ? 'reseña' : 'reseñas'}`}</>
                : <><b>Todavía sin rango</b>: con tu primera reseña sos Ingresante</>}
              <div class="pbar"><b style={`width:${prog.pct}%`}></b></div>
              <span class="sub">{prog.siguiente
                ? <>{`Te ${prog.faltan === 1 ? 'falta' : 'faltan'} ${prog.faltan} para `}<Escudo rango={prog.siguiente.id} />{` ${prog.siguiente.nombre}`}</>
                : 'Llegaste al rango más alto.'}</span>
            </div>
          </div>
          <div class="logro-grid">
            {logrosOrden.map((l) => {
              const tiene = ganados.has(l.id);
              return (
                <div class:list={['lg', { off: !tiene }]}>
                  <LogroIcono id={l.id} off={!tiene} />
                  <span>{l.nombre}{!tiene && <small>{l.como}</small>}</span>
                </div>
              );
            })}
          </div>
          <span class="sub">Los logros se ganan solos y no se pierden. Van a sumarse más.</span>
        </div>
      </section>

      <section class="panel" id="seguis">
        <h3>Materias que seguís</h3>
        <div class="in">
          {seguidas.length
            ? seguidas.map((x: any) => (
              <div class="follow" data-materia={x.materia.id}>
                <span class:list={['yr', `y${x.materia.nivel}`]}>{x.materia.nivel}.º</span>
                <a href={`/materia/${x.materia.id}`}>{x.materia.nombre}</a>
                <label class="toggle sm"><input type="checkbox" data-mail checked={x.mail} /><span class="tg"></span><span>Mail</span></label>
                <button type="button" class="linklike sub" data-dejar>Dejar de seguir</button>
              </div>
            ))
            : <span class="sub" id="sin-seguidas">Todavía no seguís ninguna. En cada materia y en cada curso hay un botón "Seguir materia".</span>}
          {seguidas.length > 0 && <span class="sub">Te avisamos en <a href="/avisos">Avisos</a> cuando hay reseñas o finales nuevos. Con "Mail" prendido también te llega por mail, si no lo viste antes en el sitio.</span>}
        </div>
      </section>

      <section class="panel" id="tus-anios">
        <h2>Tus años de cursada</h2>
        <div class="acct-row">
          <div class="acct-lbl">
            <b>¿Qué años cursás?</b>
            <span class="sub">Podés elegir más de uno.</span>
          </div>
          <div class="acct-val">
            <div class="yr-pick" id="mis-anios" data-guardados={JSON.stringify(perfil.anios_cursada)} data-perfil={perfil.guardado ? '1' : ''}>
              {[1, 2, 3, 4, 5].map((n) => <label><input type="checkbox" value={n} checked={perfil.anios_cursada.includes(n)} /> {n}.º año</label>)}
            </div>
            <p class="sub">Para qué sirve:</p>
            <ul class="acct-list sub">
              <li>En <a href="/">Materias</a>, esos años vienen abiertos y los demás cerrados. Si no elegís ninguno, viene abierto solo 1.º.</li>
              <li>En <a href="/mis-resenas">Mis reseñas</a> te mostramos las materias de esos años que todavía no reseñaste.</li>
            </ul>
            <p class="sub" id="anios-ok" aria-live="polite"></p>
          </div>
        </div>
      </section>

      <section class="panel" id="avisos">
        <h2>Avisos</h2>
        <div class="acct-row">
          <div class="acct-lbl"><b>Qué te avisamos</b><span class="sub">En <a href="/avisos">Avisos</a>, arriba de todo, y si querés también {telegram ? 'por Telegram' : 'por mail'}</span></div>
          <div class="acct-val">
            {PREFERENCIAS_EDITABLES.map((p) => (
              <div class="pref">
                <label class="toggle"><input type="checkbox" data-tipos={p.tipos.join(',')} checked={prendido(p.tipos)} /><span class="tg"></span><span>{p.texto}{p.detalle && <small class="sub"> ({p.detalle})</small>}</span></label>
                {telegram
                  ? <label class="toggle sm"><input type="checkbox" data-tipos={p.tipos.join(',')} data-canal="telegram" checked={prendidoTelegram(p.tipos)} /><span class="tg"></span><span>Telegram</span></label>
                  : <label class="toggle sm"><input type="checkbox" data-tipos={p.tipos.join(',')} data-canal="mail" checked={prendidoMail(p.tipos)} /><span class="tg"></span><span>Mail</span></label>}
              </div>
            ))}
            <span class="sub">Si la moderación te pide que edites una reseña, te avisamos siempre.</span>
            {telegram
              ? <span class="sub">Con Telegram conectado, los avisos te llegan por ahí al momento, con el link directo, y no por mail. Si apagás un aviso, tampoco te llega por Telegram.</span>
              : <span class="sub">Por mail va solo lo que todavía no viste en el sitio, todo junto y como mucho una vez por día. Si apagás un aviso, tampoco te llega por mail. Las reseñas y los finales nuevos llegan por mail solo de las materias que tienen "Mail" prendido en Materias que seguís.</span>}
            <p class="sub" id="avisos-ok" aria-live="polite"></p>
          </div>
        </div>
        {(hayTelegram || telegram) && (
          <div class="acct-row" id="telegram">
            <div class="acct-lbl"><b>Telegram</b><span class="sub">Avisos al momento, sin mails</span></div>
            <div class="acct-val">
              {telegram ? (
                <>
                  <span><Icon name="check" /> Conectado{telegram.usuario ? <> como <b>{telegram.usuario}</b></> : null}. Tus avisos te llegan por Telegram.</span>
                  <div class="acts-row"><button type="button" class="btn quiet" id="tg-desconectar">Desconectar Telegram</button></div>
                </>
              ) : (
                <>
                  <span>Recibí tus avisos al momento en Telegram, con el link directo a la reseña o al curso. Mientras esté conectado, no te mandamos mails.</span>
                  <ol class="tg-pasos sub">
                    <li>Tocá <b>Conectar Telegram</b>: se abre el bot de UTN REP.</li>
                    <li>En Telegram, tocá <b>Iniciar</b> (o "Start").</li>
                    <li>Listo: el bot te confirma y acá vas a ver "Conectado".</li>
                  </ol>
                  <div class="acts-row"><button type="button" class="btn primary" id="tg-conectar">Conectar Telegram</button></div>
                  <span class="sub">Si no tenés Telegram, bajalo gratis de tu tienda de apps. El link sirve por 30 minutos.</span>
                </>
              )}
              <p class="sub" id="tg-ok" aria-live="polite"></p>
            </div>
          </div>
        )}
        <div class="acct-row">
          <div class="acct-lbl"><b>"¿Cómo te fue?"</b><span class="sub">En el inicio</span></div>
          <div class="acct-val">
            <label class="toggle"><input type="checkbox" id="preguntar" checked={perfil.preguntar_como_te_fue} /><span class="tg"></span><span>Preguntarme cómo me fue en las materias que reseñé sin decirlo</span></label>
            {pausada && perfil.preguntar_como_te_fue && <span class="sub" id="pausa">Lo pausaste con "Ahora no": vuelve a aparecer el {new Date(perfil.como_te_fue_pausa_hasta!).toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric' })}.</span>}
            <p class="sub" id="preguntar-ok" aria-live="polite"></p>
          </div>
        </div>
      </section>

      <section class="panel" id="cuenta">
        <h2>Cuenta</h2>
        <div class="acct-row">
          <div class="acct-lbl"><b>Datos</b></div>
          <div class="acct-val">
            <div class="facts">
              <div><span>Ingresás con</span><b>{proveedor}</b></div>
              <div><span>Mail</span><b>{user.email || '—'}</b></div>
              {desde && <div><span>En UTN REP desde</span><b>{desde}</b></div>}
            </div>
            <div class="acts-row">
              <form method="post" action="/api/auth/logout"><button type="submit" class="btn quiet" data-logout>Cerrar sesión</button></form>
              <button type="button" class="btn quiet danger" id="abrir-borrar"><Icon name="trash" /> Borrar mi cuenta</button>
            </div>
            <form class="borrar hidden" id="form-borrar">
              <b>¿Qué hacemos con lo que publicaste?</b>
              <label class="check"><input type="radio" name="resenas" value="anonimas" checked /> <span>Dejar mis reseñas y experiencias de finales como <b>anónimas</b>. Le siguen sirviendo a otros y ya nadie las puede asociar a vos.</span></label>
              <label class="check"><input type="radio" name="resenas" value="borrar" /> <span><b>Borrarlas</b> junto con la cuenta.</span></label>
              <label for="confirmar-borrar">Para confirmar, escribí <b>BORRAR</b>. No se puede deshacer.</label>
              <input id="confirmar-borrar" class="ainput sm" autocomplete="off" />
              <div class="acts-row">
                <button type="submit" class="btn danger" id="confirmar-btn" disabled><Icon name="trash" /> Borrar mi cuenta</button>
                <button type="button" class="btn quiet" id="cancelar-borrar">Cancelar</button>
              </div>
              <p class="sub" id="borrar-error" role="alert"></p>
            </form>
          </div>
        </div>
      </section>
    </div>

    <aside class="side">
      <section class="panel">
        <h3>Así te ven los demás</h3>
        <div class="in">
          <div class="author preview" id="vista-previa">
            <Avatar nombre={nombre} foto={perfil.foto} dibujo={perfil.dibujo} google={user.avatar} />
            <span class="uname" id="vista-nombre">{nombre}</span>
          </div>
          <span class="sub">Así salís en tus reseñas con nombre. En las anónimas sale "Anónimo" y nadie ve tu foto ni tu nombre, salvo la moderación.</span>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  import { DIBUJOS } from '../lib/perfil';
  const $ = (id: string) => document.getElementById(id)!;
  const estado = document.querySelector<HTMLElement>('#como-te-ven [data-estado]')!;

  async function guardar(cambios: Record<string, unknown>, aviso: HTMLElement, ok = 'Guardado') {
    aviso.textContent = 'Guardando…';
    try {
      const res = await fetch('/api/perfil', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cambios) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'No se pudo guardar.');
      aviso.textContent = ok;
      return true;
    } catch (e) {
      aviso.textContent = (e as Error).message;
      return false;
    }
  }

  // Vista previa
  const google = document.querySelector<HTMLImageElement>('.av.photo img')?.src || '';
  const nombreInput = $('nombre') as HTMLInputElement;
  const pintar = () => {
    const nombre = nombreInput.value.trim() || nombreInput.placeholder;
    $('vista-nombre').textContent = nombre;
    const foto = document.querySelector<HTMLInputElement>('input[name="foto"]:checked')?.value || 'inicial';
    const dibujo = Number(document.querySelector<HTMLInputElement>('input[name="dibujo"]:checked')?.value || 1);
    const av = document.querySelector<HTMLElement>('#vista-previa .av')!;
    av.className = 'av';
    av.replaceChildren();
    if (foto === 'google' && google) {
      av.classList.add('photo');
      const img = document.createElement('img');
      img.src = google; img.alt = ''; img.referrerPolicy = 'no-referrer';
      av.append(img);
    } else if (foto === 'dibujo') {
      av.classList.add('draw');
      av.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${(DIBUJOS.find((d) => d.id === dibujo) || DIBUJOS[0]).svg}</svg>`;
    } else {
      av.textContent = nombre.charAt(0).toUpperCase();
    }
    document.querySelectorAll<HTMLElement>('.avatar-pick label:first-child .av').forEach((x) => { x.textContent = nombre.charAt(0).toUpperCase(); });
  };

  // Nombre: se guarda al salir del campo o con Enter
  let ultimoNombre = nombreInput.value.trim();
  const guardarNombre = async () => {
    const v = nombreInput.value.trim();
    if (v === ultimoNombre) return;
    if (v && v.length < 2) { estado.textContent = 'El nombre tiene que tener al menos 2 caracteres.'; return; }
    if (await guardar({ nombre_mostrar: v }, estado, v ? 'Nombre guardado' : `Vuelve a salir "${nombreInput.placeholder}"`)) {
      ultimoNombre = v;
      const saludo = document.querySelector('.me-link');
      if (saludo) saludo.textContent = v || nombreInput.placeholder;
    }
  };
  nombreInput.addEventListener('input', pintar);
  nombreInput.addEventListener('change', guardarNombre);
  nombreInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); guardarNombre(); } });

  // Foto
  document.querySelectorAll<HTMLInputElement>('input[name="foto"]').forEach((r) => r.addEventListener('change', () => {
    document.querySelector('.dibujos')!.classList.toggle('hidden', r.value !== 'dibujo');
    pintar();
    const dibujo = Number(document.querySelector<HTMLInputElement>('input[name="dibujo"]:checked')?.value || 1);
    guardar(r.value === 'dibujo' ? { foto: 'dibujo', dibujo } : { foto: r.value }, estado, 'Foto guardada');
  }));
  document.querySelectorAll<HTMLInputElement>('input[name="dibujo"]').forEach((r) => r.addEventListener('change', () => {
    pintar();
    guardar({ foto: 'dibujo', dibujo: Number(r.value) }, estado, 'Dibujo guardado');
  }));

  ($('mostrar-ficha') as HTMLInputElement).addEventListener('change', (e) => {
    const on = (e.target as HTMLInputElement).checked;
    guardar({ mostrar_ficha: on }, estado, on ? 'Tu ficha se muestra' : 'Tu ficha queda oculta');
  });

  // Años de cursada: en tu cuenta y, para que el inicio abra rápido, también en este navegador
  const CLAVE = 'misAnios';
  const caja = $('mis-anios');
  const okAnios = $('anios-ok');
  const marcados = () => Array.from(caja.querySelectorAll<HTMLInputElement>('input:checked')).map((c) => Number(c.value));
  const espejo = (lista: number[]) => { try { localStorage.setItem(CLAVE, JSON.stringify(lista.map(String))); } catch {} };
  // Si antes los elegiste solo en este navegador, los pasamos a tu cuenta
  const guardados: number[] = JSON.parse(caja.dataset.guardados || '[]');
  let locales: number[] = [];
  try { locales = (JSON.parse(localStorage.getItem(CLAVE) || '[]') as unknown[]).map(Number).filter((n) => n >= 1 && n <= 5); } catch {}
  if (!guardados.length && locales.length) {
    caja.querySelectorAll<HTMLInputElement>('input').forEach((c) => { c.checked = locales.includes(Number(c.value)); });
    guardar({ anios_cursada: locales }, okAnios, 'Pasamos a tu cuenta los años que habías elegido en este navegador.');
  } else {
    espejo(guardados);
  }
  caja.querySelectorAll<HTMLInputElement>('input').forEach((cb) => cb.addEventListener('change', () => {
    const lista = marcados();
    espejo(lista);
    guardar({ anios_cursada: lista }, okAnios, lista.length ? `Listo: ${lista.map((a) => `${a}.º`).join(', ')} vienen abiertos en Materias.` : 'Listo: en Materias viene abierto solo 1.º.');
  }));

  // "¿Cómo te fue?"
  ($('preguntar') as HTMLInputElement).addEventListener('change', (e) => {
    const on = (e.target as HTMLInputElement).checked;
    try { localStorage.removeItem('comoTeFue'); } catch {}
    document.getElementById('pausa')?.remove();
    guardar(on ? { preguntar_como_te_fue: true, pausar_como_te_fue: false } : { preguntar_como_te_fue: false }, $('preguntar-ok'), on ? 'Te vamos a preguntar en el inicio.' : 'No te preguntamos más.');
  });

  // Materias que seguís
  document.querySelectorAll<HTMLElement>('#seguis .follow').forEach((fila) => {
    const materia_id = Number(fila.dataset.materia);
    const enviar = async (cuerpo: Record<string, unknown>) => {
      const res = await fetch('/api/seguir', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ materia_id, ...cuerpo }) });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'No se pudo.');
    };
    fila.querySelector<HTMLInputElement>('[data-mail]')!.addEventListener('change', async (e) => {
      const cb = e.target as HTMLInputElement;
      try { await enviar({ mail: cb.checked }); } catch (err) { cb.checked = !cb.checked; alert((err as Error).message); }
    });
    fila.querySelector<HTMLButtonElement>('[data-dejar]')!.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      try { await enviar({ seguir: false }); fila.remove(); } catch (err) { b.disabled = false; alert((err as Error).message); }
    });
  });

  // Qué avisos querés
  document.querySelectorAll<HTMLInputElement>('#avisos [data-tipos]').forEach((cb) => cb.addEventListener('change', async () => {
    const ok = $('avisos-ok');
    ok.textContent = 'Guardando…';
    try {
      const res = await fetch('/api/avisos/preferencias', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tipos: cb.dataset.tipos!.split(','), canal: cb.dataset.canal || 'sitio', activo: cb.checked }) });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'No se pudo guardar.');
      const canal = cb.dataset.canal === 'mail' ? 'mail' : cb.dataset.canal === 'telegram' ? 'Telegram' : '';
      ok.textContent = canal
        ? (cb.checked ? `Listo, también te llega por ${canal}.` : `Listo, ya no te llega por ${canal}.`)
        : (cb.checked ? 'Listo, te lo avisamos.' : 'Listo, no te lo avisamos más.');
    } catch (e) {
      cb.checked = !cb.checked;
      ok.textContent = (e as Error).message;
    }
  }));

  // Telegram (migración 18)
  const tgOk = document.getElementById('tg-ok');
  document.getElementById('tg-conectar')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    // La pestaña se abre ya (con el clic), si no el navegador la bloquea
    const ventana = window.open('', '_blank');
    b.disabled = true;
    try {
      const res = await fetch('/api/telegram/vincular', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accion: 'conectar' }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.link) throw new Error(data.error || 'No se pudo.');
      if (ventana) ventana.location.href = data.link; else window.location.href = data.link;
      if (tgOk) tgOk.innerHTML = 'Se abrió Telegram. Cuando toques <b>Iniciar</b>, <a href="/mi-cuenta#telegram">recargá esta página</a>.';
    } catch (err) {
      ventana?.close();
      if (tgOk) tgOk.textContent = (err as Error).message;
    } finally {
      b.disabled = false;
    }
  });
  document.getElementById('tg-desconectar')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      const res = await fetch('/api/telegram/vincular', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accion: 'desconectar' }) });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'No se pudo.');
      window.location.reload();
    } catch (err) {
      b.disabled = false;
      if (tgOk) tgOk.textContent = (err as Error).message;
    }
  });

  // Borrar la cuenta
  const formBorrar = $('form-borrar') as HTMLFormElement;
  const confirmar = $('confirmar-borrar') as HTMLInputElement;
  const btnBorrar = $('confirmar-btn') as HTMLButtonElement;
  $('abrir-borrar').addEventListener('click', () => { formBorrar.classList.remove('hidden'); confirmar.focus(); });
  $('cancelar-borrar').addEventListener('click', () => { formBorrar.classList.add('hidden'); confirmar.value = ''; btnBorrar.disabled = true; });
  confirmar.addEventListener('input', () => { btnBorrar.disabled = confirmar.value.trim() !== 'BORRAR'; });
  formBorrar.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnBorrar.disabled = true;
    const resenas = (formBorrar.querySelector<HTMLInputElement>('input[name="resenas"]:checked')?.value) || 'anonimas';
    try {
      const res = await fetch('/api/cuenta/borrar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ resenas, confirmacion: confirmar.value.trim() }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'No se pudo borrar la cuenta.');
      try { ['misAnios', 'comoTeFue', 'borradorResena', 'borradorFinal'].forEach((k) => localStorage.removeItem(k)); } catch {}
      await fetch('/api/auth/logout', { method: 'POST' }).catch(() => null);
      window.location.href = '/?cuenta_borrada=1';
    } catch (err) {
      $('borrar-error').textContent = (err as Error).message;
      btnBorrar.disabled = false;
    }
  });
</script>
