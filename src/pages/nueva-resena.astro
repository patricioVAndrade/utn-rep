---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { supabase } from '../lib/supabase';
import { anioLabel, turnoLabel } from '../lib/format';
import { safeReturnTo } from '../lib/redirect';

const user = Astro.locals.user;

// ¿Viene con curso o materia ya elegidos?
const dictadoIdParam = Astro.url.searchParams.get('dictado');
const materiaIdParam = Astro.url.searchParams.get('materia');

// A dónde volver después de publicar (solo rutas internas)
const fromRaw = Astro.url.searchParams.get('from');
const fromParam = fromRaw ? safeReturnTo(fromRaw) : '';

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);

let dictadoInfo: any = null;
if (dictadoIdParam) {
  const { data } = await supabase
    .from('dictados')
    .select(`
      id,
      cursos ( identificador, turno ),
      materias ( id, nombre, nivel )
    `)
    .eq('id', dictadoIdParam)
    .single();
  if (data) dictadoInfo = { ...data, cursos: one((data as any).cursos), materias: one((data as any).materias) };
}

let materiaPreseleccionada: any = null;
if (materiaIdParam && !dictadoIdParam) {
  const { data } = await supabase
    .from('materias')
    .select('id, nombre, nivel')
    .eq('id', materiaIdParam)
    .single();
  materiaPreseleccionada = data;
}

// Materias para el selector (solo si no viene con curso)
let materias: any[] = [];
if (!dictadoInfo) {
  const { data } = await supabase
    .from('materias')
    .select('id, nombre, nivel')
    .order('nivel')
    .order('nombre');
  materias = data || [];
}

const currentYear = new Date().getFullYear();
const materiaCtx = dictadoInfo?.materias || materiaPreseleccionada;
const crumbs = [
  { label: 'Materias', href: '/' },
  ...(materiaCtx ? [{ label: materiaCtx.nombre, href: `/materia/${materiaCtx.id}` }] : []),
  ...(dictadoInfo ? [{ label: dictadoInfo.cursos?.identificador || 'Curso', href: `/dictado/${dictadoInfo.id}` }] : []),
  { label: 'Escribir una reseña' },
];
---

<Layout title="Escribir una reseña - UTN REP" tab="escribir" crumbs={crumbs}>
  <div class="layout">
    <div class="main">
      {!user ? (
        <div class="empty">
          <h1 style="margin:0;font:bold 16px var(--f-title)"><Icon name="lock" class="ico" /> Iniciá sesión para escribir una reseña</h1>
          <span>Necesitás una cuenta para dejar tu opinión. Es rápido y no pide contraseña.</span>
          <span class="sub">Si elegís publicarla como anónima, tu nombre no se muestra.</span>
          <button id="login-btn-main" type="button" class="btn primary" data-login><Icon name="user" /> Iniciar sesión</button>
        </div>
      ) : (
        <>
          <div id="msg-success" class="notice ok hidden" role="status">
            <Icon name="check" />
            <div><b>¡Reseña publicada!</b><p>Gracias por contar tu experiencia. Te llevamos al curso…</p></div>
          </div>
          <div id="msg-error" class="notice bad hidden" role="alert">
            <Icon name="alert" />
            <div><b>No se pudo publicar</b><p id="msg-error-text">Probá de nuevo.</p></div>
          </div>

          <form id="review-form" class="form" novalidate>
            <h1 class="fhead">
              <span>Escribir una reseña</span>
              {dictadoInfo && <span>{dictadoInfo.materias?.nombre}, {dictadoInfo.cursos?.identificador} · Turno {turnoLabel(dictadoInfo.cursos?.turno).toLowerCase()}</span>}
            </h1>
            <div class="fgrid">
              {!dictadoInfo && (
                <>
                  <label for="materia-select">Materia<small>Elegí la materia que cursaste.</small></label>
                  <div class="field">
                    <select id="materia-select" required disabled={!!materiaPreseleccionada}>
                      <option value="">Elegí una materia…</option>
                      {[1, 2, 3, 4, 5].map((niv) => {
                        const lista = materias.filter((m) => m.nivel === niv);
                        return lista.length > 0 && (
                          <optgroup label={anioLabel(niv)}>
                            {lista.map((m) => <option value={m.id} selected={materiaPreseleccionada?.id === m.id}>{m.nombre}</option>)}
                          </optgroup>
                        );
                      })}
                    </select>
                    {materiaPreseleccionada && <input type="hidden" id="materia-hidden" value={materiaPreseleccionada.id} />}
                  </div>

                  <label for="curso-select">Curso<small>Por ejemplo 2K3. Cada curso tiene su equipo docente.</small></label>
                  <div class="field">
                    <select id="curso-select" required disabled={!materiaPreseleccionada}>
                      <option value="">{materiaPreseleccionada ? 'Cargando cursos…' : 'Primero elegí una materia'}</option>
                    </select>
                  </div>
                </>
              )}
              {dictadoInfo && <input type="hidden" id="dictado-id-hidden" value={dictadoIdParam} />}

              <span class="lab" id="lab-cal">Puntaje<small>¿Cómo fue tu experiencia en general?</small></span>
              <div class="field">
                <div class="star-pick" id="star-rating" role="radiogroup" aria-labelledby="lab-cal">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <button type="button" data-star={star} class="star-btn" role="radio" aria-checked="false" aria-label={`${star} estrella${star > 1 ? 's' : ''}`}>★</button>
                  ))}
                </div>
                <input type="hidden" id="calificacion" name="calificacion" value="0" />
                <span id="rating-label" class="rate-word">Tocá una estrella para puntuar</span>
              </div>

              <label for="anio-cursado">Año en que cursaste</label>
              <div class="field">
                <select id="anio-cursado" required>
                  <option value="">Elegí el año…</option>
                  {Array.from({ length: 10 }, (_, i) => currentYear - i).map((year) => <option value={year}>{year}</option>)}
                </select>
              </div>

              <label for="condicion-final">¿Cómo te fue?<small>Opcional</small></label>
              <div class="field">
                <select id="condicion-final">
                  <option value="">Prefiero no contarlo</option>
                  <option value="PROMOCIONADO">Promocioné (aprobación directa)</option>
                  <option value="REGULAR">Regularicé</option>
                  <option value="LIBRE">Quedé libre</option>
                </select>
              </div>

              <label for="comentario">Tu opinión<small>Contá lo que te hubiera servido saber antes de cursar.</small></label>
              <div class="field">
                <textarea id="comentario" rows="6" maxlength="2000" required placeholder="¿Cómo son las clases? ¿Y los parciales? ¿Los profes explican bien? Cualquier dato sirve."></textarea>
                <span class="help">Hablá de la cursada, con respeto. Las reseñas con insultos se borran.</span>
                <label class="check"><input type="checkbox" id="es-anonima" /> <span id="anonima-hint">Publicarla como anónima (no se muestra tu nombre)</span></label>
              </div>
            </div>
            <div class="fbar">
              <span class="sub">Podés editarla o borrarla cuando quieras desde el curso.</span>
              <button type="submit" id="btn-submit" class="btn primary"><Icon name="pen" /> Publicar reseña</button>
            </div>
          </form>
        </>
      )}
    </div>

    <aside class="side">
      <section class="panel guide">
        <h3>Una buena reseña</h3>
        <div class="in">
          <ul>
            <li class="good">Cuenta cómo son las clases y los parciales.</li>
            <li class="good">Dice qué te sirvió para aprobar.</li>
            <li class="good">Aclara en qué año cursaste.</li>
            <li class="bad">No insulta ni ataca a nadie.</li>
            <li class="bad">No comparte datos personales.</li>
          </ul>
        </div>
      </section>
    </aside>
  </div>

  <script define:vars={{ dictadoIdParam: dictadoInfo ? dictadoIdParam : null, fromParam, supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    // ========== ESTRELLAS ==========
    let selectedRating = 0;
    const labels = ['', 'Muy malo', 'Malo', 'Regular', 'Bueno', 'Excelente'];
    const starBtns = document.querySelectorAll('.star-btn');
    const calInput = document.getElementById('calificacion');
    const ratingLabel = document.getElementById('rating-label');

    function pintarEstrellas(hasta, clase) {
      starBtns.forEach((b) => b.classList.toggle(clase, parseInt(b.dataset.star) <= hasta));
    }

    starBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedRating = parseInt(btn.dataset.star);
        calInput.value = selectedRating;
        ratingLabel.textContent = selectedRating + ' de 5: ' + labels[selectedRating];
        ratingLabel.classList.add('set');
        pintarEstrellas(selectedRating, 'on');
        starBtns.forEach((b) => b.setAttribute('aria-checked', b === btn ? 'true' : 'false'));
      });
      btn.addEventListener('mouseenter', () => pintarEstrellas(parseInt(btn.dataset.star), 'hov'));
      btn.addEventListener('mouseleave', () => pintarEstrellas(0, 'hov'));
    });

    // ========== MATERIA → CURSO ==========
    const materiaSelect = document.getElementById('materia-select');
    const cursoSelect = document.getElementById('curso-select');
    const materiaHidden = document.getElementById('materia-hidden');

    async function loadCursos(materiaId) {
      if (!cursoSelect) return;
      cursoSelect.innerHTML = '<option value="">Cargando cursos…</option>';
      cursoSelect.disabled = true;

      if (!materiaId) {
        cursoSelect.innerHTML = '<option value="">Primero elegí una materia</option>';
        return;
      }

      try {
        const res = await fetch(supabaseUrl + '/rest/v1/dictados?materia_id=eq.' + encodeURIComponent(materiaId) + '&select=id,cursos(identificador,turno)', {
          headers: { apikey: supabaseKey, Authorization: 'Bearer ' + supabaseKey },
        });
        const dictados = await res.json();

        if (!Array.isArray(dictados) || dictados.length === 0) {
          cursoSelect.innerHTML = '<option value="">No hay cursos cargados para esta materia</option>';
          return;
        }

        dictados.sort((a, b) => (a.cursos?.identificador || '').localeCompare(b.cursos?.identificador || '', 'es', { numeric: true }));
        cursoSelect.innerHTML = '<option value="">Elegí un curso…</option>';
        dictados.forEach((d) => {
          const opt = document.createElement('option');
          opt.value = d.id;
          const turno = (d.cursos?.turno || '').toLowerCase();
          opt.textContent = (d.cursos?.identificador || 'Curso') + (turno ? ' · Turno ' + turno : '');
          cursoSelect.appendChild(opt);
        });
        cursoSelect.disabled = false;
      } catch (err) {
        console.error('Error cargando cursos:', err);
        cursoSelect.innerHTML = '<option value="">No se pudieron cargar los cursos</option>';
      }
    }

    if (materiaHidden) loadCursos(materiaHidden.value);
    materiaSelect?.addEventListener('change', () => loadCursos(materiaSelect.value));

    // ========== PUBLICAR ==========
    const form = document.getElementById('review-form');
    const btnSubmit = document.getElementById('btn-submit');
    const msgSuccess = document.getElementById('msg-success');
    const msgError = document.getElementById('msg-error');
    const msgErrorText = document.getElementById('msg-error-text');
    const btnOriginal = btnSubmit ? btnSubmit.innerHTML : '';

    function error(texto) {
      msgErrorText.textContent = texto;
      msgError.classList.remove('hidden');
      msgError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      msgSuccess.classList.add('hidden');
      msgError.classList.add('hidden');

      const dictadoId = dictadoIdParam || cursoSelect?.value;
      const calificacion = parseInt(calInput.value);
      const anio = parseInt(document.getElementById('anio-cursado').value);
      const comentario = document.getElementById('comentario').value.trim();

      if (!dictadoId) return error('Elegí la materia y el curso.');
      if (!calificacion || calificacion < 1) return error('Elegí un puntaje de 1 a 5 estrellas.');
      if (!anio) return error('Elegí el año en que cursaste.');
      if (!comentario) return error('Escribí tu opinión sobre la cursada.');

      btnSubmit.disabled = true;
      btnSubmit.innerHTML = '<span class="spin"></span> Publicando…';
      const condicionFinal = document.getElementById('condicion-final').value || null;

      try {
        const res = await fetch('/api/resenas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dictado_id: parseInt(dictadoId),
            calificacion_general: calificacion,
            anio_cursado: anio,
            comentario,
            es_anonima: document.getElementById('es-anonima')?.checked || false,
            condicion_final: condicionFinal,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error ' + res.status);

        // Volver al curso (o a donde vino) después de publicar
        const destino = fromParam || '/dictado/' + dictadoId;
        msgSuccess.classList.remove('hidden');
        msgSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => { window.location.href = destino; }, 1500);
      } catch (err) {
        console.error('Error enviando reseña:', err);
        error(err.message || 'No se pudo publicar la reseña. Probá de nuevo.');
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = btnOriginal;
      }
    });
  </script>
</Layout>
