---
import Layout from '../../layouts/Layout.astro';
import Stars from '../../components/Stars.astro';
import CursoChips from '../../components/CursoChips.astro';
import ShareButton from '../../components/ShareButton.astro';
import { supabase } from '../../lib/supabase';
import { anioLabel, compararCursos, nota } from '../../lib/format';

const { id } = Astro.params;

// El profesor
const { data: profesor } = await supabase
  .from('profesores')
  .select('id, nombre_completo')
  .eq('id', id)
  .single();

if (!profesor) {
  return Astro.redirect('/404');
}

// Todos los cursos donde da clases, con materia, turno y compañeros
const { data: dictadoProfesores } = await supabase
  .from('dictado_profesores')
  .select(`
    dictados (
      id,
      materia_id,
      materias ( id, nombre, nivel ),
      cursos ( identificador, turno ),
      dictado_profesores (
        profesores ( id, nombre_completo )
      )
    )
  `)
  .eq('profesor_id', id);

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);

// Agrupar cursos por materia
const dictadosPorMateria: Record<number, { materia: any; dictados: any[] }> = {};
(dictadoProfesores || []).forEach((dp: any) => {
  const d = one(dp.dictados);
  const m = one(d?.materias);
  if (!d || !m) return;
  if (!dictadosPorMateria[m.id]) dictadosPorMateria[m.id] = { materia: m, dictados: [] };
  dictadosPorMateria[m.id].dictados.push({ ...d, cursos: one(d.cursos) });
});
Object.values(dictadosPorMateria).forEach((g) => {
  g.dictados.sort((a, b) => compararCursos(a.cursos?.identificador, b.cursos?.identificador));
});
const materiasOrdenadas = Object.values(dictadosPorMateria).sort(
  (a, b) => a.materia.nivel - b.materia.nivel || a.materia.nombre.localeCompare(b.materia.nombre),
);

// Estadísticas de sus cursos
const dictadoIds = materiasOrdenadas.flatMap((g) => g.dictados.map((d) => d.id));
const dictadoStats: Record<number, { promedio: number; count: number }> = {};
if (dictadoIds.length > 0) {
  const { data: stats } = await supabase
    .from('stats_dictados')
    .select('dictado_id, cantidad, promedio')
    .in('dictado_id', dictadoIds);
  (stats || []).forEach((st) => {
    if (st.cantidad > 0) dictadoStats[st.dictado_id] = { promedio: st.promedio, count: st.cantidad };
  });
}

const allStats = Object.values(dictadoStats);
const totalResenas = allStats.reduce((acc, s) => acc + s.count, 0);
const promedioGeneral = totalResenas > 0 ? allStats.reduce((acc, s) => acc + s.promedio * s.count, 0) / totalResenas : 0;

// SEO y datos estructurados
const nombresMaterias = materiasOrdenadas.map((m) => m.materia.nombre).join(', ');
const materiasTexto = nombresMaterias ? ` Materias que dicta: ${nombresMaterias}.` : '';
const seoTitle = `Reseñas de ${profesor.nombre_completo} - UTN FRC`;
const seoDescription = `Leé opiniones, calificaciones y métodos de evaluación del profesor ${profesor.nombre_completo} en la UTN FRC.${materiasTexto} Enterate qué opinan los alumnos de sus clases.`;

const schemaObject: any = {
  '@context': 'https://schema.org/',
  '@type': 'Person',
  name: profesor.nombre_completo,
  jobTitle: 'Profesor',
  worksFor: {
    '@type': 'Organization',
    name: 'UTN FRC',
    sameAs: 'https://frc.utn.edu.ar/',
  },
  description: seoDescription,
};
if (totalResenas > 0) {
  schemaObject.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: promedioGeneral.toFixed(1),
    reviewCount: totalResenas.toString(),
  };
}
const schemaProfesor = JSON.stringify(schemaObject);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  schema={schemaProfesor}
  tab="materias"
  crumbs={[{ label: 'Materias', href: '/' }, { label: 'Profesores' }, { label: profesor.nombre_completo }]}
>
  <div class="layout single">
    <div class="main">
      <div class="topic">
        <div>
          <span class="sub">Profesor o profesora</span>
          <h1>{profesor.nombre_completo}</h1>
          <p>
            Da clases en {materiasOrdenadas.length} materia{materiasOrdenadas.length !== 1 ? 's' : ''} y {dictadoIds.length} curso{dictadoIds.length !== 1 ? 's' : ''}.
            {totalResenas > 0 && <> Sus cursos tienen <b>{nota(promedioGeneral)}</b> de promedio en {totalResenas} reseña{totalResenas !== 1 ? 's' : ''}.</>}
          </p>
        </div>
        <div class="actions" style="text-align:right">
          {totalResenas > 0 && (
            <div>
              <span class="big-score">{nota(promedioGeneral)} <small>de 5</small></span><br />
              <Stars value={promedioGeneral} />
            </div>
          )}
          <ShareButton titulo={`Reseñas de los cursos de ${profesor.nombre_completo} en UTN REP`} />
        </div>
      </div>

      <div class="notice">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5" stroke-linecap="round"/></svg>
        <span>Las reseñas son de cada curso entero, no de una sola persona. Si en un curso hay varios profesores, el promedio es del equipo.</span>
      </div>

      {materiasOrdenadas.length > 0 ? (
        materiasOrdenadas.map(({ materia, dictados }) => (
          <section style="display:grid;gap:6px">
            <div class="toolbar">
              <h2><a class:list={['yr', `y${materia.nivel}`]} href={`/nivel/${materia.nivel}`}>{anioLabel(materia.nivel)}</a> <a href={`/materia/${materia.id}`}>{materia.nombre}</a></h2>
            </div>
            <div class="grid-tbl stack">
              <table>
                <thead>
                  <tr><th>Curso</th><th>Comparte el curso con</th><th class="c">Promedio</th><th class="c">Reseñas</th></tr>
                </thead>
                <tbody>
                  {dictados.map((d: any) => {
                    const st = dictadoStats[d.id];
                    const otros = (d.dictado_profesores || []).map((dp: any) => one(dp.profesores)).filter((p: any) => p && p.id !== profesor.id);
                    return (
                      <tr>
                        <td><a class="curso" href={`/dictado/${d.id}`}>{d.cursos?.identificador || 'Curso'}</a> <CursoChips mini turno={d.cursos?.turno} /></td>
                        <td>{otros.length > 0 ? otros.map((p: any, i: number) => <>{i > 0 && ', '}<a href={`/profesor/${p.id}`}>{p.nombre_completo}</a></>) : <span class="sub">Da el curso solo/a</span>}</td>
                        <td class="c">{st ? <><Stars value={st.promedio} /><div class="score">{nota(st.promedio)}</div></> : <span class="sub">Sin puntaje</span>}</td>
                        <td class="c num">{st?.count || 0}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <div class="cards-sm">
                {dictados.map((d: any) => {
                  const st = dictadoStats[d.id];
                  return (
                    <div class="ccard">
                      <div class="top"><a class="curso stretch" href={`/dictado/${d.id}`}>{d.cursos?.identificador || 'Curso'}</a> <CursoChips mini turno={d.cursos?.turno} /></div>
                      <span>{st ? <><Stars value={st.promedio} /> <b>{nota(st.promedio)}</b> <span class="sub">· {st.count} reseña{st.count !== 1 ? 's' : ''}</span></> : <span class="sub">Sin reseñas todavía</span>}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>
        ))
      ) : (
        <div class="empty">
          <h2>Sin cursos asignados</h2>
          <span>Este profesor no tiene cursos cargados por ahora.</span>
        </div>
      )}
    </div>
  </div>
</Layout>
