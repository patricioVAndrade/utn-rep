---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import CursoChips from '../../components/CursoChips.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { supabase } from '../../lib/supabase';
import { anioLabel, compararCursos, nota } from '../../lib/format';

const { id } = Astro.params;

// Datos de la materia
const { data: materia } = await supabase
  .from('materias')
  .select('*')
  .eq('id', id)
  .single();

if (!materia) {
  return Astro.redirect('/404');
}

// Cursos con turno y profesores
const { data: dictados } = await supabase
  .from('dictados')
  .select(`
    id,
    es_contracuatrimestral,
    periodo_dictado,
    es_intensivo,
    cursos ( identificador, turno ),
    dictado_profesores (
      profesores ( id, nombre_completo )
    )
  `)
  .eq('materia_id', id);

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);

const dictadosOrdenados = (dictados || [])
  .map((d: any) => ({ ...d, cursos: one(d.cursos) }))
  .sort((a: any, b: any) => compararCursos(a.cursos?.identificador, b.cursos?.identificador));

// Estadísticas reales
const dictadoIds = dictadosOrdenados.map((d: any) => d.id);
let resenas: any[] = [];
let promedioGeneral = 0;
let totalResenas = 0;
const distribucion = [0, 0, 0, 0, 0];
const dictadoStats: Record<number, { promedio: number; count: number }> = {};

if (dictadoIds.length > 0) {
  const [{ data: statsData }, { data: resenasData }, { data: notas }] = await Promise.all([
    supabase.from('stats_dictados').select('dictado_id, cantidad, promedio').in('dictado_id', dictadoIds),
    supabase
      .from('resenas_publicas')
      .select('*')
      .in('dictado_id', dictadoIds)
      .order('created_at', { ascending: false })
      .limit(6),
    supabase.from('resenas_publicas').select('calificacion_general').in('dictado_id', dictadoIds).limit(5000),
  ]);

  resenas = resenasData || [];
  const stats = statsData || [];
  totalResenas = stats.reduce((acc, st) => acc + st.cantidad, 0);
  if (totalResenas > 0) {
    promedioGeneral = stats.reduce((acc, st) => acc + st.promedio * st.cantidad, 0) / totalResenas;
  }
  stats.forEach((st) => {
    if (st.cantidad > 0) dictadoStats[st.dictado_id] = { promedio: st.promedio, count: st.cantidad };
  });
  (notas || []).forEach((r) => {
    const i = Math.min(Math.max(Math.round(r.calificacion_general) - 1, 0), 4);
    distribucion[i]++;
  });
}
const totalDist = distribucion.reduce((a, b) => a + b, 0);

// Datos rápidos
const conResenas = dictadosOrdenados.filter((d: any) => dictadoStats[d.id]);
const mejor = conResenas
  .filter((d: any) => dictadoStats[d.id].count >= 2)
  .sort((a: any, b: any) => dictadoStats[b.id].promedio - dictadoStats[a.id].promedio)[0];
const masResenas = [...conResenas].sort((a: any, b: any) => dictadoStats[b.id].count - dictadoStats[a.id].count)[0];

const nivel = materia.nivel || 1;
const label = anioLabel(nivel).replace(/^./, (c) => c.toUpperCase());
const cursoDe = (dictadoId: number) => dictadosOrdenados.find((d: any) => d.id === dictadoId)?.cursos?.identificador || 'Curso';

// SEO y datos estructurados
const seoTitle = `Reseñas de ${materia.nombre} - UTN FRC`;
const seoDescription = `Leé opiniones, calificaciones y recomendaciones para cursar ${materia.nombre} en Ingeniería en Sistemas de la UTN FRC. Enterate qué profesores son los mejores y cómo son los finales.`;

const schemaObject: any = {
  '@context': 'https://schema.org/',
  '@type': 'Course',
  name: `${materia.nombre} - UTN FRC`,
  description: seoDescription,
  provider: {
    '@type': 'Organization',
    name: 'UTN FRC',
    sameAs: 'https://frc.utn.edu.ar/',
  },
};
if (totalResenas > 0) {
  schemaObject.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: promedioGeneral.toFixed(1),
    reviewCount: totalResenas.toString(),
  };
}
const schemaMateria = JSON.stringify(schemaObject);
const escribir = `/nueva-resena?materia=${id}&from=/materia/${id}`;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  schema={schemaMateria}
  tab="materias"
  crumbs={[{ label: 'Materias', href: '/' }, { label, href: `/nivel/${nivel}` }, { label: materia.nombre }]}
>
  <div class="layout single">
    <div class="main">
      <div class="topic">
        <div>
          <div class="chips">
            <a class:list={['yr', `y${nivel}`]} href={`/nivel/${nivel}`}>{label}</a>
            {materia.es_electiva && <span class="chip elec">Electiva ({materia.puntos_electiva || 0} pts)</span>}
          </div>
          <h1 style="margin-top:6px">{materia.nombre}</h1>
          <p>{dictadosOrdenados.length} curso{dictadosOrdenados.length !== 1 ? 's' : ''} · {totalResenas} reseña{totalResenas !== 1 ? 's' : ''}</p>
        </div>
        <div class="actions">
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir una reseña</a>
        </div>
      </div>

      {totalResenas > 0 && (
        <div class="summary">
          <div>
            <span class="sub">Promedio de la materia</span>
            <span class="big-score">{nota(promedioGeneral)} <small>de 5</small></span>
            <Stars value={promedioGeneral} />
            <span class="sub">{totalResenas} reseña{totalResenas !== 1 ? 's' : ''}</span>
          </div>
          <div>
            <span class="sub">Cómo la puntuaron</span>
            <div class="bars dist">
              {[5, 4, 3, 2, 1].map((n) => (
                <div><span>{n} ★</span><i><b style={`width:${totalDist ? Math.round((distribucion[n - 1] / totalDist) * 100) : 0}%`}></b></i><span class="n">{distribucion[n - 1]}</span></div>
              ))}
            </div>
          </div>
          <div>
            <span class="sub">Datos rápidos</span>
            <div class="facts">
              {mejor && <div><span>Mejor puntuado</span><a href={`/dictado/${mejor.id}`}><b>{mejor.cursos?.identificador}</b> ({nota(dictadoStats[mejor.id].promedio)})</a></div>}
              {masResenas && <div><span>Más reseñado</span><a href={`/dictado/${masResenas.id}`}><b>{masResenas.cursos?.identificador}</b> ({dictadoStats[masResenas.id].count})</a></div>}
              <div><span>Cursos con reseñas</span><b>{conResenas.length} de {dictadosOrdenados.length}</b></div>
            </div>
          </div>
        </div>
      )}

      <div class="toolbar"><h2>Cursos</h2><span class="sub">Tocá un curso para leer sus reseñas.</span></div>

      {dictadosOrdenados.length > 0 ? (
        <div class="grid-tbl stack">
          <table>
            <thead>
              <tr><th>Curso</th><th>Equipo docente</th><th class="c">Promedio</th><th class="c">Reseñas</th><th></th></tr>
            </thead>
            <tbody>
              {dictadosOrdenados.map((d: any) => {
                const st = dictadoStats[d.id];
                const profes = (d.dictado_profesores || []).map((dp: any) => one(dp.profesores)).filter(Boolean);
                return (
                  <tr>
                    <td>
                      <a class="curso" href={`/dictado/${d.id}`}>{d.cursos?.identificador || 'Curso'}</a>
                      <CursoChips mini turno={d.cursos?.turno} periodo={d.periodo_dictado} contra={d.es_contracuatrimestral} intensivo={d.es_intensivo} />
                    </td>
                    <td>
                      {profes.length > 0
                        ? <ul class="profes">{profes.map((p: any) => <li><a href={`/profesor/${p.id}`}>{p.nombre_completo}</a></li>)}</ul>
                        : <span class="sub">Sin profesores cargados</span>}
                    </td>
                    <td class="c">{st ? <><Stars value={st.promedio} /><div class="score">{nota(st.promedio)}</div></> : <span class="sub">Sin puntaje</span>}</td>
                    <td class="c num">{st?.count || 0}</td>
                    <td><a href={`/dictado/${d.id}`}>{st ? 'Ver reseñas' : 'Escribí la primera'}</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <div class="cards-sm">
            {dictadosOrdenados.map((d: any) => {
              const st = dictadoStats[d.id];
              const profes = (d.dictado_profesores || []).map((dp: any) => one(dp.profesores)?.nombre_completo).filter(Boolean);
              return (
                <div class="ccard">
                  <div class="top">
                    <a class="curso stretch" href={`/dictado/${d.id}`}>{d.cursos?.identificador || 'Curso'}</a>
                    <CursoChips mini turno={d.cursos?.turno} periodo={d.periodo_dictado} contra={d.es_contracuatrimestral} intensivo={d.es_intensivo} />
                  </div>
                  <span class="sub">{profes.length ? profes.join(', ') : 'Sin profesores cargados'}</span>
                  <span>{st ? <><Stars value={st.promedio} /> <b>{nota(st.promedio)}</b> <span class="sub">· {st.count} reseña{st.count !== 1 ? 's' : ''}</span></> : <span class="sub">Sin reseñas todavía</span>}</span>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="empty">
          <h3>No hay cursos cargados</h3>
          <span>Todavía no se registraron cursos para esta materia.</span>
        </div>
      )}

      <div class="toolbar"><h2>Opiniones recientes</h2></div>
      {resenas.length > 0 ? (
        resenas.map((r: any) => (
          <ReviewCard resena={r} compact curso={{ label: `${materia.nombre}, ${cursoDe(r.dictado_id)}`, href: `/dictado/${r.dictado_id}#resena-${r.id}` }} />
        ))
      ) : (
        <div class="empty">
          <h3>Todavía no hay opiniones</h3>
          <span>Sé la primera persona en contar cómo es cursar esta materia.</span>
          <a class="btn primary" href={escribir}><Icon name="pen" /> Escribir la primera reseña</a>
        </div>
      )}
    </div>
  </div>
</Layout>
