---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Preguntas plegables por tema, como en la V6. Las más consultadas vienen abiertas.
// La parte de rangos y logros se suma cuando estén (etapa 3).
const grupos: { titulo: string; preguntas: { p: string; r: string; abierta?: boolean }[] }[] = [
  {
    titulo: 'Lo básico',
    preguntas: [
      { p: '¿Qué diferencia hay entre materia y curso?', abierta: true, r: 'La <b>materia</b> es la cátedra, por ejemplo Algoritmos y Estructuras de Datos. Adentro hay <b>cursos</b> como 1K3 o 1K11, cada uno con su turno y su equipo docente. Las reseñas son de un curso, porque cursar AED a la mañana con un equipo no es lo mismo que a la noche con otro.' },
      { p: '¿Es un sitio oficial de la UTN?', r: 'No. Lo hace un estudiante y lo usan estudiantes de Ingeniería en Sistemas de la UTN Facultad Regional Córdoba. La facultad no participa ni revisa las reseñas, y los puntajes no son una evaluación oficial.' },
      { p: '¿Quién puede escribir?', r: 'Cualquiera que ingrese con Google, GitHub o su mail. Se puede escribir una reseña por curso, y la podés editar o borrar cuando quieras desde Mis reseñas.' },
      { p: '¿De dónde sale la nota de un profesor?', r: 'Es el promedio de las reseñas de los cursos en los que da clases. Cada reseña califica la cursada entera, con todo el equipo, así que conviene mirar también la nota de cada curso.' },
    ],
  },
  {
    titulo: 'Reseñas',
    preguntas: [
      { p: '¿Puedo ser anónimo?', abierta: true, r: 'Sí. Marcás "Publicar como anónimo" y tu nombre no aparece en ningún lado. Solo la moderación puede verlo si la reseña es reportada.' },
      { p: '¿Qué pasa si reportan mi reseña?', r: 'Sigue visible mientras la revisamos y en Mis reseñas vas a ver que está en revisión. Si rompe una regla, te avisamos por mail; en el peor caso, se oculta.' },
      { p: '¿Qué no se puede escribir?', r: 'Insultos, datos personales de profesores o compañeros, y cosas que no pasaron. Las críticas duras están bien si son sobre la cursada.' },
      { p: '¿Qué significa "Me sirvió"?', r: 'Es un voto para las reseñas que te ayudaron a elegir. Las más votadas aparecen primero en cada curso.' },
    ],
  },
  {
    titulo: 'Experiencias de finales',
    preguntas: [
      { p: '¿Para qué sirven?', r: 'Para saber cómo toman en cada mesa: si es escrito, oral o en máquina, cuánto dura, qué temas entran y cómo corrigen. Las cuenta quien ya rindió.' },
      { p: '¿Se ve quién la contó?', r: 'Solo si al compartirla marcás "Publicar con mi nombre". Si no, sale como anónima y tu nombre no se muestra; solo la moderación puede verlo.' },
    ],
  },
  {
    titulo: 'Tus datos',
    preguntas: [
      { p: '¿Qué guardan de mí?', r: 'Tu nombre, tu mail y tu foto si entrás con Google o GitHub. El detalle completo está en <a href="/terminos">Términos y condiciones</a>.' },
      { p: '¿Qué se guarda solo en mi navegador?', r: 'El modo noche, tu última visita (para marcar lo nuevo), los años que elegiste en Mi cuenta y los borradores que dejaste a medio escribir. No sale de tu navegador.' },
    ],
  },
];
---

<Layout
  title="¿Cómo funciona? - UTN REP"
  description="Qué es UTN REP, cómo funcionan las reseñas de cursos y qué datos se guardan."
  tab="ayuda"
  crumbs={[{ label: '¿Cómo funciona?' }]}
>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>¿Cómo funciona UTN REP?</h1>
          <p>Reseñas de cursos de Ingeniería en Sistemas de la UTN Córdoba, escritas por estudiantes.</p>
        </div>
      </div>

      {grupos.map((g) => (
        <section class="faq-group">
          <h2>{g.titulo}</h2>
          {g.preguntas.map((q) => (
            <details class="faq" open={q.abierta}>
              <summary>{q.p}</summary>
              <div set:html={q.r} />
            </details>
          ))}
        </section>
      ))}
    </div>

    <aside class="side">
      <section class="panel">
        <h3>¿Ya usabas UTN REP?</h3>
        <div class="in">
          <span>Renovamos el diseño. Si buscás algo que estaba antes, te decimos dónde quedó.</span>
          <a href="/que-cambio">Qué cambió</a>
          <button type="button" class="btn quiet" data-ver-recorrido>Ver el recorrido de 30 segundos</button>
        </div>
      </section>
      <section class="panel">
        <h3>Empezá por acá</h3>
        <div class="in">
          <ol class="steps">
            <li>Buscá tu materia.</li>
            <li>Elegí el curso.</li>
            <li>Leé y votá lo que te sirvió.</li>
          </ol>
          <a class="btn primary" href="/nueva-resena"><Icon name="pen" /> Escribir una reseña</a>
        </div>
      </section>
      <section class="panel">
        <h3>¿No encontraste tu respuesta?</h3>
        <div class="in">
          <a href="mailto:patriciovandrade@gmail.com?subject=Consulta%20sobre%20UTN%20REP">Escribinos</a>
          <span class="sub">Lo hizo Patricio Valentín Andrade, estudiante de Sistemas en la UTN FRC. <a href="https://github.com/patricioVAndrade" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        </div>
      </section>
    </aside>
  </div>
</Layout>
