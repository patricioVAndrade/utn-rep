---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Página no encontrada - UTN REP" crumbs={[{ label: 'Página no encontrada' }]}>
  <div class="layout single">
    <div class="main">
      <div class="empty">
        <h1 style="margin:0;font:bold 20px var(--f-title)">Esta página no existe</h1>
        <span>Puede que el link esté mal escrito o que la página se haya movido. Probá con el buscador de arriba o volvé al inicio.</span>
        <a class="btn primary" href="/"><Icon name="book" /> Ver todas las materias</a>
      </div>
    </div>
  </div>
</Layout>
