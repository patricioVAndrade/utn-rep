---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import Quien from '../components/Quien.astro';
import { autoresDeResenas } from '../lib/fichas';
import { supabase, createSupabaseServerClient } from '../lib/supabase';
import { leerPerfil, preguntarComoTeFue } from '../lib/perfil';
import { COMO_TE_FUE, anioLabel, nota, tiempoRelativo } from '../lib/format';

// Materias, estadísticas por curso y las reseñas más recientes (solo lo que muestra el índice)
const [
  { data: materiasRaw },
  { data: statsRaw },
  { data: recientesRaw },
  { count: totalResenas },
  { count: totalFinales },
] = await Promise.all([
  supabase.from('materias').select('id, nombre, nivel, es_electiva, puntos_electiva').order('nivel').order('nombre'),
  supabase.from('stats_dictados').select('dictado_id, materia_id, cantidad, promedio'),
  supabase
    .from('resenas_publicas')
    .select('id, dictado_id, created_at, nombre_usuario, es_anonima, calificacion_general')
    .order('created_at', { ascending: false })
    .limit(1000),
  supabase.from('resenas_publicas').select('id', { count: 'exact', head: true }),
  supabase.from('experiencias_finales_publicas').select('id', { count: 'exact', head: true }),
]);

const user = Astro.locals.user;

// "¿Cómo te fue?" (F38): tus reseñas sin ese dato, de cursadas de años anteriores
// o publicadas hace más de 4 meses (las de este año todavía pueden no haber terminado)
type Pregunta = { id: number; materia: string; curso: string; anio: number };
let preguntas: Pregunta[] = [];
let misAnios: number[] | null = null;
if (user) {
  const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const perfil = await leerPerfil(client, user.id);
  if (perfil.guardado) misAnios = perfil.anios_cursada;
  const { data } = !preguntarComoTeFue(perfil) ? { data: [] } : await client
    .from('resenas')
    .select('id, anio_cursado, created_at, dictados ( cursos ( identificador ), materias ( nombre ) )')
    .eq('user_id', user.id)
    .is('condicion_final', null)
    .order('created_at', { ascending: false })
    .limit(30);
  const hace4Meses = Date.now() - 120 * 24 * 60 * 60 * 1000;
  const esteAnio = new Date().getFullYear();
  const uno = (x: any) => (Array.isArray(x) ? x[0] : x) || null;
  preguntas = (data || [])
    .filter((r: any) => (r.anio_cursado && r.anio_cursado < esteAnio) || new Date(r.created_at).getTime() < hace4Meses)
    .slice(0, 5)
    .map((r: any) => {
      const d = uno(r.dictados);
      return { id: r.id, materia: uno(d?.materias)?.nombre || 'una materia', curso: uno(d?.cursos)?.identificador || '', anio: r.anio_cursado };
    });
}
const materias = materiasRaw || [];
const stats = statsRaw || [];
const recientes = recientesRaw || [];

// Promedio ponderado y cantidad de cursos por materia
type Agg = { promedio: number; count: number; cursos: number };
const porMateria: Record<number, Agg> = {};
const materiaDeDictado = new Map<number, number>();
stats.forEach((st) => {
  materiaDeDictado.set(st.dictado_id, st.materia_id);
  const acc = porMateria[st.materia_id] ?? { promedio: 0, count: 0, cursos: 0 };
  acc.cursos += 1;
  if (st.cantidad > 0) {
    acc.promedio = (acc.promedio * acc.count + st.promedio * st.cantidad) / (acc.count + st.cantidad);
    acc.count += st.cantidad;
  }
  porMateria[st.materia_id] = acc;
});

// Última reseña de cada materia (vienen ordenadas de la más nueva a la más vieja)
const ultima: Record<number, (typeof recientes)[number]> = {};
recientes.forEach((r) => {
  const mid = materiaDeDictado.get(r.dictado_id);
  if (mid && !ultima[mid]) ultima[mid] = r;
});

const NUEVA_MS = 14 * 24 * 60 * 60 * 1000;
const ahora = Date.now();
const esNueva = (fecha?: string | null) => !!fecha && ahora - new Date(fecha).getTime() < NUEVA_MS;

const anios = [1, 2, 3, 4, 5].map((n) => {
  const lista = materias.filter((m) => m.nivel === n);
  const resenas = lista.reduce((acc, m) => acc + (porMateria[m.id]?.count || 0), 0);
  return { n, lista, resenas };
});
const maxResenasAnio = Math.max(1, ...anios.map((a) => a.resenas));
const anioFlojo = anios.filter((a) => a.lista.length > 0).sort((a, b) => a.resenas - b.resenas)[0];
const cursosConResenas = stats.filter((st) => st.cantidad > 0).length;
const nuevasSemana = recientes.filter((r) => ahora - new Date(r.created_at).getTime() < 7 * 24 * 60 * 60 * 1000).length;

// Las 5 últimas reseñas, con materia y curso
const feed = recientes.slice(0, 5);
let cursoDeDictado = new Map<number, string>();
if (feed.length > 0) {
  const { data } = await supabase
    .from('dictados')
    .select('id, cursos ( identificador )')
    .in('id', feed.map((r) => r.dictado_id));
  cursoDeDictado = new Map((data || []).map((d: any) => [d.id, (Array.isArray(d.cursos) ? d.cursos[0] : d.cursos)?.identificador || '']));
}
const nombreMateria = new Map(materias.map((m) => [m.id, m.nombre]));

// Reseña destacada: la más votada de todas. Si otra la pasa, ocupa su lugar;
// con empate se queda la que llegó primero. Aparece desde los 3 votos.
const { data: destRaw } = await supabase
  .from('resenas_publicas')
  .select('id, dictado_id, comentario, calificacion_general, votos_utilidad, nombre_usuario, es_anonima, created_at, dictados ( cursos ( identificador ), materias ( nombre ) )')
  .gte('votos_utilidad', 3)
  .order('votos_utilidad', { ascending: false })
  .order('created_at', { ascending: true })
  .limit(1);
const destacada = (destRaw || [])[0] as any;
const destDictado = destacada ? (Array.isArray(destacada.dictados) ? destacada.dictados[0] : destacada.dictados) : null;
const destCurso = destDictado ? (Array.isArray(destDictado.cursos) ? destDictado.cursos[0] : destDictado.cursos)?.identificador : '';
const destMateria = destDictado ? (Array.isArray(destDictado.materias) ? destDictado.materias[0] : destDictado.materias)?.nombre : '';
const recortar = (t: string, n = 180) => (t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t);
const autor = (r: { es_anonima: boolean; nombre_usuario: string | null }) => (r.es_anonima ? 'Anónimo' : r.nombre_usuario || 'Estudiante');
// Fichas de quienes aparecen en "Última reseña" y en la destacada
const autores = await autoresDeResenas([...Object.values(ultima).map((r) => r.id), ...(destacada ? [destacada.id] : [])]);
const fmt = (n: number | null | undefined) => (n || 0).toLocaleString('es-AR');
---

<Layout
  title="UTN REP — Reseñas de materias y profesores | UTN FRC Sistemas"
  description="Reseñas reales de materias, cátedras y profesores de Ingeniería en Sistemas de Información — UTN Facultad Regional Córdoba. Elegí mejor tu cursada."
  tab="materias"
  forumClass="home"
  crumbs={[{ label: 'Materias' }]}
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="folder" viewBox="0 0 24 20"><path d="M1 3.5C1 2.7 1.7 2 2.5 2h6l2 2.5h11c.8 0 1.5.7 1.5 1.5v11.5c0 .8-.7 1.5-1.5 1.5h-19C1.7 19 1 18.3 1 17.5z" fill="currentColor" stroke="rgba(0,0,0,.35)"/><path d="M1.5 7h21" stroke="rgba(255,255,255,.5)"/></symbol>
  </svg>

  <div class="layout">
    <div class="main">
      <h1 class="sr">Materias de Ingeniería en Sistemas, UTN FRC</h1>
      <div class="jump">
        <span>Ir a:</span>
        {anios.map((a) => <a class:list={['yj', `y${a.n}`]} href={`#anio-${a.n}`}>{a.n}.º año</a>)}
        {materias.some((m) => m.es_electiva) && <button type="button" class="yj" id="solo-electivas" aria-pressed="false">Electivas</button>}
      </div>
      {Astro.url.searchParams.has('cuenta_borrada') && !user && (
        <div class="notice ok" role="status"><Icon name="check" /><div><b>Tu cuenta se borró.</b> Gracias por haber sumado a UTN REP.</div></div>
      )}
      {user && (
        <p class="sub yr-hint hidden" id="anios-hint" data-mis-anios={misAnios ? JSON.stringify(misAnios.map(String)) : undefined}>
          ¿Querés que tus años vengan abiertos? Elegilos en <a href="/mi-cuenta#tus-anios">Mi cuenta</a>.
        </p>
      )}
      {preguntas.length > 0 && (
        <section class="comofue hidden" id="comofue" aria-label="¿Cómo te fue?">
          {preguntas.map((p, i) => (
            <div class:list={['cf-item', { hidden: i > 0 }]} data-resena={p.id}>
              <div class="q">
                ¿Cómo te fue en <b>{p.materia}{p.curso ? `, ${p.curso}` : ''}</b>?
                <span class="sub"> Lo sumamos a tu reseña{p.anio ? ` de ${p.anio}` : ''}; le sirve a quien la cursa después.</span>
              </div>
              <div class="opts">
                {COMO_TE_FUE.map((c) => <button type="button" class="btn quiet" data-cond={c.valor}>{c.texto}</button>)}
              </div>
              <div class="later">
                <button type="button" class="linklike" data-ahora-no>Ahora no</button>
                <button type="button" class="linklike" data-nunca>No preguntar más</button>
              </div>
            </div>
          ))}
          <span class="cf-gracias hidden" role="status">¡Gracias! Ya quedó en tus reseñas.</span>
        </section>
      )}

      <div class="tbl" role="table" aria-label="Materias por año">
        <div class="thead" role="row">
          <span></span><span>Materia</span><span class="c">Promedio</span><span class="c">Reseñas</span><span>Última reseña</span>
        </div>
        {anios.filter((a) => a.lista.length > 0).map((a) => (
          <details class="year" id={`anio-${a.n}`}>
            <summary class:list={['cat yc', `y${a.n}`]}>
              <span class="cat-name"><span class="ydot">{a.n}.º</span>{anioLabel(a.n).replace(/^./, (c) => c.toUpperCase())}</span>
              <small><b class="hay-nuevas hidden"><svg class="folder new" aria-hidden="true"><use href="#folder" /></svg> <span class="hide-sm">Hay reseñas nuevas</span><span class="only-sm-inline">Nuevas</span></b>{a.lista.length} materias · <a href={`/nivel/${a.n}`}>Ver el año</a></small>
            </summary>
            {a.lista.map((m) => {
              const st = porMateria[m.id];
              const ult = ultima[m.id];
              const nueva = esNueva(ult?.created_at);
              return st && st.count > 0 ? (
                <div class="row" role="row" data-ultima={ult?.created_at} data-electiva={m.es_electiva ? '1' : undefined}>
                  <svg class:list={['folder', nueva ? 'new' : 'old']} role="img" aria-label={nueva ? 'Tiene reseñas nuevas' : 'Sin reseñas nuevas'}><use href="#folder" /></svg>
                  <div>
                    <a class="name" href={`/materia/${m.id}`}>{m.nombre}</a>
                    <div class="sub">
                      {m.es_electiva && <span class="tag-elec">Electiva</span>}{' '}
                      {st.cursos} curso{st.cursos !== 1 ? 's' : ''}<span class="only-sm-inline">, {st.count} reseña{st.count !== 1 ? 's' : ''}</span><b class:list={['nuevas', { hidden: !nueva }]}>, hay nuevas</b>
                    </div>
                  </div>
                  <div class="c"><Stars value={st.promedio} /><div class="score">{nota(st.promedio)} de 5</div></div>
                  <div class="c num hide-sm">{st.count}<div class="score">reseñas</div></div>
                  <div class="last hide-sm">
                    {ult ? <>{tiempoRelativo(ult.created_at)}<br />por <Quien nombre={autor(ult)} anonimo={ult.es_anonima} ficha={autores.get(ult.id)?.ficha} /></> : '—'}
                  </div>
                </div>
              ) : (
                <div class="row" role="row" data-electiva={m.es_electiva ? '1' : undefined}>
                  <svg class="folder old" role="img" aria-label="Sin reseñas"><use href="#folder" /></svg>
                  <div>
                    <a class="name" href={`/materia/${m.id}`}>{m.nombre}</a>
                    <div class="sub">
                      {m.es_electiva && <span class="tag-elec">Electiva</span>}{' '}
                      Todavía nadie la reseñó.
                    </div>
                  </div>
                  <div class="c sub hide-sm">Sin puntaje</div>
                  <div class="c num hide-sm">0</div>
                  <div class="last hide-sm"><a href={`/nueva-resena?materia=${m.id}&from=/materia/${m.id}`}>Escribí la primera reseña</a></div>
                </div>
              );
            })}
          </details>
        ))}
      </div>

      <div class="legend">
        <span><svg class="folder new" aria-hidden="true"><use href="#folder" /></svg> <span id="leyenda-nuevas">Tiene reseñas de las últimas dos semanas</span></span>
        <span><svg class="folder old" aria-hidden="true"><use href="#folder" /></svg> Sin reseñas nuevas</span>
        <button type="button" class="linklike" id="marcar-leido">Marcar todo como leído</button>
      </div>
    </div>

    <aside class="side" aria-label="Columna lateral">
      <section class="panel cta">
        <h3>¿Ya cursaste alguna materia?</h3>
        <div class="in">
          <span>Contá cómo te fue y ayudá a otros a elegir curso.</span>
          <a class="btn primary big" href="/nueva-resena"><Icon name="pen" /> Escribir una reseña</a>
        </div>
      </section>

      <section class="panel">
        <h3>Así viene el cuatri</h3>
        <div class="in">
          <div class="kpis">
            <div><b>{fmt(totalResenas)}</b><span>reseñas</span></div>
            <div><b>+{fmt(nuevasSemana)}</b><span>esta semana</span></div>
            <div><b>{fmt(totalFinales)}</b><span>experiencias de finales</span></div>
            <div><b>{fmt(cursosConResenas)}</b><span>cursos reseñados</span></div>
          </div>
          <div class="sub">Reseñas por año de la carrera</div>
          <div class="bars">
            {anios.map((a) => (
              <div><span>{a.n}.º año</span><i><b style={`width:${Math.round((a.resenas / maxResenasAnio) * 100)}%`}></b></i><span class="n">{fmt(a.resenas)}</span></div>
            ))}
          </div>
          {anioFlojo && (
            <div class="sub">A {anioFlojo.n}.º año le faltan reseñas. <a href={`/nivel/${anioFlojo.n}`}>¿Cursaste alguna?</a></div>
          )}
        </div>
      </section>

      {destacada && (
        <section class="panel destacada">
          <h3><Icon name="thumb" /> Reseña destacada</h3>
          <div class="in">
            <a href={`/dictado/${destacada.dictado_id}#resena-${destacada.id}`}><b>{destMateria}{destCurso ? `, ${destCurso}` : ''}</b></a>
            <span class="sub"><Stars value={destacada.calificacion_general} /> por <Quien nombre={autor(destacada)} anonimo={destacada.es_anonima} ficha={autores.get(destacada.id)?.ficha} /></span>
            <blockquote class="quote-mini">"{recortar(destacada.comentario || '')}"</blockquote>
            <span class="sub">Le sirvió a <b>{destacada.votos_utilidad} personas</b>. Es la más votada del sitio: si otra la supera, toma su lugar.</span>
          </div>
        </section>
      )}

      {feed.length > 0 && (
        <section class="panel">
          <h3>Últimas reseñas</h3>
          <div class="in feed">
            {feed.map((r) => {
              const mid = materiaDeDictado.get(r.dictado_id);
              return (
                <div>
                  <a href={`/dictado/${r.dictado_id}`}>{nombreMateria.get(mid || 0) || 'Materia'}{cursoDeDictado.get(r.dictado_id) ? `, ${cursoDeDictado.get(r.dictado_id)}` : ''}</a>
                  <span class="sub"><Stars value={r.calificacion_general} /> {tiempoRelativo(r.created_at).toLowerCase()}</span>
                </div>
              );
            })}
            <a href="/recientes">Ver todas las reseñas recientes</a>
          </div>
        </section>
      )}

      <section class="panel">
        <h3>Experiencias de finales</h3>
        <div class="in">
          <span>¿Vas a rendir? Fijate cómo toman en cada mesa. ¿Ya rendiste? Contalo.</span>
          <a class="btn secondary" href="/finales"><Icon name="final" /> Ver los finales</a>
        </div>
      </section>

      <section class="panel">
        <h3>¿Primera vez acá?</h3>
        <div class="in">
          <ol class="steps">
            <li>Buscá tu materia o elegí el año.</li>
            <li>Entrá al curso que te interesa (por ejemplo 1K3).</li>
            <li>Leé las reseñas y votá las que te sirvieron.</li>
          </ol>
          <a href="/sobre">¿Cómo funciona UTN REP?</a>
        </div>
      </section>

      <section class="panel cafe">
        <h3>Bancá UTN REP</h3>
        <div class="in">
          <span>Es gratis y sin publicidad. Si te ayudó a elegir curso, ayudá a mantenerlo online.</span>
          <a class="btn cafe big" href="https://cafecito.app/utnrep" target="_blank" rel="noopener noreferrer"><Icon name="cup" /> Invitame un cafecito</a>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  import { visitaAnterior, marcarLeido } from '../scripts/visitas';
  import { apagarFranja, franjaApagada, responderComoTeFue } from '../scripts/como-te-fue';

  // "¿Cómo te fue?": de a una reseña por vez; "Ahora no" la esconde 30 días
  const cf = document.getElementById('comofue');
  if (cf && !franjaApagada()) {
    cf.classList.remove('hidden');
    cf.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.hasAttribute('data-ahora-no') || b.hasAttribute('data-nunca')) {
        const nunca = b.hasAttribute('data-nunca');
        apagarFranja(nunca);
        cf.classList.add('hidden');
        fetch('/api/perfil', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(nunca ? { preguntar_como_te_fue: false } : { pausar_como_te_fue: true }) }).catch(() => null);
        return;
      }
      const item = b.closest<HTMLElement>('.cf-item');
      if (!item || !b.dataset.cond) return;
      const botones = Array.from(item.querySelectorAll('button'));
      botones.forEach((x) => (x.disabled = true));
      try {
        await responderComoTeFue(item.dataset.resena || '', b.dataset.cond);
        item.remove();
        const sig = cf.querySelector('.cf-item');
        if (sig) sig.classList.remove('hidden');
        else {
          cf.querySelector('.cf-gracias')?.classList.remove('hidden');
          setTimeout(() => cf.classList.add('hidden'), 4000);
        }
      } catch (err) {
        alert(err instanceof Error ? err.message : 'No se pudo guardar.');
        botones.forEach((x) => (x.disabled = false));
      }
    });
  }

  // Carpetas: "nuevas" = reseñas desde tu última visita (la primera vez, las de las últimas dos semanas)
  const anterior = visitaAnterior();
  if (anterior) {
    document.querySelectorAll<HTMLElement>('.row[data-ultima]').forEach((row) => {
      const nueva = new Date(row.dataset.ultima || 0).getTime() > anterior;
      const folder = row.querySelector('.folder');
      folder?.classList.toggle('new', nueva);
      folder?.classList.toggle('old', !nueva);
      folder?.setAttribute('aria-label', nueva ? 'Tiene reseñas nuevas desde tu última visita' : 'Sin reseñas nuevas');
      row.querySelector('.nuevas')?.classList.toggle('hidden', !nueva);
    });
    const leyenda = document.getElementById('leyenda-nuevas');
    if (leyenda) leyenda.textContent = 'Tiene reseñas nuevas desde tu última visita';
  }

  // Años: con sesión, vienen abiertos los que elegiste en Mi cuenta; si no elegiste
  // ninguno (o no iniciaste sesión), solo 1.º. Los demás, cerrados.
  const anios = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.year'));
  const conSesion = !!document.getElementById('anios-hint');
  let mios: string[] = [];
  if (conSesion) {
    // Los de tu cuenta mandan; este navegador guarda una copia
    const deCuenta = document.getElementById('anios-hint')?.dataset.misAnios;
    if (deCuenta) { try { localStorage.setItem('misAnios', deCuenta); } catch {} }
    try { mios = (JSON.parse(deCuenta || localStorage.getItem('misAnios') || '[]') as unknown[]).map(String); } catch {}
    if (!mios.length) document.getElementById('anios-hint')?.classList.remove('hidden');
  }
  const abiertos = new Set(mios.length ? mios : ['1']);
  anios.forEach((d) => { if (abiertos.has(d.id.replace('anio-', '')) || location.hash === `#${d.id}`) d.open = true; });

  // Año cerrado con reseñas nuevas: lo dice al costado (abierto ya se ve por las carpetas)
  const avisarNuevas = () => anios.forEach((d) => {
    const hay = Array.from(d.querySelectorAll('.row .nuevas')).some((b) => !b.classList.contains('hidden'));
    d.querySelector('.hay-nuevas')?.classList.toggle('hidden', !hay);
  });
  avisarNuevas();
  // "Ir a" abre el año
  document.querySelectorAll<HTMLAnchorElement>('.jump a').forEach((a) => {
    a.addEventListener('click', () => {
      const d = document.getElementById(a.hash.slice(1)) as HTMLDetailsElement | null;
      if (d) d.open = true;
    });
  });
  // Solo electivas
  const btnElec = document.getElementById('solo-electivas');
  btnElec?.addEventListener('click', () => {
    const on = btnElec.getAttribute('aria-pressed') !== 'true';
    btnElec.setAttribute('aria-pressed', String(on));
    anios.forEach((d) => {
      let hay = false;
      d.querySelectorAll<HTMLElement>('.row').forEach((r) => {
        const ok = !on || r.dataset.electiva === '1';
        r.classList.toggle('hidden', !ok);
        if (ok && r.dataset.electiva === '1') hay = true;
      });
      d.classList.toggle('hidden', on && !hay);
      if (on && hay) d.open = true;
    });
  });
  // Marcar todo como leído
  document.getElementById('marcar-leido')?.addEventListener('click', () => {
    marcarLeido();
    document.querySelectorAll('.row .folder').forEach((f) => { f.classList.remove('new'); f.classList.add('old'); });
    document.querySelectorAll('.row .nuevas').forEach((b) => b.classList.add('hidden'));
    avisarNuevas();
  });
</script>
