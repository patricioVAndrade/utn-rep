---
/**
 * Mi inscripción (F29, migración 12): los cursos que estás pensando, por
 * materia, con turno, nota y horario, y el aviso si dos se pisan. No inscribe.
 *  - Con sesión: la lista de tu cuenta.
 *  - Sin sesión: la del navegador, que llega en el link (?c=...&mia=1).
 *  - Con ?c= y sin mia=1: una lista que te pasaron (solo para mirar).
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import CursoChips from '../components/CursoChips.astro';
import ShareButton from '../components/ShareButton.astro';
import { supabase, createSupabaseServerClient } from '../lib/supabase';
import { compararCursos, nota } from '../lib/format';
import { bloquesDeBase, sinRecreos, superposiciones, textoBloques, textoChoque, type Bloque } from '../lib/horarios';
import { idsDeTexto } from '../lib/inscripcion';

const user = Astro.locals.user;
const params = Astro.url.searchParams;
const mia = params.get('mia') === '1';
// Con sesión, "tu lista" es siempre la de la cuenta
const deLink = params.has('c') && !(user && mia);
// "compartida": la lista vino en el link y no es la tuya
const compartida = deLink && !mia;

let ids: number[] = [];
let sinTabla = false;
if (deLink) {
  ids = idsDeTexto(params.get('c'));
} else if (user) {
  const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const { data, error } = await client.from('inscripcion_cursos').select('dictado_id').eq('user_id', user.id).order('created_at');
  if (error) sinTabla = true;
  ids = (data || []).map((r: any) => r.dictado_id);
}

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);
type Curso = { id: number; curso: string; turno: string | null; promedio: number | null; cantidad: number; bloques: Bloque[] };
type Grupo = { materia: { id: number; nombre: string; nivel: number }; cursos: Curso[]; total: number };
let grupos: Grupo[] = [];

if (ids.length) {
  const [{ data: dictados }, { data: stats }, { data: horarios }] = await Promise.all([
    supabase.from('dictados').select('id, materia_id, cursos ( identificador, turno ), materias ( id, nombre, nivel )').in('id', ids),
    supabase.from('stats_dictados').select('dictado_id, cantidad, promedio').in('dictado_id', ids),
    supabase.from('horarios').select('dictado_id, cuatri, dia, desde, hasta').in('dictado_id', ids),
  ]);
  const st = new Map((stats || []).map((s: any) => [s.dictado_id, s]));
  const horDe = new Map<number, any[]>();
  (horarios || []).forEach((h: any) => horDe.set(h.dictado_id, [...(horDe.get(h.dictado_id) || []), h]));

  const porMateria = new Map<number, Grupo>();
  for (const d of dictados || []) {
    const m = one((d as any).materias);
    const c = one((d as any).cursos);
    if (!m) continue;
    const s: any = st.get(d.id);
    const g: Grupo = porMateria.get(m.id) || { materia: m, cursos: [], total: 0 };
    g.cursos.push({
      id: d.id,
      curso: c?.identificador || 'Curso',
      turno: c?.turno ?? null,
      promedio: s?.cantidad ? s.promedio : null,
      cantidad: s?.cantidad || 0,
      bloques: sinRecreos(bloquesDeBase(horDe.get(d.id) || [])),
    });
    porMateria.set(m.id, g);
  }
  grupos = [...porMateria.values()].sort((a, b) => a.materia.nivel - b.materia.nivel || a.materia.nombre.localeCompare(b.materia.nombre, 'es'));
  grupos.forEach((g) => g.cursos.sort((a, b) => compararCursos(a.curso, b.curso)));
  // Cuántos cursos tiene cada materia ("Ver los 7 cursos")
  const { data: todos } = await supabase.from('dictados').select('materia_id').in('materia_id', grupos.map((g) => g.materia.id)).range(0, 9999);
  const cuenta = new Map<number, number>();
  (todos || []).forEach((x: any) => cuenta.set(x.materia_id, (cuenta.get(x.materia_id) || 0) + 1));
  grupos.forEach((g) => { g.total = cuenta.get(g.materia.id) || g.cursos.length; });
}

// Cursos de materias distintas que se pisan
const choques = superposiciones(grupos.flatMap((g) => g.cursos.map((c) => ({ id: c.id, materia: g.materia.id, nombre: `${g.materia.nombre} (${c.curso})`, bloques: c.bloques }))));

// Próxima inscripción: en noviembre ya se piensa en el primer cuatri del año que viene
const hoy = new Date();
const mes = hoy.getMonth() + 1;
const periodo = mes <= 2 ? `primer cuatrimestre ${hoy.getFullYear()}` : mes <= 7 ? `segundo cuatrimestre ${hoy.getFullYear()}` : `primer cuatrimestre ${hoy.getFullYear() + 1}`;

const todosIds = grupos.flatMap((g) => g.cursos.map((c) => c.id));
---

<Layout title="Mi inscripción" tab="mis" crumbs={[{ label: 'Mi inscripción' }]} description="Los cursos que estás pensando, juntos: turno, nota y si se pisan los horarios.">
  <div class:list={['layout', { single: compartida }]}>
    <div class="main" id="mi-inscripcion" data-modo={compartida ? 'compartida' : user ? 'cuenta' : 'local'} data-ids={todosIds.join(',')}>
      <div class="topic">
        <div>
          <h1>{compartida ? 'La inscripción que te pasaron' : `Mi inscripción: ${periodo}`}</h1>
          {!compartida && <p>La inscripción se hace en Autogestión.</p>}
        </div>
        <div class="actions">
          {compartida
            ? <button type="button" class="btn primary" data-sumar><Icon name="check" /> Sumar a mi lista</button>
            : <a class="btn quiet" href="/">+ Agregar materia</a>}
          {grupos.length > 0 && !compartida && <ShareButton titulo="Mirá los cursos que estoy pensando para la inscripción" ruta={`/mi-inscripcion?c=${todosIds.join(',')}`} label="Mandársela a un amigo" />}
        </div>
      </div>

      {sinTabla && <div class="notice"><Icon name="info" /><div>Mi inscripción todavía no está lista en esta base (falta la migración 12).</div></div>}

      {grupos.length === 0 ? (
        <div class="empty" data-vacia>
          <h3>Todavía no estás pensando ningún curso</h3>
          <span>En cualquier curso tocá "Lo estoy pensando".</span>
          <a class="btn primary" href="/"><Icon name="search" /> Buscar materias</a>
        </div>
      ) : (
        <>
          {choques.length > 0 && (
            <div class="notice bad choques" role="status"><Icon name="alert" /><div>{choques.map((c) => <div>{textoChoque(c)}</div>)}</div></div>
          )}

          {grupos.map((g) => (
            <section class="plan" data-materia={g.materia.id}>
              <div class="plan-h">
                <span class:list={['yr', `y${g.materia.nivel}`]}>{g.materia.nivel}.º</span>
                <b>{g.materia.nombre}</b>
                <a class="sub" href={`/materia/${g.materia.id}/comparar`}>Ver los {g.total} cursos</a>
              </div>
              <div class="plan-c">
                {g.cursos.map((c) => (
                  <div class="pc" data-dictado={c.id}>
                    <span class="pc-top"><a href={`/dictado/${c.id}`}><b>{c.curso}</b></a><CursoChips mini turno={c.turno} /></span>
                    {c.promedio !== null
                      ? <span><Stars value={c.promedio} /> {nota(c.promedio)} <span class="sub">· {c.cantidad} reseña{c.cantidad !== 1 ? 's' : ''}</span></span>
                      : <span class="sub">Sin reseñas</span>}
                    <span class="sub pc-hor">{c.bloques.length ? textoBloques(c.bloques) : 'Sin horario cargado'}</span>
                    {!compartida && <button type="button" class="linklike sub pc-x" data-sacar={c.id} aria-label={`Sacar ${c.curso}`}>Sacar</button>}
                  </div>
                ))}
              </div>
            </section>
          ))}
        </>
      )}
    </div>

    {!compartida && (
      <aside class="side" aria-label="Avisos de Mi inscripción">
        <section class="panel">
          <h3>Avisos</h3>
          <div class="in">
            {user
              ? <span>Te avisamos cuando haya reseñas nuevas de estos cursos. Al terminar el cuatrimestre te preguntamos cómo te fue.</span>
              : <>
                  <span>Con tu cuenta te avisamos cuando haya reseñas nuevas de estos cursos, y ves la lista desde el celular y la compu.</span>
                  <button type="button" class="btn quiet" data-login>Iniciar sesión</button>
                </>}
          </div>
        </section>
      </aside>
    )}
  </div>
</Layout>

<script>
  import { api, guardarLocal, leerLocal, linkDe, traerLocal } from '../scripts/inscripcion';

  const raiz = document.getElementById('mi-inscripcion')!;
  const modo = raiz.dataset.modo;
  const params = new URLSearchParams(location.search);

  (async () => {
    // Sin sesión y sin lista en el link: la del navegador
    if (modo === 'local' && !params.has('c')) {
      const l = leerLocal();
      if (l.c.length) location.replace(linkDe(l, '&mia=1'));
      return;
    }
    // Con sesión: si quedó algo en el navegador, pasa a la cuenta
    if (modo === 'cuenta' && (await traerLocal())) location.reload();
  })();

  // Sin sesión, cada cambio se guarda en el navegador y se recarga con el link nuevo
  const local = (cambiar: (l: ReturnType<typeof leerLocal>) => void) => {
    const l = leerLocal();
    cambiar(l);
    guardarLocal(l);
    location.replace(l.c.length ? linkDe(l, '&mia=1') : '/mi-inscripcion');
  };

  async function hacer(body: Record<string, unknown>, enLocal: (l: ReturnType<typeof leerLocal>) => void) {
    if (modo === 'local') return local(enLocal);
    try {
      await api(body);
      location.reload();
    } catch (e) {
      alert((e as Error).message);
    }
  }

  raiz.querySelectorAll<HTMLButtonElement>('[data-sacar]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = Number(b.dataset.sacar);
      hacer({ accion: 'quitar', dictado_id: id }, (l) => { l.c = l.c.filter((x) => x !== id); });
    });
  });
  // Lista que te pasaron: se suma a la tuya (cuenta o navegador)
  raiz.querySelector<HTMLButtonElement>('[data-sumar]')?.addEventListener('click', async () => {
    const ids = (raiz.dataset.ids || '').split(',').map(Number).filter(Boolean);
    if (document.body.dataset.sesion === '1') {
      try {
        await api({ accion: 'traer', dictados: ids });
        location.href = '/mi-inscripcion';
      } catch (e) { alert((e as Error).message); }
      return;
    }
    const l = leerLocal();
    ids.forEach((x) => { if (!l.c.includes(x) && l.c.length < 80) l.c.push(x); });
    guardarLocal(l);
    location.href = linkDe(leerLocal(), '&mia=1');
  });
</script>
