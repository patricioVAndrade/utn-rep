---
/**
 * Mi inscripción: Simulá tu inscripción (Pato, 15/11). Arriba, la semana con
 * el curso elegido de cada materia (un color por materia, los choques en
 * rojo); abajo, cada materia con sus cursos ordenados por puntaje. El curso
 * elegido es el que queda en "Lo estoy pensando" (avisos de reseñas nuevas).
 * No inscribe.
 *  - Con sesión: la lista de tu cuenta.
 *  - Sin sesión: la del navegador, que llega en el link (?c=...&mia=1).
 *  - Con ?c= y sin mia=1: una inscripción que te pasaron (solo para mirar).
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ShareButton from '../components/ShareButton.astro';
import { supabase, createSupabaseServerClient } from '../lib/supabase';
import { idsDeTexto } from '../lib/inscripcion';
import { materiasSim, periodoInscripcion } from '../lib/simulador';
import { leerPerfil } from '../lib/perfil';

const user = Astro.locals.user;
const params = Astro.url.searchParams;
const mia = params.get('mia') === '1';
// Con sesión, "tu lista" es siempre la de la cuenta
const deLink = params.has('c') && !(user && mia);
// "compartida": la lista vino en el link y no es la tuya
const compartida = deLink && !mia;

let ids: number[] = [];
let sinTabla = false;
// Tus años (Mi cuenta): son las materias que se sugieren al agregar sin escribir
let misAnios: number[] = [];
if (user && !compartida) {
  const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const perfil = await leerPerfil(client, user.id);
  if (perfil.guardado) misAnios = (perfil.anios_cursada || []).map(Number).filter((n: number) => n >= 1 && n <= 5);
}
if (deLink) {
  ids = idsDeTexto(params.get('c'));
} else if (user) {
  const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const { data, error } = await client.from('inscripcion_cursos').select('dictado_id').eq('user_id', user.id).order('created_at');
  if (error) sinTabla = true;
  ids = (data || []).map((r: any) => r.dictado_id);
}

// El cuatrimestre que se simula: el de la próxima inscripción, o el que eligieron arriba
const periodo = periodoInscripcion();
const pedido = Number(params.get('cuatri'));
const cuatri = pedido === 1 || pedido === 2 ? pedido : periodo.cuatri;
// De marzo a julio se simula el 2.º de este año; el 1.º ya es del año que viene
const anioDe = (c: number) => (c === 1 && periodo.cuatri === 2 ? periodo.anio + 1 : periodo.anio);
const cuatris = [1, 2].map((c) => ({ c, texto: `${c === 1 ? '1.er' : '2.º'} cuatrimestre ${anioDe(c)}` }));

// Materias de los cursos de la lista
let materiaDe = new Map<number, number>();
if (ids.length) {
  const { data } = await supabase.from('dictados').select('id, materia_id').in('id', ids);
  materiaDe = new Map((data || []).map((d: any) => [d.id, d.materia_id]));
}
const materiaIds = [...new Set(ids.map((i) => materiaDe.get(i)).filter((x): x is number => !!x))];

const [materias, { data: catalogoRaw }, { data: cuentaRaw }] = await Promise.all([
  materiasSim(materiaIds),
  compartida ? Promise.resolve({ data: [] as any[] }) : supabase.from('materias').select('id, nombre, nivel').order('nivel'),
  compartida ? Promise.resolve({ data: [] as any[] }) : supabase.from('dictados').select('materia_id').range(0, 9999),
]);

// En cada materia, el elegido es el pensado con mejor puntaje (los cursos ya vienen ordenados)
const elegidas = materias.map((m) => {
  const pensados = ids.filter((i) => materiaDe.get(i) === m.id);
  const elegido = m.opciones.find((o) => pensados.includes(o.id))?.id ?? null;
  return { ...m, pensados, elegido };
});

const cursos = new Map<number, number>();
(cuentaRaw || []).forEach((d: any) => cursos.set(d.materia_id, (cursos.get(d.materia_id) || 0) + 1));
const catalogo = (catalogoRaw || []).map((m: any) => ({ id: m.id, nombre: m.nombre, nivel: m.nivel, cursos: cursos.get(m.id) || 0 })).filter((m) => m.cursos > 0);

const datos = { modo: compartida ? 'compartida' : user ? 'cuenta' : 'local', cuatri, porDefecto: periodo.cuatri, cuatris, materias: elegidas, catalogo, misAnios };
const json = JSON.stringify(datos).replace(/</g, '\\u003c');
const elegidosIds = elegidas.map((m) => m.elegido).filter(Boolean);
---

<Layout title="Mi inscripción" tab="mis" crumbs={[{ label: 'Mi inscripción' }]} description="Simulá tu inscripción: elegí un curso de cada materia mirando sus reseñas y fijate si se pisan los horarios.">
  <div class:list={['layout', { single: compartida }]}>
    <div class="main" id="mi-inscripcion" data-modo={datos.modo}>
      <div class="topic">
        <div>
          <h1>{compartida ? 'La inscripción que te pasaron' : 'Mi inscripción'}</h1>
          {!compartida && <p>La inscripción se hace en Autogestión.</p>}
        </div>
        <div class="actions">
          {compartida
            ? <button type="button" class="btn primary" data-copiar><Icon name="check" /> Copiar a mi inscripción</button>
            : <span data-compartir class:list={{ hidden: !elegidosIds.length }}><ShareButton titulo="Mirá los cursos que elegí para la inscripción" ruta={`/mi-inscripcion?c=${elegidosIds.join(',')}&cuatri=${cuatri}`} label="Compartir mi inscripción" /></span>}
        </div>
      </div>

      <div class="seg sim-cuatri" role="group" aria-label="Cuatrimestre">
        {cuatris.map((x) => <button type="button" data-cuatri={x.c} aria-pressed={x.c === cuatri ? 'true' : 'false'}>{x.texto}</button>)}
      </div>

      {sinTabla && <div class="notice"><Icon name="info" /><div>Mi inscripción todavía no está lista en esta base (falta la migración 12).</div></div>}

      <div class="notice bad choques hidden" role="status" id="sim-choques"><Icon name="alert" /><div></div></div>

      <div class="empty hidden" id="sim-vacia">
        <h3>Todavía no agregaste materias</h3>
        <span>Escribí abajo las materias que querés cursar.</span>
      </div>

      <div class="semana" id="sim-semana" aria-label="Tu semana"></div>
      <div class="sim-toque hidden" id="sim-toque" aria-live="polite"></div>

      {!compartida && (
        <div class="sim-filtro" id="sim-filtro">
          <span class="sub" id="turno-label">Turno:</span>
          <div class="seg" role="group" aria-labelledby="turno-label">
            <button type="button" data-turno="" aria-pressed="true">Todos</button>
            <button type="button" data-turno="M" aria-pressed="false">Mañana</button>
            <button type="button" data-turno="T" aria-pressed="false">Tarde</button>
            <button type="button" data-turno="N" aria-pressed="false">Noche</button>
          </div>
        </div>
      )}

      <div id="sim-materias"></div>

      {!compartida && (
        <div class="sim-agregar">
          <div class="sim-sumar">
            <Icon name="search" />
            <input type="search" id="sim-buscar" placeholder="Agregar otra materia" aria-label="Agregar otra materia" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="sim-sug" />
          </div>
          <div class="sugerencias hidden" id="sim-sug" role="listbox"></div>
        </div>
      )}
    </div>

    {!compartida && (
      <aside class="side" aria-label="Cómo funciona">
        <section class="panel">
          <h3>Cómo funciona</h3>
          <div class="in">
            <ol class="steps">
              <li>Elegí el cuatrimestre y agregá las materias que querés cursar.</li>
              <li>Elegí un curso de cada una. Están ordenados por puntaje: tocá el curso para ver sus reseñas.</li>
              <li>Si dos cursos se pisan, se marcan en rojo. Probá con otro.</li>
              <li>Compartí tu inscripción con tu grupo.</li>
            </ol>
            {user
              ? <span class="sub">No te inscribe: eso se hace en Autogestión. Te avisamos cuando haya reseñas nuevas de los cursos que elegiste.</span>
              : <>
                  <span class="sub">No te inscribe: eso se hace en Autogestión. Con tu cuenta te avisamos cuando haya reseñas nuevas de los cursos que elegiste.</span>
                  <button type="button" class="btn quiet" data-login>Iniciar sesión</button>
                </>}
          </div>
        </section>
      </aside>
    )}
  </div>
  <script type="application/json" id="sim-datos" set:html={json}></script>
</Layout>

<script>
  import { api, guardarLocal, leerLocal, linkDe, traerLocal } from '../scripts/inscripcion';
  import { DIAS, DIAS_CORTOS, horaTexto, superposiciones, textoChoque, type Bloque } from '../lib/horarios';
  import { coincide, palabrasDe, parecido } from '../lib/buscar';

  type Opcion = { id: number; curso: string; turno: string | null; periodo: string | null; promedio: number | null; cantidad: number; bloques: Bloque[]; cuatris: (1 | 2)[]; anual: boolean; contra: boolean };
  type Materia = { id: number; nombre: string; nivel: number; sigla: string; opciones: Opcion[]; pensados: number[]; elegido: number | null };
  type Datos = { modo: 'cuenta' | 'local' | 'compartida'; cuatri: 1 | 2; porDefecto: 1 | 2; cuatris: { c: 1 | 2; texto: string }[]; materias: Materia[]; catalogo: { id: number; nombre: string; nivel: number; cursos: number }[]; misAnios: number[] };

  const raiz = document.getElementById('mi-inscripcion')!;
  const datos: Datos = JSON.parse(document.getElementById('sim-datos')!.textContent || '{}');
  const { modo } = datos;
  const params = new URLSearchParams(location.search);
  const soloMirar = modo === 'compartida';

  (async () => {
    // Sin sesión y sin lista en el link: la del navegador
    if (modo === 'local' && !params.has('c')) {
      const l = leerLocal();
      if (l.c.length) location.replace(linkDe(l, '&mia=1'));
      return;
    }
    // Con sesión: si quedó algo en el navegador, pasa a la cuenta
    if (modo === 'cuenta' && (await traerLocal())) location.reload();
  })();

  let turno = '';
  let cuatri = datos.cuatri;
  let toque: number | null = null;
  const abiertas = new Set<number>();

  // ── Ayudas ──
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const nota = (n: number) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const estrellas = (p: number) => { const n = Math.min(Math.max(Math.round(p), 0), 5); return `<span class="stars" role="img" aria-label="${nota(p)} de 5 estrellas">${'★'.repeat(n)}<span class="off">${'★'.repeat(5 - n)}</span></span>`; };
  const letraTurno = (t: string | null) => (t ? t.normalize('NFD').replace(/[̀-ͯ]/g, '').trim().charAt(0).toUpperCase() : '');
  const textoTurno = (t: string | null) => (t ? t.trim().charAt(0).toUpperCase() + t.trim().slice(1).toLowerCase() : '');
  // El cuatrimestre que se mira: los anuales ocupan los dos, pero se eligen en el 1.º
  const seCursa = (o: Opcion) => o.cuatris.includes(cuatri);
  const sePuede = (o: Opcion) => seCursa(o) && !(cuatri === 2 && o.anual);
  const bloquesDe = (o: Opcion) => o.bloques.filter((b) => b.cuatri === null || b.cuatri === cuatri);
  const nombreCuatri = (c: number) => (c === 1 ? '1.er cuatrimestre' : '2.º cuatrimestre');
  const horario = (o: Opcion) => {
    const bs = seCursa(o) ? bloquesDe(o) : o.bloques;
    return bs.length ? bs.map((b) => `${DIAS_CORTOS[b.dia]} ${horaTexto(b.desde)} a ${horaTexto(b.hasta)}`).join(' · ') : 'Sin horario cargado';
  };
  const elegidoDe = (m: Materia) => m.opciones.find((o) => o.id === m.elegido) || null;
  const pisan = (x: Bloque, y: Bloque) => x.dia === y.dia && Math.max(x.desde, y.desde) < Math.min(x.hasta, y.hasta);
  const nombreCurso = (m: Materia, o: Opcion) => `${m.nombre} (${o.curso})`;

  function guardarEnLink() {
    if (modo !== 'local') return;
    const l = { c: datos.materias.flatMap((m) => m.pensados) };
    guardarLocal(l);
    history.replaceState(null, '', l.c.length ? linkDe(l, `&mia=1&cuatri=${cuatri}`) : `/mi-inscripcion?cuatri=${cuatri}`);
  }

  // ── Dibujo ──
  function render() {
    const ms = datos.materias;
    // En la semana, solo lo que se cursa en el cuatrimestre elegido
    const elegidos = ms.map((m, i) => ({ m, i, o: elegidoDe(m) })).filter((e): e is { m: Materia; i: number; o: Opcion } => !!e.o && seCursa(e.o));
    const todos = elegidos.flatMap((e) => bloquesDe(e.o).map((b) => ({ ...b, m: e.m, o: e.o, i: e.i })));

    // Choques
    const choques = superposiciones(elegidos.map((e) => ({ id: e.o.id, materia: e.m.id, nombre: nombreCurso(e.m, e.o), bloques: bloquesDe(e.o).map((b) => ({ ...b, cuatri: null })) })));
    const cb = document.getElementById('sim-choques')!;
    cb.classList.toggle('hidden', !choques.length);
    cb.querySelector('div')!.innerHTML = choques.map((c) => `<div>${esc(textoChoque(c))}</div>`).join('');
    const conChoque = new Set(todos.filter((x) => todos.some((y) => y.m !== x.m && pisan(x, y))));

    document.getElementById('sim-vacia')!.classList.toggle('hidden', ms.length > 0);
    document.getElementById('sim-filtro')?.classList.toggle('hidden', !ms.length);

    // Semana
    const sem = document.getElementById('sim-semana')!;
    sem.classList.toggle('hidden', !ms.length);
    const desde = todos.length ? Math.floor(Math.min(...todos.map((b) => b.desde)) / 60) * 60 : 480;
    const hasta = todos.length ? Math.ceil(Math.max(...todos.map((b) => b.hasta)) / 60) * 60 : 780;
    const angosta = sem.getBoundingClientRect().width < 500;
    const ppm = angosta ? 0.62 : 0.8;
    // Dos horas o más sin ninguna clase (mañana y noche, por ejemplo) se achican a una franja
    const HUECO = 26;
    const libre = (h: number) => !todos.some((b) => b.desde < h + 60 && b.hasta > h);
    const huecos: [number, number][] = [];
    for (let h = desde; h < hasta; h += 60) {
      if (!libre(h)) continue;
      const u = huecos[huecos.length - 1];
      if (u && u[1] === h) u[1] = h + 60; else huecos.push([h, h + 60]);
    }
    const cortos = huecos.filter(([a, z]) => z - a >= 120);
    const y = (t: number) => {
      let v = (t - desde) * ppm;
      for (const [a, z] of cortos) { if (t >= z) v -= (z - a) * ppm - HUECO; else if (t > a) v -= (t - a) * ppm - ((t - a) / (z - a)) * HUECO; }
      return v;
    };
    const enHueco = (t: number) => cortos.some(([a, z]) => t > a && t < z);
    sem.style.setProperty('--alto', `${y(hasta)}px`);
    let html = '<div class="dh"></div>' + DIAS_CORTOS.slice(1, 7).map((d) => `<div class="dh">${d}</div>`).join('');
    html += '<div class="horas">';
    for (let t = desde; t < hasta; t += 60) if (!enHueco(t) && !cortos.some(([a]) => a === t && t !== desde)) html += `<span style="top:${y(t)}px">${t / 60}</span>`;
    html += '</div>';
    for (let d = 1; d <= 6; d++) {
      html += '<div class="dia">';
      for (let t = desde + 60; t < hasta; t += 60) if (!enHueco(t)) html += `<i class="hl" style="top:${y(t)}px"></i>`;
      for (const [a] of cortos) html += `<i class="hueco" style="top:${y(a)}px;height:${HUECO}px"></i>`;
      const del = todos.filter((b) => b.dia === d).sort((a, b) => a.desde - b.desde);
      // Carriles: si dos se pisan, van uno al lado del otro
      const carril = new Map<any, number>();
      const fin: number[] = [];
      del.forEach((b) => { let k = fin.findIndex((z) => z <= b.desde); if (k < 0) { k = fin.length; fin.push(0); } fin[k] = b.hasta; carril.set(b, k); });
      del.forEach((b) => {
        const grupo = del.filter((o) => o === b || pisan(o, b));
        const n = Math.max(...grupo.map((o) => carril.get(o)!)) + 1;
        const k = carril.get(b)!;
        const ancho = n > 1 ? `left:calc(${(k * 100) / n}% + 1px);right:auto;width:calc(${100 / n}% - 2px);` : '';
        const alto = (b.hasta - b.desde) * ppm;
        const st = b.o.promedio !== null && alto >= 44
          ? `<span class="st"><span class="st-l">★ ${nota(b.o.promedio)} (${b.o.cantidad})</span><span class="st-c">★ ${nota(b.o.promedio)}</span></span>` : '';
        html += `<button type="button" data-toque="${b.m.id}" class="bq m${(b.i % 6) + 1}${conChoque.has(b) ? ' pisa' : ''}${toque === b.m.id ? ' tocado' : ''}" style="top:${y(b.desde)}px;height:${alto - 2}px;${ancho}" aria-label="${esc(`${b.m.nombre}, ${b.o.curso}, ${DIAS[b.dia]} ${horaTexto(b.desde)} a ${horaTexto(b.hasta)}`)}">`
          + `<b${b.o.curso.length > 5 ? ' class="largo"' : ''}>${esc(b.o.curso)}</b><span>${esc(b.m.sigla)}</span>${st}</button>`;
      });
      html += '</div>';
    }
    sem.innerHTML = html;
    const primera = sem.querySelector<HTMLElement>('.dia');
    for (const [a, z] of cortos) {
      const r = document.createElement('div');
      r.className = 'hueco-txt';
      r.style.top = `${(primera?.offsetTop || 0) + y(a)}px`;
      r.style.height = `${HUECO}px`;
      r.textContent = `Sin clases de ${a / 60} a ${z / 60}`;
      sem.appendChild(r);
    }

    // Bloque tocado: el detalle abajo de la semana
    const tc = document.getElementById('sim-toque')!;
    const et = elegidos.find((e) => e.m.id === toque);
    tc.className = et ? `sim-toque m${(et.i % 6) + 1}` : 'sim-toque hidden';
    tc.innerHTML = et
      ? `<i></i><div><span><b>${esc(et.m.nombre)}</b>, ${esc(et.o.curso)}${et.o.turno ? ` · ${esc(textoTurno(et.o.turno))}` : ''}${et.o.contra ? ' · Contracuatrimestral' : ''}</span>`
        + (et.o.promedio !== null ? `<span>${estrellas(et.o.promedio)} ${nota(et.o.promedio)} <span class="sub">· ${et.o.cantidad} reseña${et.o.cantidad !== 1 ? 's' : ''}</span></span>` : '<span class="sub">Sin reseñas</span>')
        + `<span class="sub">${bloquesDe(et.o).map((b) => `${DIAS[b.dia]} ${horaTexto(b.desde)} a ${horaTexto(b.hasta)}`).join(' · ')}</span>`
        + `<span class="acc"><a href="/dictado/${et.o.id}">Ver las reseñas</a>${soloMirar ? '' : `<button type="button" class="linklike" data-cambiar="${et.m.id}">Cambiar de curso</button>`}</span></div>`
      : '';

    // Materias y sus cursos
    const cont = document.getElementById('sim-materias')!;
    // Primero las de este cuatrimestre; las elegidas en el otro, al final
    const orden = ms.map((m, i) => ({ m, i, aca: !elegidoDe(m) || seCursa(elegidoDe(m)!) })).sort((a, b) => Number(b.aca) - Number(a.aca));
    cont.innerHTML = orden.map(({ m, i, aca }) => {
      const elegido = elegidoDe(m);
      const otros = todos.filter((b) => b.m !== m);
      const abierta = abiertas.has(m.id);
      const lista = m.opciones.filter((o) => o === elegido || (!soloMirar && abierta && sePuede(o) && (!turno || letraTurno(o.turno) === turno)));
      const filas = lista.map((o) => {
        const con = seCursa(o) ? [...new Set(bloquesDe(o).flatMap((b) => otros.filter((x) => pisan(x, b)).map((x) => nombreCurso(x.m, x.o))))] : [];
        const extra = [textoTurno(o.turno), o.periodo?.replace('cuatrimestre', 'cuatri'), o.contra ? 'Contracuatrimestral' : ''].filter(Boolean).join(' · ');
        return `<label class="op${o === elegido ? ' sel' : ''}">${soloMirar ? '<span></span>' : `<input type="radio" name="m-${m.id}" value="${o.id}" ${o === elegido ? 'checked' : ''}>`}`
          + `<a class="cod" href="/dictado/${o.id}">${esc(o.curso)}</a><span>${esc(extra)}</span>`
          + `<span class="nota">${o.promedio !== null ? `${estrellas(o.promedio)} ${nota(o.promedio)} <span class="sub">· ${o.cantidad}</span>` : '<span class="sub">Sin reseñas</span>'}</span>`
          + `<span class="hor">${esc(horario(o))}</span>`
          + (con.length ? `<span class="pisa-txt">Se pisa con ${esc(con.join(' y '))}</span>` : '') + '</label>';
      }).join('');
      const posibles = m.opciones.filter(sePuede);
      const resto = posibles.filter((o) => o !== elegido).length;
      let aviso = '';
      if (!elegido) aviso = `No hay cursos de esta materia en el ${nombreCuatri(cuatri)}.`;
      else if (!aca) aviso = posibles.length && !soloMirar ? `La elegiste en el ${nombreCuatri(3 - cuatri)}. Si la querés cursar en el ${nombreCuatri(cuatri)}, elegí otro curso.` : `Se cursa en el ${nombreCuatri(3 - cuatri)}.`;
      else if (posibles.length && posibles.every((o) => o.contra)) {
        // IA en 5K3: en ese cuatrimestre solo está el contracuatrimestral, los demás son del otro
        const delOtro = m.opciones.filter((o) => !o.contra && o.cuatris.includes((3 - cuatri) as 1 | 2)).length;
        if (delOtro) aviso = `En el ${nombreCuatri(cuatri)} solo ${posibles.length === 1 ? 'está el curso contracuatrimestral' : 'están los cursos contracuatrimestrales'}. ${delOtro === 1 ? 'El otro curso es' : `Los otros ${delOtro} cursos son`} del ${nombreCuatri(3 - cuatri)}.`;
      }
      const vacia = aviso ? `<div class="vacia">${esc(aviso)}</div>` : '';
      // La columna del curso, del ancho del más largo (1H10/50)
      const largo = Math.max(3, ...lista.map((o) => o.curso.length));
      return `<section class="sim-m m${(i % 6) + 1}${aca ? '' : ' fuera'}" data-materia="${m.id}" style="--cw:calc(${largo}ch + 6px)"><div class="plan-h"><span class="cuad"></span><b>${esc(m.nombre)}</b>${soloMirar ? '' : `<button type="button" class="linklike quitar" data-quitar="${m.id}">Quitar</button>`}</div>${vacia}${filas}`
        + (!soloMirar && resto > 0 ? `<button type="button" class="linklike mas" data-abrir="${m.id}">${abierta ? 'Ver menos' : `Ver ${resto === 1 ? 'el otro curso' : `los otros ${resto} cursos`}`}</button>` : '') + '</section>';
    }).join('');

    // Compartir: los elegidos de los dos cuatrimestres
    const ids = ms.map((m) => m.elegido).filter((x): x is number => !!x);
    const share = raiz.querySelector<HTMLElement>('[data-compartir]');
    share?.classList.toggle('hidden', !ids.length);
    const btn = share?.querySelector<HTMLElement>('[data-share]');
    if (btn) btn.dataset.ruta = `/mi-inscripcion?c=${ids.join(',')}&cuatri=${cuatri}`;
  }

  // ── Acciones ──
  async function guardar(body: Record<string, unknown>) {
    if (modo !== 'cuenta') return true;
    try { await api(body); return true; } catch (e) { alert((e as Error).message); return false; }
  }

  async function elegir(m: Materia, id: number) {
    if (m.elegido === id) return;
    const antes = { pensados: m.pensados, elegido: m.elegido };
    m.pensados = [id]; m.elegido = id;
    render();
    if (!(await guardar({ accion: 'elegir', dictado_id: id, quitar: antes.pensados }))) { Object.assign(m, antes); render(); return; }
    guardarEnLink();
  }

  async function quitar(m: Materia) {
    const i = datos.materias.indexOf(m);
    datos.materias.splice(i, 1);
    if (toque === m.id) toque = null;
    render();
    if (!(await guardar({ accion: 'quitar', dictados: m.pensados }))) { datos.materias.splice(i, 0, m); render(); return; }
    guardarEnLink();
  }

  async function agregar(materiaId: number) {
    if (datos.materias.some((m) => m.id === materiaId)) return;
    let m: Materia;
    try {
      const res = await fetch(`/api/inscripcion/opciones?materia=${materiaId}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'No se pudieron traer los cursos.');
      m = { ...data.materia, pensados: [], elegido: null };
    } catch (e) { alert((e as Error).message); return; }
    // El de mejor puntaje que no se pise con lo que ya elegiste (si no hay, el de mejor puntaje)
    const ocupados = datos.materias.flatMap((x) => { const o = elegidoDe(x); return o && seCursa(o) ? bloquesDe(o) : []; });
    const posibles = m.opciones.filter(sePuede);
    const mejor = posibles.find((o) => bloquesDe(o).length && !bloquesDe(o).some((b) => ocupados.some((x) => pisan(x, b)))) || posibles[0] || m.opciones[0];
    if (!mejor) { alert('Esa materia todavía no tiene cursos cargados.'); return; }
    m.pensados = [mejor.id]; m.elegido = mejor.id;
    datos.materias.push(m);
    render();
    if (!(await guardar({ accion: 'agregar', dictado_id: mejor.id }))) { datos.materias.pop(); render(); return; }
    guardarEnLink();
    document.querySelector(`[data-materia="${m.id}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  raiz.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type !== 'radio' || !t.name.startsWith('m-')) return;
    const m = datos.materias.find((x) => x.id === Number(t.name.slice(2)));
    if (m) elegir(m, Number(t.value));
  });

  raiz.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const b = el.closest<HTMLElement>('[data-abrir],[data-turno],[data-toque],[data-quitar],[data-cambiar],[data-cuatri]');
    if (!b) return;
    if (b.dataset.cuatri) {
      cuatri = Number(b.dataset.cuatri) as 1 | 2;
      toque = null;
      raiz.querySelectorAll('[data-cuatri]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const u = new URL(location.href);
      u.searchParams.set('cuatri', String(cuatri));
      history.replaceState(null, '', u);
    }
    if (b.dataset.toque) toque = toque === Number(b.dataset.toque) ? null : Number(b.dataset.toque);
    if (b.dataset.abrir) { const id = Number(b.dataset.abrir); abiertas.has(id) ? abiertas.delete(id) : abiertas.add(id); }
    if (b.dataset.cambiar) {
      abiertas.add(Number(b.dataset.cambiar));
      render();
      document.querySelector(`[data-materia="${b.dataset.cambiar}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    if (b.dataset.turno !== undefined) {
      turno = b.dataset.turno;
      raiz.querySelectorAll('[data-turno]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      // Con un turno elegido, se ven las opciones de todas las materias
      if (turno) datos.materias.forEach((m) => abiertas.add(m.id));
    }
    if (b.dataset.quitar) {
      const m = datos.materias.find((x) => x.id === Number(b.dataset.quitar));
      if (m) quitar(m);
      return;
    }
    render();
  });

  // ── Agregar otra materia ──
  const buscar = document.getElementById('sim-buscar') as HTMLInputElement | null;
  const sug = document.getElementById('sim-sug');
  let activa = 0;
  function sugerir() {
    if (!buscar || !sug) return;
    const q = buscar.value.trim();
    const ya = new Set(datos.materias.map((m) => m.id));
    const libres = datos.catalogo.filter((m) => !ya.has(m.id));
    let lista: typeof libres;
    if (!q) {
      // Sin escribir: las de tus años de Mi cuenta (sin sesión, los de este navegador);
      // si no marcaste ninguno, los de las materias que ya agregaste; si tampoco, todas
      let anios = datos.misAnios;
      if (!anios.length && modo === 'local') { try { anios = (JSON.parse(localStorage.getItem('misAnios') || '[]') as unknown[]).map(Number).filter(Boolean); } catch {} }
      if (!anios.length) anios = [...new Set(datos.materias.map((m) => m.nivel))];
      lista = anios.length ? libres.filter((m) => anios.includes(m.nivel)) : libres;
      lista.sort((a, b) => a.nivel - b.nivel || a.nombre.localeCompare(b.nombre, 'es'));
    } else {
      const pal = palabrasDe(q);
      lista = libres.filter((m) => coincide(pal, m.nombre));
      if (!lista.length) lista = libres.map((m) => ({ m, d: parecido(pal, m.nombre) })).filter((x) => x.d !== null).sort((a, b) => a.d! - b.d!).map((x) => x.m);
    }
    if (q) lista = lista.slice(0, 8);
    activa = 0;
    let anio = 0;
    sug.innerHTML = lista.length
      ? lista.map((m, k) => (!q && m.nivel !== anio ? `<div class="t">${(anio = m.nivel)}.º año</div>` : '') + `<button type="button" role="option" class="${k === 0 ? 'act' : ''}" data-agregar="${m.id}">${q ? `<span class="yr y${m.nivel}">${m.nivel}.º</span>` : ''}<span>${esc(m.nombre)}</span><span class="sub">${m.cursos} curso${m.cursos !== 1 ? 's' : ''}</span></button>`).join('')
      : '<div class="nada">No encontramos esa materia.</div>';
    sug.classList.remove('hidden');
    buscar.setAttribute('aria-expanded', 'true');
  }
  const cerrar = () => { sug?.classList.add('hidden'); buscar?.setAttribute('aria-expanded', 'false'); };
  buscar?.addEventListener('focus', sugerir);
  buscar?.addEventListener('input', sugerir);
  buscar?.addEventListener('keydown', (e) => {
    const ops = Array.from(sug?.querySelectorAll<HTMLButtonElement>('[data-agregar]') || []);
    if (e.key === 'Escape') return cerrar();
    if (!ops.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      activa = (activa + (e.key === 'ArrowDown' ? 1 : -1) + ops.length) % ops.length;
      ops.forEach((o, k) => o.classList.toggle('act', k === activa));
      ops[activa].scrollIntoView({ block: 'nearest' });
    }
    if (e.key === 'Enter') { e.preventDefault(); ops[activa]?.click(); }
  });
  sug?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-agregar]');
    if (!b || !buscar) return;
    buscar.value = '';
    cerrar();
    agregar(Number(b.dataset.agregar));
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.sim-agregar')) cerrar(); });

  // ── Inscripción que te pasaron: se copia a la tuya (cuenta o navegador) ──
  raiz.querySelector<HTMLButtonElement>('[data-copiar]')?.addEventListener('click', async () => {
    const ids = datos.materias.map((m) => m.elegido).filter((x): x is number => !!x);
    if (document.body.dataset.sesion === '1') {
      try {
        await api({ accion: 'traer', dictados: ids });
        location.href = '/mi-inscripcion';
      } catch (e) { alert((e as Error).message); }
      return;
    }
    const l = leerLocal();
    ids.forEach((x) => { if (!l.c.includes(x) && l.c.length < 80) l.c.push(x); });
    guardarLocal(l);
    location.href = linkDe(leerLocal(), '&mia=1');
  });

  render();
  // Si cambia el ancho (girar el celular), se vuelve a dibujar la semana
  let ancho = window.innerWidth;
  window.addEventListener('resize', () => { if (Math.abs(window.innerWidth - ancho) > 40) { ancho = window.innerWidth; render(); } });
</script>
