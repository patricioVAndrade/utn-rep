---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { supabase } from '../../lib/supabase';
import { anioLabel } from '../../lib/format';

const user = Astro.locals.user;

// Hay que estar logueado
if (!user) {
  return Astro.redirect('/?auth_error=login_required');
}

const [{ data: materias }, { data: profesores }] = await Promise.all([
  supabase.from('materias').select('id, nombre, nivel').order('nivel', { ascending: true }).order('nombre', { ascending: true }),
  supabase.from('profesores').select('id, nombre_completo').order('nombre_completo', { ascending: true }),
]);

const listaMaterias = materias || [];
const listaProfesores = profesores || [];

// Años desde el actual hasta 2015
const currentYear = new Date().getFullYear();
const aniosDisponibles = Array.from({ length: currentYear - 2014 }, (_, i) => currentYear - i);
---

<Layout
  title="Contar mi final - UTN REP"
  tab="finales"
  crumbs={[{ label: 'Experiencias de finales', href: '/finales' }, { label: 'Contar mi final' }]}
>
  <div class="layout">
    <div class="main">
      <div id="form-error" class="notice bad hidden" role="alert">
        <Icon name="alert" />
        <div><b>No se pudo publicar</b><p id="form-error-text"></p></div>
      </div>

      <form id="final-form" class="form" novalidate>
        <h1 class="fhead"><span>Contar mi final</span></h1>
        <div class="fgrid">
          <label for="materia_search">Materia<small>Escribí y elegí de la lista.</small></label>
          <div class="field">
            <input type="text" id="materia_search" list="lista-materias" autocomplete="off" required placeholder="Por ejemplo: Análisis Matemático I" />
            <datalist id="lista-materias">
              {listaMaterias.map((m: any) => <option data-id={m.id} value={`${m.nombre} (${anioLabel(m.nivel)})`}></option>)}
            </datalist>
          </div>

          <label for="anio">Año en que rendiste</label>
          <div class="field">
            <select id="anio" required>
              <option value="" disabled selected>Elegí el año…</option>
              {aniosDisponibles.map((anio) => <option value={anio}>{anio}</option>)}
            </select>
          </div>

          <label for="mesa">Mesa</label>
          <div class="field">
            <select id="mesa" required>
              <option value="" disabled selected>Elegí la mesa…</option>
              <option value="Diciembre">Diciembre</option>
              <option value="Febrero">Febrero / Marzo</option>
              <option value="Julio">Julio</option>
              <option value="Especial">Mesa especial</option>
            </select>
          </div>

          <label for="profesor">Profesor que tomó<small>Opcional</small></label>
          <div class="field">
            <select id="profesor">
              <option value="" selected>No me acuerdo</option>
              {listaProfesores.map((p: any) => <option value={p.nombre_completo}>{p.nombre_completo}</option>)}
            </select>
          </div>

          <label for="comentario">Tu experiencia<small>Mínimo 10 caracteres.</small></label>
          <div class="field">
            <textarea id="comentario" required rows="6" maxlength="1000" placeholder="¿Cómo fue la mesa? ¿Fue más difícil el práctico o el teórico? ¿Qué temas salieron?"></textarea>
          </div>
        </div>
        <div class="fbar">
          <a href="/finales">Volver a los finales</a>
          <button type="submit" id="submit-btn" class="btn primary"><Icon name="pen" /> Publicar experiencia</button>
        </div>
      </form>
    </div>

    <aside class="side">
      <section class="panel guide">
        <h3>Qué contar</h3>
        <div class="in">
          <ul>
            <li class="good">Qué temas tomaron y en qué formato.</li>
            <li class="good">Cuánto duró y cómo corrigieron.</li>
            <li class="good">Qué te sirvió para prepararlo.</li>
            <li class="bad">No compartas enunciados con datos personales.</li>
          </ul>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  const form = document.getElementById('final-form') as HTMLFormElement;
  const errorBox = document.getElementById('form-error') as HTMLDivElement;
  const errorText = document.getElementById('form-error-text') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const searchInput = document.getElementById('materia_search') as HTMLInputElement;
  const original = submitBtn.innerHTML;

  const mostrarError = (texto: string) => {
    errorText.textContent = texto;
    errorBox.classList.remove('hidden');
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    // El datalist da el texto; buscamos el id real de la materia
    let materia_id = '';
    for (const option of Array.from(document.querySelectorAll('#lista-materias option'))) {
      const opt = option as HTMLOptionElement;
      if (opt.value === searchInput.value) {
        materia_id = opt.getAttribute('data-id') || '';
        break;
      }
    }

    const anio = (document.getElementById('anio') as HTMLSelectElement).value;
    const mesa = (document.getElementById('mesa') as HTMLSelectElement).value;
    const profesor_nombre = (document.getElementById('profesor') as HTMLSelectElement).value;
    const comentario = (document.getElementById('comentario') as HTMLTextAreaElement).value;

    if (!materia_id) return mostrarError('Elegí una materia de la lista.');
    if (!anio) return mostrarError('Elegí el año en que rendiste.');
    if (!mesa) return mostrarError('Elegí la mesa.');
    if (comentario.trim().length < 10) return mostrarError('Contá tu experiencia en al menos 10 caracteres.');

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spin"></span> Publicando…';

    try {
      const response = await fetch('/api/finales/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ materia_id, anio, mesa, profesor_nombre, comentario }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Ocurrió un error al guardar.');
      window.location.href = '/finales';
    } catch (err: any) {
      mostrarError(err.message);
      submitBtn.disabled = false;
      submitBtn.innerHTML = original;
    }
  });
</script>
