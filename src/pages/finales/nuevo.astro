---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { supabase } from '../../lib/supabase';

const user = Astro.locals.user;

// Hay que estar logueado
if (!user) {
  return Astro.redirect('/?auth_error=login_required');
}

const [{ data: materias }, { data: profesores }] = await Promise.all([
  supabase.from('materias').select('id, nombre, nivel').order('nivel', { ascending: true }).order('nombre', { ascending: true }),
  supabase.from('profesores').select('id, nombre_completo').order('nombre_completo', { ascending: true }).range(0, 19999),
]);

const listaMaterias = materias || [];
const listaProfesores = profesores || [];

// ¿Viene desde una materia? (?materia=ID)
const materiaParam = Number(Astro.url.searchParams.get('materia'));
const materiaInicial = listaMaterias.find((m: any) => m.id === materiaParam) || null;
const etiqueta = (m: any) => `${m.nombre} (${m.nivel}.º año)`;

// Este año, el anterior y "Antes" (abre la lista desde 2015)
const currentYear = new Date().getFullYear();
const aniosViejos = Array.from({ length: currentYear - 1 - 2015 }, (_, i) => currentYear - 2 - i);
---

<Layout
  title="Compartir mi experiencia - UTN REP"
  tab="finales"
  crumbs={[{ label: 'Experiencias de finales', href: '/finales' }, { label: 'Compartir mi experiencia' }]}
>
  <div class="layout">
    <div class="main">
      <div id="form-error" class="notice bad hidden" role="alert">
        <Icon name="alert" />
        <div><b>No se pudo publicar</b><p id="form-error-text"></p></div>
      </div>

      <form id="final-form" class="form" novalidate>
        <h1 class="fhead"><span>Compartir mi experiencia</span><span class="draft-note" id="draft-note">Se guarda como borrador</span></h1>
        <div class="fgrid">
          <label for="materia_search">Materia</label>
          <div class="field">
            <input type="text" id="materia_search" list="lista-materias" autocomplete="off" required placeholder="Por ejemplo: Análisis Matemático I" value={materiaInicial ? etiqueta(materiaInicial) : ''} />
            <datalist id="lista-materias">
              {listaMaterias.map((m: any) => <option data-id={m.id} data-nivel={m.nivel} value={etiqueta(m)}></option>)}
            </datalist>
            <span class="help"><span id="materia-yr" class:list={['yr', materiaInicial ? `y${materiaInicial.nivel}` : 'hidden']}>{materiaInicial ? `${materiaInicial.nivel}.º` : ''}</span> Se autocompleta mientras escribís.</span>
          </div>

          <div class="lab" id="lab-mesa">Mesa</div>
          <div class="field">
            <div class="seg" role="radiogroup" aria-labelledby="lab-mesa">
              {[['Diciembre', 'Diciembre'], ['Febrero', 'Febrero / marzo'], ['Julio', 'Julio'], ['Especial', 'Especial']].map(([v, l]) => (
                <button type="button" role="radio" data-mesa={v} aria-checked="false" aria-pressed="false">{l}</button>
              ))}
            </div>
          </div>

          <div class="lab" id="lab-anio">Año</div>
          <div class="field">
            <div class="seg" role="radiogroup" aria-labelledby="lab-anio">
              <button type="button" role="radio" data-anio={currentYear} aria-checked="true" aria-pressed="true">{currentYear}</button>
              <button type="button" role="radio" data-anio={currentYear - 1} aria-checked="false" aria-pressed="false">{currentYear - 1}</button>
              <button type="button" role="radio" data-anio="antes" aria-checked="false" aria-pressed="false">Antes</button>
            </div>
            <label class="sr" for="anio-viejo">Año</label>
            <select id="anio-viejo" class="hidden">
              {aniosViejos.map((a) => <option value={a}>{a}</option>)}
            </select>
          </div>

          <label for="profesor">¿Quién te tomó?<small>Opcional</small></label>
          <div class="field">
            <input type="text" id="profesor" list="lista-profes" autocomplete="off" maxlength="120" placeholder="Por ejemplo: Benítez" />
            <datalist id="lista-profes">
              {listaProfesores.map((p: any) => <option value={p.nombre_completo}></option>)}
            </datalist>
            <span class="help">Si elegís un nombre de la lista, la experiencia queda enlazada a su página.</span>
          </div>

          <label for="comentario">Tu experiencia<small>Mínimo 10 caracteres</small></label>
          <div class="field">
            <textarea id="comentario" required rows="6" maxlength="1000" placeholder="¿Fue escrito, oral o en máquina? ¿Cuánto duró? ¿Qué temas entraron?"></textarea>
            <span class="help">Ayuda contar: si fue escrito, oral o en máquina, cuánto duró, qué temas entraron y cómo corrigieron. <span id="contador">0</span>/1000</span>
          </div>

          <div class="lab">Privacidad</div>
          <div class="field">
            <span class="help" style="font-size:11.5px">Se publica como <b>anónima</b>: no mostramos quién la contó.</span>
          </div>
        </div>
        <div class="fbar">
          <a class="btn quiet" href={materiaInicial ? `/materia/${materiaInicial.id}` : '/finales'}>Cancelar</a>
          <button type="submit" id="submit-btn" class="btn primary"><Icon name="pen" /> Publicar experiencia</button>
        </div>
      </form>
    </div>

    <aside class="side">
      <section class="panel guide">
        <h3>Qué le sirve a quien rinde</h3>
        <div class="in">
          <ol class="steps">
            <li>Modalidad: escrito, oral o en máquina.</li>
            <li>Cuánto duró.</li>
            <li>Qué temas tomaron.</li>
            <li>Cómo corrigieron y si hubo coloquio.</li>
          </ol>
          <span class="sub">No copies enunciados con datos personales.</span>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const form = $('final-form') as HTMLFormElement;
  const errorBox = $('form-error');
  const errorText = $('form-error-text');
  const submitBtn = $('submit-btn') as HTMLButtonElement;
  const materiaInput = $('materia_search') as HTMLInputElement;
  const profesor = $('profesor') as HTMLInputElement;
  const comentario = $('comentario') as HTMLTextAreaElement;
  const anioViejo = $('anio-viejo') as HTMLSelectElement;
  const yr = $('materia-yr');
  const original = submitBtn.innerHTML;
  const CLAVE = 'borradorFinal';

  let mesa = '';
  let anio = '';
  const elegir = (attr: string, valor: string) => {
    document.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => {
      const on = b.getAttribute(attr) === valor;
      b.setAttribute('aria-checked', String(on));
      b.setAttribute('aria-pressed', String(on));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-mesa]').forEach((b) => b.addEventListener('click', () => { mesa = b.dataset.mesa || ''; elegir('data-mesa', mesa); guardar(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-anio]').forEach((b) => b.addEventListener('click', () => { anio = b.dataset.anio || ''; elegir('data-anio', anio); anioViejo.classList.toggle('hidden', anio !== 'antes'); guardar(); }));
  anio = document.querySelector<HTMLButtonElement>('[data-anio][aria-checked="true"]')?.dataset.anio || '';

  const opcionMateria = () => Array.from(document.querySelectorAll<HTMLOptionElement>('#lista-materias option')).find((o) => o.value === materiaInput.value) || null;
  const pintarMateria = () => {
    const o = opcionMateria();
    yr.className = o ? `yr y${o.dataset.nivel}` : 'yr hidden';
    yr.textContent = o ? `${o.dataset.nivel}.º` : '';
  };
  materiaInput.addEventListener('input', () => { pintarMateria(); guardar(); });

  // Borrador en este navegador
  let timer: number | undefined;
  function guardar() {
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      try { localStorage.setItem(CLAVE, JSON.stringify({ materia: materiaInput.value, mesa, anio, viejo: anioViejo.value, profesor: profesor.value, comentario: comentario.value, t: Date.now() })); } catch {}
      $('draft-note').textContent = 'Borrador guardado';
    }, 400);
  }
  try {
    const b = JSON.parse(localStorage.getItem(CLAVE) || 'null');
    if (b && (b.comentario || '').trim()) {
      if (!materiaInput.value) materiaInput.value = b.materia || '';
      if (b.mesa) { mesa = b.mesa; elegir('data-mesa', mesa); }
      if (b.anio) { anio = b.anio; elegir('data-anio', anio); anioViejo.classList.toggle('hidden', anio !== 'antes'); }
      if (b.viejo) anioViejo.value = b.viejo;
      profesor.value = b.profesor || '';
      comentario.value = b.comentario || '';
      $('draft-note').textContent = 'Recuperamos tu borrador';
    }
  } catch {}
  pintarMateria();
  const contar = () => { $('contador').textContent = String(comentario.value.length); };
  contar();
  [profesor, comentario, anioViejo].forEach((x) => x.addEventListener('input', () => { contar(); guardar(); }));

  const mostrarError = (texto: string) => {
    errorText.textContent = texto;
    errorBox.classList.remove('hidden');
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    const materia_id = opcionMateria()?.dataset.id || '';
    const anioFinal = anio === 'antes' ? anioViejo.value : anio;
    if (!materia_id) return mostrarError('Elegí una materia de la lista.');
    if (!mesa) return mostrarError('Elegí la mesa.');
    if (!anioFinal) return mostrarError('Elegí el año en que rendiste.');
    if (comentario.value.trim().length < 10) return mostrarError('Contá tu experiencia en al menos 10 caracteres.');

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spin"></span> Publicando…';
    try {
      const response = await fetch('/api/finales/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ materia_id, anio: anioFinal, mesa, profesor_nombre: profesor.value.trim(), comentario: comentario.value }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Ocurrió un error al guardar.');
      try { localStorage.removeItem(CLAVE); } catch {}
      window.location.href = `/finales?materia=${materia_id}`;
    } catch (err: any) {
      mostrarError(err.message);
      submitBtn.disabled = false;
      submitBtn.innerHTML = original;
    }
  });
</script>
