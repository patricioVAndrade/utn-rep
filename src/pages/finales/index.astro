---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ShareButton from '../../components/ShareButton.astro';
import Quien from '../../components/Quien.astro';
import { DIBUJOS, claseColor } from '../../lib/perfil';
import { autoresDeFinales } from '../../lib/fichas';
import { supabase, createSupabaseServerClient } from '../../lib/supabase';
import { isAdmin } from '../../lib/admin';
import { fechaHora, mesaTexto, tiempoRelativo } from '../../lib/format';
import { buscarProfesor, indexar } from '../../lib/importar';

const user = Astro.locals.user;
const userIsAdmin = isAdmin(user?.id);

const utiles = Astro.url.searchParams.get('orden') === 'utiles';

// Experiencias de finales: la vista pública no tiene user_id ni el nombre de los anónimos.
// Cuáles son tuyas se pregunta aparte, con tu sesión (cada uno lee solo las suyas).
const { data: experiencias } = await supabase
  .from('experiencias_finales_publicas')
  .select(`
    id,
    es_anonima,
    nombre_usuario,
    anio,
    mesa,
    profesor_nombre,
    comentario,
    created_at,
    votos_utilidad,
    materias ( id, nombre, nivel )
  `)
  .order(utiles ? 'votos_utilidad' : 'created_at', { ascending: false })
  .order('created_at', { ascending: false });

// "Tomado por": si el nombre coincide con un profesor cargado, va con link a su página
const { data: profesores } = await supabase.from('profesores').select('id, nombre_completo').range(0, 19999);
const indiceProf = indexar(profesores || []);
const profDe = new Map<string, number | null>();
const profesorId = (nombre?: string | null) => {
  if (!nombre || nombre.trim().length < 3) return null;
  if (!profDe.has(nombre)) profDe.set(nombre, buscarProfesor(nombre, indiceProf).profesor_id);
  return profDe.get(nombre) ?? null;
};

let mias = new Set<string>();
let votadas = new Set<string>();
if (user) {
  const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });
  const [{ data }, { data: votos }] = await Promise.all([
    client.from('experiencias_finales').select('id').eq('user_id', user.id),
    client.from('votos_finales').select('final_id').eq('user_id', user.id),
  ]);
  mias = new Set((data || []).map((x: any) => String(x.id)));
  votadas = new Set((votos || []).map((x: any) => String(x.final_id)));
}

// Respuestas de la moderación (públicas, migración 4)
const { data: respuestasRaw } = await supabase.from('respuestas_moderador').select('final_id, texto').not('final_id', 'is', null);
const respuestaDe = new Map((respuestasRaw || []).map((r: any) => [String(r.final_id), r.texto as string]));

const autores = await autoresDeFinales((experiencias || []).filter((e: any) => !e.es_anonima).map((e: any) => e.id));
const listaExperiencias = (experiencias || []).map((exp: any) => ({
  ...exp,
  respuesta: respuestaDe.get(String(exp.id)) || null,
  materia: Array.isArray(exp.materias) ? exp.materias[0] : exp.materias,
  profesor_id: profesorId(exp.profesor_nombre),
}));

// Mesas para filtrar (lo guardado es "Diciembre", "Febrero", "Julio" o "Especial")
const MESAS = [
  { valor: 'diciembre', label: 'Diciembre' },
  { valor: 'febrero', label: 'Febrero / Marzo' },
  { valor: 'julio', label: 'Julio' },
  { valor: 'especial', label: 'Especial' },
];
const claveMesa = (mesa?: string | null) => {
  const k = (mesa || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().split(/[\s/]+/)[0];
  return MESAS.some((m) => m.valor === k) ? k : 'otra';
};

// Materias con experiencias, para el selector y el ranking del costado
const conteo = new Map<number, { id: number; nombre: string; n: number }>();
listaExperiencias.forEach((exp: any) => {
  if (!exp.materia?.id) return;
  const c = conteo.get(exp.materia.id) ?? { id: exp.materia.id, nombre: exp.materia.nombre, n: 0 };
  c.n++;
  conteo.set(exp.materia.id, c);
});
const materiasConFinales = [...conteo.values()].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
// Experiencia destacada: la más votada, desde 3 votos (como la reseña destacada del inicio)
const destacada = [...listaExperiencias].sort((a: any, b: any) => (b.votos_utilidad || 0) - (a.votos_utilidad || 0))[0];
const hayDestacada = !!destacada && (destacada.votos_utilidad || 0) >= 3;
const recortar = (t: string, n = 140) => (t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t);

const materiaParam = Astro.url.searchParams.get('materia') || '';
const mesaParam = (Astro.url.searchParams.get('mesa') || '').toLowerCase();
const materiaInicial = conteo.has(Number(materiaParam)) ? materiaParam : '';
const mesaInicial = MESAS.some((m) => m.valor === mesaParam) ? mesaParam : '';
---

<Layout title="Experiencias de finales - UTN REP" tab="finales" crumbs={[{ label: 'Experiencias de finales' }]}>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>Experiencias de finales</h1>
          <p>Cómo toman en cada mesa, qué temas salen y cómo prepararte para rendir.</p>
        </div>
        <div class="actions">
          {user
            ? <a class="btn primary" href="/finales/nuevo"><Icon name="pen" /> Compartir mi experiencia</a>
            : <button type="button" class="btn primary" data-login><Icon name="pen" /> Compartir mi experiencia</button>}
        </div>
      </div>

      {Astro.url.searchParams.get('publicada') === '1' && (
        <div class="notice ok publicada" role="status">
          <Icon name="check" />
          <div>
            <b>Tu experiencia ya está publicada.</b>
            <p class="cafe-linea en-aviso"><Icon name="cup" /> ¿Te sirvió UTN REP? <a href="https://cafecito.app/utnrep" target="_blank" rel="noopener noreferrer">Invitame un cafecito</a></p>
          </div>
        </div>
      )}

      <div id="borrador-final" class="notice soft hidden" role="status">
        <Icon name="pen" />
        <span>Tenés una experiencia sin publicar<span data-materia></span>. <a href="/finales/nuevo">Seguirla</a> · <button type="button" class="linklike" data-borrar-borrador>Borrarla</button></span>
      </div>

      <div id="finales-nuevas" class="notice soft hidden" role="status">
        <Icon name="info" />
        <span><b></b> desde tu última visita (<span data-desde></span>). Están marcadas con "Nueva".</span>
      </div>

      {listaExperiencias.length > 0 && (
        <div class="filters">
          <span class="sub" id="mesa-label">Mesa:</span>
          <div class="seg" role="group" aria-labelledby="mesa-label">
            <button type="button" data-mesa="" aria-pressed={mesaInicial === '' ? 'true' : 'false'}>Todas</button>
            {MESAS.map((m) => <button type="button" data-mesa={m.valor} aria-pressed={mesaInicial === m.valor ? 'true' : 'false'}>{m.label}</button>)}
          </div>
          <span class="seg orden" role="group" aria-label="Orden">
            <button type="button" data-orden="recientes" aria-pressed={utiles ? 'false' : 'true'}>Más recientes</button>
            <button type="button" data-orden="utiles" aria-pressed={utiles ? 'true' : 'false'}>Más útiles</button>
          </span>
          <span class="fmat">
            <label class="sr" for="filtro-materia">Materia</label>
            <select id="filtro-materia" class="mini">
              <option value="">Todas las materias</option>
              {materiasConFinales.map((m) => <option value={m.id} selected={materiaInicial === String(m.id)}>{m.nombre} ({m.n})</option>)}
            </select>
            <label class="sr" for="buscar-materia">Buscar materia</label>
            <input type="search" id="buscar-materia" class="ainput sm" placeholder="Buscar materia" autocomplete="off" />
          </span>
        </div>
      )}

      <div id="finales-container" style="display:grid;gap:12px">
        {listaExperiencias.length > 0 ? (
          listaExperiencias.map((exp: any, idx: number) => {
            const isOwner = mias.has(String(exp.id));
            return (
              <article
                class:list={['post exp final-card', { hidden: idx >= 10 || (materiaInicial && String(exp.materia?.id) !== materiaInicial) || (mesaInicial && claveMesa(exp.mesa) !== mesaInicial) }]}
                id={`final-${exp.id}`}
                data-materia-id={exp.materia?.id}
                data-mesa={claveMesa(exp.mesa)}
                data-id={exp.id}
                data-creado={exp.created_at}
                data-votos={exp.votos_utilidad || 0}
                data-materia-nombre={exp.materia?.nombre || ''}
              >
                <div class="post-head">
                  <span>
                    {exp.materia?.nivel && <span class:list={['yr', `y${exp.materia.nivel}`]}>{exp.materia.nivel}.º</span>}{' '}
                    <a href={`/materia/${exp.materia?.id}`}>{exp.materia?.nombre}</a>
                    <span class="nuevo-tag hidden" data-nueva>Nueva</span>
                  </span>
                  <span class="mesa">{mesaTexto(exp.mesa, exp.anio)}</span>
                </div>
                <div class="post-main">
                  <div class="author">
                    {(() => {
                      const a = exp.es_anonima === false && exp.nombre_usuario ? autores.get(exp.id) : undefined;
                      const dib = a?.foto === 'dibujo' ? DIBUJOS.find((d) => d.id === a.dibujo) || DIBUJOS[0] : null;
                      return (
                        <div class="avatar" aria-hidden="true">
                          <span class:list={[{ draw: !!dib }, a && !a.google ? claseColor(a.color) : '']}>{!a
                            ? <Icon name="user" />
                            : a.google
                              ? <img src={a.google} alt="" referrerpolicy="no-referrer" loading="lazy" />
                              : dib
                                ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={dib.svg} />
                                : exp.nombre_usuario.charAt(0).toUpperCase()}</span>
                        </div>
                      );
                    })()}
                    <Quien nombre={exp.nombre_usuario || 'Anónimo'} anonimo={exp.es_anonima !== false || !exp.nombre_usuario} ficha={autores.get(exp.id)?.ficha} />
                    <time class="sub" datetime={exp.created_at} title={tiempoRelativo(exp.created_at)}>{fechaHora(exp.created_at)}</time>
                  </div>
                  <div class="message">
                    <div class="kv">
                      <span class="tag">Tomado por: {exp.profesor_id
                        ? <a href={`/profesor/${exp.profesor_id}`}>{exp.profesor_nombre}</a>
                        : <b>{exp.profesor_nombre || 'No lo indicó'}</b>}</span>
                    </div>
                    <p class="exp-comment">{exp.comentario}</p>
                    {exp.respuesta && <div class="mod"><b>Respuesta del moderador</b>{exp.respuesta}</div>}
                    {isOwner && (
                      <div class="exp-edit-form hidden">
                        <label class="sr" for={`edit-final-${exp.id}`}>Editar experiencia</label>
                        <textarea id={`edit-final-${exp.id}`} class="edit-textarea" rows="4" maxlength="1000">{exp.comentario}</textarea>
                        <div class="edit-acts">
                          <button type="button" class="save-edit-btn btn primary">Guardar</button>
                          <button type="button" class="cancel-edit-btn btn quiet">Cancelar</button>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                <div class="post-tools">
                  <div class="group">
                    {!isOwner && (
                      <button type="button" class:list={['btn', votadas.has(String(exp.id)) ? 'pressed' : 'quiet']} data-votar-final
                        aria-pressed={votadas.has(String(exp.id)) ? 'true' : 'false'} data-login={user ? undefined : ''}
                        title={user ? 'Marcar como útil' : 'Iniciá sesión para votar'}>
                        <Icon name="thumb" /> Me sirvió <span class="votos-count">{exp.votos_utilidad || 0}</span>
                      </button>
                    )}
                    {isOwner && (exp.votos_utilidad || 0) > 0 && <span class="sub">Le sirvió a {exp.votos_utilidad} estudiante{exp.votos_utilidad !== 1 ? 's' : ''}</span>}
                    {!isOwner && <button type="button" class="btn quiet reportar" data-reportar-final data-login={user ? undefined : ''} title="Reportar esta experiencia"><Icon name="flag" /> Reportar</button>}
                    <ShareButton mini titulo="Mirá cómo tomaron este final en UTN REP" ruta={`/finales?materia=${exp.materia?.id}#final-${exp.id}`} />
                  </div>
                  {(isOwner || userIsAdmin) && (
                    <div class="group">
                      {isOwner && <button type="button" class="edit-btn btn quiet"><Icon name="edit" /> Editar</button>}
                      <button type="button" class="delete-btn btn danger"><Icon name="trash" /> Eliminar</button>
                    </div>
                  )}
                </div>
              </article>
            );
          })
        ) : (
          <div class="empty">
            <h2>Todavía no hay experiencias</h2>
            <span>¿Rendiste un final? Sé la primera persona en contarlo.</span>
          </div>
        )}
        <div id="finales-vacio" class="empty hidden">
          <span>Todavía nadie contó un final con esos filtros.</span>
          {user
            ? <a class="btn primary" href="/finales/nuevo"><Icon name="pen" /> Compartir mi experiencia</a>
            : <button type="button" class="btn primary" data-login><Icon name="pen" /> Compartir mi experiencia</button>}
        </div>
      </div>

      {listaExperiencias.length > 10 && (
        <div><button id="show-more-btn" type="button" class="btn secondary">Ver más experiencias</button></div>
      )}
    </div>

    <aside class="side">
      <section class="panel cta">
        <h3>¿Ya rendiste?</h3>
        <div class="in">
          <span>Contá cómo fue la mesa.</span>
          {user
            ? <a class="btn primary big" href="/finales/nuevo"><Icon name="pen" /> Compartir mi experiencia</a>
            : <button type="button" class="btn primary big" data-login><Icon name="user" /> Iniciar sesión para contarlo</button>}
        </div>
      </section>

      {hayDestacada && (
        <section class="panel destacada">
          <h3><Icon name="thumb" /> Experiencia destacada</h3>
          <div class="in">
            <a href={`#final-${destacada.id}`} data-ir-final={destacada.id}><b>{destacada.materia?.nombre}</b></a>
            <span class="sub">{mesaTexto(destacada.mesa, destacada.anio)}</span>
            <blockquote class="quote-mini">"{recortar(destacada.comentario || '')}"</blockquote>
            <span class="sub">Le sirvió a <b>{destacada.votos_utilidad} estudiante{destacada.votos_utilidad !== 1 ? 's' : ''}</b>.</span>
          </div>
        </section>
      )}

      <section class="panel cafe">
        <h3>Bancá UTN REP</h3>
        <div class="in">
          <span>¿Te sirvió para preparar el final? Ayudá a mantener UTN REP online.</span>
          <a class="btn cafe big" href="https://cafecito.app/utnrep" target="_blank" rel="noopener noreferrer"><Icon name="cup" /> Invitame un cafecito</a>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  import { visitaAnterior, textoVisita } from '../../scripts/visitas';
  import { coincide, palabrasDe, parecido } from '../../lib/buscar';
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.final-card'));

  // Borrador sin publicar (se guarda en este navegador mientras escribís)
  const avisoBorrador = document.getElementById('borrador-final');
  try {
    const b = JSON.parse(localStorage.getItem('borradorFinal') || 'null');
    if (avisoBorrador && b && (b.comentario || b.materia)) {
      const m = String(b.materia || '').replace(/\s*\(\d\.º año\)$/, '');
      if (m) avisoBorrador.querySelector('[data-materia]')!.textContent = ` de ${m}`;
      avisoBorrador.classList.remove('hidden');
      avisoBorrador.querySelector('[data-borrar-borrador]')?.addEventListener('click', () => {
        if (!confirm('¿Borrar el borrador?')) return;
        try { localStorage.removeItem('borradorFinal'); } catch {}
        avisoBorrador.classList.add('hidden');
      });
    }
  } catch { /* sin almacenamiento */ }

  // "Nueva": contadas después de tu visita anterior
  const anterior = visitaAnterior();
  if (anterior) {
    const nuevas = cards.filter((c) => new Date(c.dataset.creado || 0).getTime() > anterior);
    nuevas.forEach((c) => c.querySelector('[data-nueva]')?.classList.remove('hidden'));
    const aviso = document.getElementById('finales-nuevas');
    if (aviso && nuevas.length) {
      aviso.querySelector('b')!.textContent = `${nuevas.length} experiencia${nuevas.length !== 1 ? 's' : ''} nueva${nuevas.length !== 1 ? 's' : ''}`;
      aviso.querySelector('[data-desde]')!.textContent = textoVisita(anterior);
      aviso.classList.remove('hidden');
    }
  }
  const cont = document.getElementById('finales-container')!;
  const showMoreBtn = document.getElementById('show-more-btn') as HTMLButtonElement | null;
  const vacio = document.getElementById('finales-vacio');
  const selMateria = document.getElementById('filtro-materia') as HTMLSelectElement | null;
  const buscarMateria = document.getElementById('buscar-materia') as HTMLInputElement | null;
  const botonesMesa = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg [data-mesa]'));
  const botonesOrden = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg [data-orden]'));
  let mesa = botonesMesa.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.mesa || '';
  let orden = botonesOrden.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.orden || 'recientes';
  let mostrar = 10;
  // Link directo a una experiencia: que se vea aunque esté más abajo
  const destino = location.hash.startsWith('#final-') ? document.getElementById(location.hash.slice(1)) : null;

  function ordenar() {
    const creado = (c: HTMLElement) => c.dataset.creado || '';
    [...cards]
      .sort((a, b) => (orden === 'utiles' ? Number(b.dataset.votos) - Number(a.dataset.votos) : 0) || creado(b).localeCompare(creado(a)))
      .forEach((c) => cont.insertBefore(c, vacio));
  }

  // Mesa, orden, materia y buscador se combinan (y quedan en la dirección, para compartir el link)
  function aplicar() {
    const materia = selMateria?.value || '';
    const palabras = palabrasDe(buscarMateria?.value || '');
    const deMateria = (nombre: string) => !palabras.length || coincide(palabras, nombre) || parecido(palabras, nombre) !== null;
    const enOrden = Array.from(cont.querySelectorAll<HTMLElement>('.final-card'));
    const coinciden = enOrden.filter((c) =>
      (!materia || c.dataset.materiaId === materia) && (!mesa || c.dataset.mesa === mesa) && deMateria(c.dataset.materiaNombre || ''));
    if (destino && coinciden.indexOf(destino) >= mostrar) mostrar = coinciden.indexOf(destino) + 1;
    const visibles = new Set(coinciden.slice(0, mostrar));
    enOrden.forEach((c) => c.classList.toggle('hidden', !visibles.has(c)));
    if (showMoreBtn) showMoreBtn.style.display = coinciden.length > mostrar ? '' : 'none';
    vacio?.classList.toggle('hidden', coinciden.length > 0 || cards.length === 0);
    const url = new URL(location.href);
    materia ? url.searchParams.set('materia', materia) : url.searchParams.delete('materia');
    mesa ? url.searchParams.set('mesa', mesa) : url.searchParams.delete('mesa');
    orden === 'utiles' ? url.searchParams.set('orden', 'utiles') : url.searchParams.delete('orden');
    history.replaceState(null, '', url);
  }

  botonesMesa.forEach((b) => b.addEventListener('click', () => {
    mesa = b.dataset.mesa || '';
    botonesMesa.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    mostrar = 10;
    aplicar();
  }));
  botonesOrden.forEach((b) => b.addEventListener('click', () => {
    orden = b.dataset.orden || 'recientes';
    botonesOrden.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    ordenar();
    mostrar = 10;
    aplicar();
  }));
  selMateria?.addEventListener('change', () => { mostrar = 10; aplicar(); });
  buscarMateria?.addEventListener('input', () => { mostrar = 10; aplicar(); });
  document.querySelectorAll<HTMLAnchorElement>('[data-ir-final]').forEach((a) => a.addEventListener('click', (e) => {
    const card = document.getElementById(`final-${a.dataset.irFinal}`);
    if (!card) return;
    e.preventDefault();
    if (selMateria) selMateria.value = '';
    if (buscarMateria) buscarMateria.value = '';
    mesa = '';
    botonesMesa.forEach((o) => o.setAttribute('aria-pressed', String(!o.dataset.mesa)));
    const i = Array.from(cont.querySelectorAll('.final-card')).indexOf(card);
    mostrar = Math.max(10, i + 1);
    aplicar();
    card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  aplicar();
  if (destino) destino.scrollIntoView();

  // Ver más, de a 10
  showMoreBtn?.addEventListener('click', () => { mostrar += 10; aplicar(); });

  // Me sirvió y Reportar (sin sesión, data-login abre la ventana de ingreso)
  cards.forEach((card) => {
    const id = card.getAttribute('data-id');
    const voto = card.querySelector<HTMLButtonElement>('[data-votar-final]');
    if (voto && !voto.hasAttribute('data-login')) voto.addEventListener('click', async () => {
      const votar = voto.getAttribute('aria-pressed') !== 'true';
      voto.disabled = true;
      try {
        const res = await fetch('/api/finales/votar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ final_id: id, accion: votar ? 'votar' : 'desvotar' }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'No se pudo votar.');
        voto.setAttribute('aria-pressed', String(votar));
        voto.classList.toggle('pressed', votar);
        voto.classList.toggle('quiet', !votar);
        voto.querySelector('.votos-count')!.textContent = String(data.votos ?? 0);
      } catch (e) {
        alert((e as Error).message);
      } finally {
        voto.disabled = false;
      }
    });
    const rep = card.querySelector<HTMLButtonElement>('[data-reportar-final]');
    if (rep && !rep.hasAttribute('data-login')) rep.addEventListener('click', async () => {
      const motivo = prompt('¿Por qué la reportás? (por ejemplo: insultos, datos personales, no es sobre el final)');
      if (motivo === null) return;
      rep.disabled = true;
      try {
        const res = await fetch('/api/finales/reportar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ final_id: id, motivo: motivo.trim() || 'Contenido inapropiado' }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok && res.status !== 409) throw new Error(data.error || 'No se pudo reportar.');
        rep.innerHTML = '';
        rep.textContent = res.status === 409 ? 'Ya la reportaste' : 'Reportada, gracias';
      } catch (e) {
        alert((e as Error).message);
        rep.disabled = false;
      }
    });
  });

  // Editar y eliminar
  cards.forEach((card) => {
    const editBtn = card.querySelector('.edit-btn');
    const deleteBtn = card.querySelector('.delete-btn') as HTMLButtonElement | null;
    const expComment = card.querySelector('.exp-comment') as HTMLElement | null;
    const expEditForm = card.querySelector('.exp-edit-form') as HTMLElement | null;
    const textarea = card.querySelector('.edit-textarea') as HTMLTextAreaElement | null;
    const saveBtn = card.querySelector('.save-edit-btn') as HTMLButtonElement | null;
    const cancelBtn = card.querySelector('.cancel-edit-btn');
    const expId = card.getAttribute('data-id');

    deleteBtn?.addEventListener('click', async () => {
      if (!confirm('¿Seguro que querés eliminar esta experiencia?')) return;
      deleteBtn.disabled = true;
      try {
        const res = await fetch('/api/finales/acciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'eliminar', id: expId }),
        });
        if (res.ok) card.remove();
        else { alert('No se pudo eliminar.'); deleteBtn.disabled = false; }
      } catch (error) {
        console.error(error);
        deleteBtn.disabled = false;
      }
    });

    editBtn?.addEventListener('click', () => {
      expComment?.classList.add('hidden');
      expEditForm?.classList.remove('hidden');
    });

    cancelBtn?.addEventListener('click', () => {
      expEditForm?.classList.add('hidden');
      expComment?.classList.remove('hidden');
      if (textarea && expComment) textarea.value = expComment.textContent || '';
    });

    saveBtn?.addEventListener('click', async () => {
      if (!textarea) return;
      const nuevo = textarea.value.trim();
      saveBtn.disabled = true;
      try {
        const res = await fetch('/api/finales/acciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'editar', id: expId, comentario: nuevo }),
        });
        if (res.ok) {
          if (expComment) expComment.textContent = nuevo;
          expEditForm?.classList.add('hidden');
          expComment?.classList.remove('hidden');
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'No se pudo editar.');
        }
      } catch (error) {
        console.error(error);
      } finally {
        saveBtn.disabled = false;
      }
    });
  });
</script>
