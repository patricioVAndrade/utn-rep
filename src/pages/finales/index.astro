---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ShareButton from '../../components/ShareButton.astro';
import { supabase } from '../../lib/supabase';
import { isAdmin } from '../../lib/admin';
import { anioLabel, mesaTexto, tiempoRelativo } from '../../lib/format';
import { buscarProfesor, indexar } from '../../lib/importar';

const user = Astro.locals.user;
const userIsAdmin = isAdmin(user?.id);

// Experiencias de finales (user_id se usa solo acá en el servidor, para saber cuáles son tuyas)
const { data: experiencias } = await supabase
  .from('experiencias_finales')
  .select(`
    id,
    user_id,
    anio,
    mesa,
    profesor_nombre,
    comentario,
    created_at,
    materias ( id, nombre, nivel )
  `)
  .order('created_at', { ascending: false });

// "Tomado por": si el nombre coincide con un profesor cargado, va con link a su página
const { data: profesores } = await supabase.from('profesores').select('id, nombre_completo').range(0, 19999);
const indiceProf = indexar(profesores || []);
const profDe = new Map<string, number | null>();
const profesorId = (nombre?: string | null) => {
  if (!nombre || nombre.trim().length < 3) return null;
  if (!profDe.has(nombre)) profDe.set(nombre, buscarProfesor(nombre, indiceProf).profesor_id);
  return profDe.get(nombre) ?? null;
};

const listaExperiencias = (experiencias || []).map((exp: any) => ({
  ...exp,
  materia: Array.isArray(exp.materias) ? exp.materias[0] : exp.materias,
  profesor_id: profesorId(exp.profesor_nombre),
}));
const reportar = (exp: any) => `mailto:patriciovandrade@gmail.com?subject=${encodeURIComponent(`Reporte de experiencia de final #${exp.id}`)}&body=${encodeURIComponent(`Experiencia de ${exp.materia?.nombre || 'una materia'} (${mesaTexto(exp.mesa, exp.anio)}).\nMotivo: `)}`;

// Mesas para filtrar (lo guardado es "Diciembre", "Febrero", "Julio" o "Especial")
const MESAS = [
  { valor: 'diciembre', label: 'Diciembre' },
  { valor: 'febrero', label: 'Febrero / marzo' },
  { valor: 'julio', label: 'Julio' },
  { valor: 'especial', label: 'Especial' },
];
const claveMesa = (mesa?: string | null) => {
  const k = (mesa || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().split(/[\s/]+/)[0];
  return MESAS.some((m) => m.valor === k) ? k : 'otra';
};

// Materias con experiencias, para el selector y el ranking del costado
const conteo = new Map<number, { id: number; nombre: string; n: number }>();
listaExperiencias.forEach((exp: any) => {
  if (!exp.materia?.id) return;
  const c = conteo.get(exp.materia.id) ?? { id: exp.materia.id, nombre: exp.materia.nombre, n: 0 };
  c.n++;
  conteo.set(exp.materia.id, c);
});
const materiasConFinales = [...conteo.values()].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const masContadas = [...conteo.values()].sort((a, b) => b.n - a.n).slice(0, 5);

const materiaParam = Astro.url.searchParams.get('materia') || '';
const mesaParam = (Astro.url.searchParams.get('mesa') || '').toLowerCase();
const materiaInicial = conteo.has(Number(materiaParam)) ? materiaParam : '';
const mesaInicial = MESAS.some((m) => m.valor === mesaParam) ? mesaParam : '';
---

<Layout title="Experiencias de finales - UTN REP" tab="finales" crumbs={[{ label: 'Experiencias de finales' }]}>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>Experiencias de finales</h1>
          <p>Cómo toman en cada mesa, qué temas salen y cómo prepararte para rendir.</p>
        </div>
        <div class="actions">
          {user
            ? <a class="btn primary" href="/finales/nuevo"><Icon name="pen" /> Contar mi experiencia de final</a>
            : <button type="button" class="btn primary" data-login><Icon name="pen" /> Contar mi experiencia de final</button>}
        </div>
      </div>

      <div id="finales-nuevas" class="notice soft hidden" role="status">
        <Icon name="info" />
        <span><b></b> desde tu última visita (<span data-desde></span>). Están marcadas con "Nueva".</span>
      </div>

      {listaExperiencias.length > 0 && (
        <div class="filters">
          <span class="sub" id="mesa-label">Mesa:</span>
          <div class="seg" role="group" aria-labelledby="mesa-label">
            <button type="button" data-mesa="" aria-pressed={mesaInicial === '' ? 'true' : 'false'}>Todas</button>
            {MESAS.map((m) => <button type="button" data-mesa={m.valor} aria-pressed={mesaInicial === m.valor ? 'true' : 'false'}>{m.label}</button>)}
          </div>
          <label class="sr" for="filtro-materia">Materia</label>
          <select id="filtro-materia" class="mini">
            <option value="">Todas las materias</option>
            {materiasConFinales.map((m) => <option value={m.id} selected={materiaInicial === String(m.id)}>{m.nombre} ({m.n})</option>)}
          </select>
        </div>
      )}

      <div id="finales-container" style="display:grid;gap:12px">
        {listaExperiencias.length > 0 ? (
          listaExperiencias.map((exp: any, idx: number) => {
            const isOwner = user?.id === exp.user_id;
            return (
              <article
                class:list={['post exp final-card', { 'final-extra': idx >= 10 }, { hidden: idx >= 10 || (materiaInicial && String(exp.materia?.id) !== materiaInicial) || (mesaInicial && claveMesa(exp.mesa) !== mesaInicial) }]}
                id={`final-${exp.id}`}
                data-materia-id={exp.materia?.id}
                data-mesa={claveMesa(exp.mesa)}
                data-id={exp.id}
                data-creado={exp.created_at}
              >
                <div class="post-head">
                  <span>
                    {exp.materia?.nivel && <span class:list={['yr', `y${exp.materia.nivel}`]}>{exp.materia.nivel}.º</span>}{' '}
                    <a href={`/materia/${exp.materia?.id}`}>{exp.materia?.nombre}</a>
                    <span class="nuevo-tag hidden" data-nueva>Nueva</span>
                  </span>
                  <span class="mesa">{mesaTexto(exp.mesa, exp.anio)}</span>
                </div>
                <div class="post-main">
                  <div class="author">
                    <div class="avatar" aria-hidden="true"><span><Icon name="user" /></span></div>
                    <span class="uname anon">Anónimo</span>
                    <span class="sub">{isOwner ? 'La contaste vos' : `Contada ${tiempoRelativo(exp.created_at).toLowerCase()}`}</span>
                  </div>
                  <div class="message">
                    <div class="kv">
                      <span class="tag">Tomado por: {exp.profesor_id
                        ? <a href={`/profesor/${exp.profesor_id}`}>{exp.profesor_nombre}</a>
                        : <b>{exp.profesor_nombre || 'No lo indicó'}</b>}</span>
                    </div>
                    <p class="exp-comment">{exp.comentario}</p>
                    {isOwner && (
                      <div class="exp-edit-form hidden">
                        <label class="sr" for={`edit-final-${exp.id}`}>Editar experiencia</label>
                        <textarea id={`edit-final-${exp.id}`} class="edit-textarea" rows="4" maxlength="1000">{exp.comentario}</textarea>
                        <div class="edit-acts">
                          <button type="button" class="save-edit-btn btn primary">Guardar</button>
                          <button type="button" class="cancel-edit-btn btn quiet">Cancelar</button>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                <div class="post-tools">
                  <div class="group">
                    {!isOwner && <a class="btn quiet" href={reportar(exp)} title="Reportar esta experiencia"><Icon name="flag" /> Reportar</a>}
                    <ShareButton mini titulo="Mirá cómo tomaron este final en UTN REP" ruta={`/finales?materia=${exp.materia?.id}#final-${exp.id}`} />
                  </div>
                  {(isOwner || userIsAdmin) && (
                    <div class="group">
                      {isOwner && <button type="button" class="edit-btn btn quiet"><Icon name="edit" /> Editar</button>}
                      <button type="button" class="delete-btn btn danger"><Icon name="trash" /> Eliminar</button>
                    </div>
                  )}
                </div>
              </article>
            );
          })
        ) : (
          <div class="empty">
            <h2>Todavía no hay experiencias</h2>
            <span>¿Rendiste un final? Sé la primera persona en contarlo.</span>
          </div>
        )}
        <div id="finales-vacio" class="empty hidden">
          <span>Todavía nadie contó un final con esos filtros.</span>
          {user
            ? <a class="btn primary" href="/finales/nuevo"><Icon name="pen" /> Contar mi experiencia de final</a>
            : <button type="button" class="btn primary" data-login><Icon name="pen" /> Contar mi experiencia de final</button>}
        </div>
      </div>

      {listaExperiencias.length > 10 && (
        <div><button id="show-more-btn" type="button" class="btn secondary">Ver más experiencias</button></div>
      )}
    </div>

    <aside class="side">
      <section class="panel cta">
        <h3>¿Ya rendiste?</h3>
        <div class="in">
          <span>Contá cómo fue la mesa: qué tomaron, si fue más difícil el práctico o el teórico y cómo te preparaste.</span>
          {user
            ? <a class="btn primary big" href="/finales/nuevo"><Icon name="pen" /> Contar mi experiencia de final</a>
            : <button type="button" class="btn primary big" data-login><Icon name="user" /> Iniciar sesión para contarlo</button>}
        </div>
      </section>

      {masContadas.length > 0 && (
        <section class="panel">
          <h3>Materias con más experiencias</h3>
          <div class="in feed">
            {masContadas.map((m) => (
              <div>
                <a href={`/finales?materia=${m.id}`} data-filtrar-materia={m.id}>{m.nombre}</a>
                <span class="sub">{m.n} experiencia{m.n !== 1 ? 's' : ''}</span>
              </div>
            ))}
          </div>
        </section>
      )}
    </aside>
  </div>
</Layout>

<script>
  import { visitaAnterior, textoVisita } from '../../scripts/visitas';
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.final-card'));

  // "Nueva": contadas después de tu visita anterior
  const anterior = visitaAnterior();
  if (anterior) {
    const nuevas = cards.filter((c) => new Date(c.dataset.creado || 0).getTime() > anterior);
    nuevas.forEach((c) => c.querySelector('[data-nueva]')?.classList.remove('hidden'));
    const aviso = document.getElementById('finales-nuevas');
    if (aviso && nuevas.length) {
      aviso.querySelector('b')!.textContent = `${nuevas.length} experiencia${nuevas.length !== 1 ? 's' : ''} nueva${nuevas.length !== 1 ? 's' : ''}`;
      aviso.querySelector('[data-desde]')!.textContent = textoVisita(anterior);
      aviso.classList.remove('hidden');
    }
  }
  // Link directo a una experiencia que estaba plegada
  const destino = location.hash.startsWith('#final-') ? document.getElementById(location.hash.slice(1)) : null;
  if (destino?.classList.contains('final-extra')) { destino.classList.remove('hidden', 'final-extra'); destino.scrollIntoView(); }
  const showMoreBtn = document.getElementById('show-more-btn') as HTMLButtonElement | null;
  const vacio = document.getElementById('finales-vacio');
  const selMateria = document.getElementById('filtro-materia') as HTMLSelectElement | null;
  const botonesMesa = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg [data-mesa]'));
  let mesa = botonesMesa.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.mesa || '';

  // Filtros por mesa y materia (también quedan en la dirección, para compartir el link)
  function aplicar() {
    const materia = selMateria?.value || '';
    const filtrando = !!(materia || mesa);
    let coinciden = 0;
    cards.forEach((card) => {
      const ok = (!materia || card.dataset.materiaId === materia) && (!mesa || card.dataset.mesa === mesa);
      if (ok) coinciden++;
      card.classList.toggle('hidden', !ok || (!filtrando && card.classList.contains('final-extra')));
    });
    if (showMoreBtn) showMoreBtn.style.display = filtrando || !document.querySelector('.final-extra.hidden') ? 'none' : '';
    vacio?.classList.toggle('hidden', coinciden > 0 || cards.length === 0);
    const url = new URL(location.href);
    materia ? url.searchParams.set('materia', materia) : url.searchParams.delete('materia');
    mesa ? url.searchParams.set('mesa', mesa) : url.searchParams.delete('mesa');
    history.replaceState(null, '', url);
  }

  botonesMesa.forEach((b) => b.addEventListener('click', () => {
    mesa = b.dataset.mesa || '';
    botonesMesa.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    aplicar();
  }));
  selMateria?.addEventListener('change', aplicar);
  document.querySelectorAll<HTMLAnchorElement>('[data-filtrar-materia]').forEach((a) => a.addEventListener('click', (e) => {
    if (!selMateria) return;
    e.preventDefault();
    selMateria.value = a.dataset.filtrarMateria || '';
    aplicar();
    document.querySelector('.filters')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  if (selMateria?.value || mesa) aplicar();

  // Ver más, de a 10
  showMoreBtn?.addEventListener('click', () => {
    const ocultas = document.querySelectorAll('.final-extra.hidden');
    for (let i = 0; i < 10 && i < ocultas.length; i++) {
      ocultas[i].classList.remove('hidden', 'final-extra');
    }
    if (!document.querySelector('.final-extra.hidden')) showMoreBtn.style.display = 'none';
  });

  // Editar y eliminar
  cards.forEach((card) => {
    const editBtn = card.querySelector('.edit-btn');
    const deleteBtn = card.querySelector('.delete-btn') as HTMLButtonElement | null;
    const expComment = card.querySelector('.exp-comment') as HTMLElement | null;
    const expEditForm = card.querySelector('.exp-edit-form') as HTMLElement | null;
    const textarea = card.querySelector('.edit-textarea') as HTMLTextAreaElement | null;
    const saveBtn = card.querySelector('.save-edit-btn') as HTMLButtonElement | null;
    const cancelBtn = card.querySelector('.cancel-edit-btn');
    const expId = card.getAttribute('data-id');

    deleteBtn?.addEventListener('click', async () => {
      if (!confirm('¿Seguro que querés eliminar esta experiencia?')) return;
      deleteBtn.disabled = true;
      try {
        const res = await fetch('/api/finales/acciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'eliminar', id: expId }),
        });
        if (res.ok) card.remove();
        else { alert('No se pudo eliminar.'); deleteBtn.disabled = false; }
      } catch (error) {
        console.error(error);
        deleteBtn.disabled = false;
      }
    });

    editBtn?.addEventListener('click', () => {
      expComment?.classList.add('hidden');
      expEditForm?.classList.remove('hidden');
    });

    cancelBtn?.addEventListener('click', () => {
      expEditForm?.classList.add('hidden');
      expComment?.classList.remove('hidden');
      if (textarea && expComment) textarea.value = expComment.textContent || '';
    });

    saveBtn?.addEventListener('click', async () => {
      if (!textarea) return;
      const nuevo = textarea.value.trim();
      saveBtn.disabled = true;
      try {
        const res = await fetch('/api/finales/acciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'editar', id: expId, comentario: nuevo }),
        });
        if (res.ok) {
          if (expComment) expComment.textContent = nuevo;
          expEditForm?.classList.add('hidden');
          expComment?.classList.remove('hidden');
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'No se pudo editar.');
        }
      } catch (error) {
        console.error(error);
      } finally {
        saveBtn.disabled = false;
      }
    });
  });
</script>
