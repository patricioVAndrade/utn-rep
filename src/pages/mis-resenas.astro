---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { anioLabel, tiempoRelativo } from '../lib/format';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/');

const { client } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });

// RLS: cada usuario solo ve sus propias filas de la tabla base
const { data } = await client
  .from('resenas')
  .select(`
    id, dictado_id, calificacion_general, comentario, es_anonima, votos_utilidad, created_at,
    dictados ( cursos ( identificador ), materias ( nombre, nivel ) )
  `)
  .eq('user_id', user.id)
  .order('created_at', { ascending: false });

const misResenas = (data || []).map((r: any) => {
  const dictado = Array.isArray(r.dictados) ? r.dictados[0] : r.dictados;
  const materia = Array.isArray(dictado?.materias) ? dictado.materias[0] : dictado?.materias;
  const curso = Array.isArray(dictado?.cursos) ? dictado.cursos[0] : dictado?.cursos;
  return { ...r, materia, curso };
});
const votosTotales = misResenas.reduce((acc, r) => acc + (r.votos_utilidad || 0), 0);
---

<Layout title="Mis reseñas - UTN REP" description="Las reseñas que publicaste en UTN REP." tab="mis" crumbs={[{ label: 'Mis reseñas' }]}>
  <div class="layout">
    <div class="main">
      <div class="topic">
        <div>
          <h1>Mis reseñas</h1>
          <p>
            {misResenas.length === 0
              ? 'Todavía no publicaste ninguna reseña.'
              : `Publicaste ${misResenas.length} reseña${misResenas.length !== 1 ? 's' : ''}. Para editarlas o borrarlas, entrá a cada curso.`}
          </p>
        </div>
        <div class="actions"><a class="btn primary" href="/nueva-resena"><Icon name="pen" /> Escribir otra</a></div>
      </div>

      {misResenas.length > 0 ? (
        <div class="mine">
          {misResenas.map((r) => (
            <div class="mine-row">
              <div class="mr-top">
                {r.materia?.nivel && <span class:list={['yr', `y${r.materia.nivel}`]}>{anioLabel(r.materia.nivel)}</span>}
                <a href={`/dictado/${r.dictado_id}#resena-${r.id}`}><b>{r.materia?.nombre || 'Materia'}, {r.curso?.identificador || 'Curso'}</b></a>
                <Stars value={r.calificacion_general} />
              </div>
              <p>{r.comentario}</p>
              <span class="sub">
                {tiempoRelativo(r.created_at)}
                {' · '}{r.es_anonima ? 'Publicada como anónima' : 'Publicada con tu nombre'}
                {' · '}{r.votos_utilidad || 0} persona{(r.votos_utilidad || 0) !== 1 ? 's' : ''} dijeron que les sirvió
              </span>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty">
          <h2>Todavía no escribiste ninguna</h2>
          <span>Contá cómo te fue en una materia que ya cursaste. Lleva dos minutos.</span>
          <a class="btn primary" href="/nueva-resena"><Icon name="pen" /> Escribir mi primera reseña</a>
        </div>
      )}
    </div>

    <aside class="side">
      <section class="panel">
        <h3>Tu actividad</h3>
        <div class="in">
          <div class="kpis">
            <div><b>{misResenas.length}</b><span>reseñas</span></div>
            <div><b>{votosTotales}</b><span>"me sirvió"</span></div>
          </div>
        </div>
      </section>
    </aside>
  </div>
</Layout>
