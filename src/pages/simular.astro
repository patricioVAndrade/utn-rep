---
// MAQUETA (no se sube): cómo se vería "Simulá tu inscripción" dentro de Mi inscripción.
// Datos: horarios reales 2026 de 2.º año (PDF), notas inventadas.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ShareButton from '../components/ShareButton.astro';
---

<Layout title="Mi inscripción" tab="mis" crumbs={[{ label: 'Mi inscripción' }]}>
  <div class="layout">
    <div class="main" id="sim">
      <div class="topic">
        <div>
          <h1 data-titulo>Mi inscripción: primer cuatrimestre 2027</h1>
          <p data-bajada>La inscripción se hace en Autogestión.</p>
        </div>
        <div class="actions">
          <span data-propia><ShareButton titulo="Mirá mi inscripción" ruta="/mi-inscripcion" label="Compartir mi inscripción" /></span>
          <button type="button" class="btn primary hidden" data-copiar><Icon name="check" /> Copiar a mi inscripción</button>
        </div>
      </div>

      <div class="notice bad choques hidden" role="status" id="sim-choques"><Icon name="alert" /><div></div></div>

      <div class="semana" id="sim-semana" aria-label="Tu semana"></div>
      <div class="sim-toque hidden" id="sim-toque"></div>
      <div class="agenda hidden" id="sim-agenda" aria-label="Tu semana, día por día"></div>

      <div class="sim-filtro" data-propia>
        <span class="sub" id="turno-label">Turno:</span>
        <div class="seg" role="group" aria-labelledby="turno-label">
          <button type="button" data-turno="" aria-pressed="true">Todos</button>
          <button type="button" data-turno="M" aria-pressed="false">Mañana</button>
          <button type="button" data-turno="T" aria-pressed="false">Tarde</button>
          <button type="button" data-turno="N" aria-pressed="false">Noche</button>
        </div>
      </div>

      <div id="sim-materias"></div>

      <div class="sim-agregar" data-propia>
        <div class="sim-sumar">
          <Icon name="search" />
          <input type="search" id="sim-buscar" placeholder="Agregar otra materia" aria-label="Agregar otra materia" autocomplete="off" />
        </div>
        <div class="sugerencias hidden" id="sim-sug" role="listbox"></div>
      </div>
    </div>

    <aside class="side" aria-label="Cómo funciona el simulador" data-propia>
      <section class="panel">
        <h3>Cómo funciona</h3>
        <div class="in">
          <ol class="steps">
            <li>Agregá las materias que querés cursar.</li>
            <li>Elegí un curso de cada una. Están ordenados por puntaje: tocá uno para ver sus reseñas.</li>
            <li>Si dos cursos se pisan, se marcan en rojo. Probá con otro.</li>
            <li>Compartí tu inscripción con tu grupo.</li>
          </ol>
          <span class="sub">No te inscribe: eso se hace en Autogestión. Te avisamos cuando haya reseñas nuevas de los cursos que elegiste.</span>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<style is:global>
  @layer components {
    .foro .m1 { --mc: #2f6fb5; --mbg: #e6effa; }
    .foro .m2 { --mc: #2c8549; --mbg: #e5f3e9; }
    .foro .m3 { --mc: #8a5a1c; --mbg: #f7eedf; }
    .foro .m4 { --mc: #6f4fb8; --mbg: #eee8fa; }
    html[data-theme="dark"] .foro .m1 { --mc: #7fb0ea; --mbg: #1d2c40; }
    html[data-theme="dark"] .foro .m2 { --mc: #7cc796; --mbg: #1c3326; }
    html[data-theme="dark"] .foro .m3 { --mc: #e0b072; --mbg: #3a2d1c; }
    html[data-theme="dark"] .foro .m4 { --mc: #b9a0ef; --mbg: #2c2342; }

    .semana { display: grid; grid-template-columns: 40px repeat(var(--dias), minmax(0, 1fr)); border: 1px solid var(--line); background: var(--box); margin: 10px 0 12px; font-size: 11px; }
    .semana .dh { padding: 5px 4px; text-align: center; font-weight: bold; background: var(--cat); border-bottom: 1px solid var(--line); border-left: 1px solid var(--line-soft); }
    .semana .dh:first-child { border-left: 0; }
    .semana .horas, .semana .dia { position: relative; height: var(--alto); }
    .semana { position: relative; }
    .semana .dia { border-left: 1px solid var(--line-soft); }
    .semana .hl { position: absolute; left: 0; right: 0; height: 1px; background: var(--line-soft); }
    .semana .hueco { position: absolute; left: 0; right: 0; background: var(--row-a); border-top: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
    .semana .hueco-txt { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; font-size: 10.5px; color: var(--muted); pointer-events: none; }
    .semana .horas span { position: absolute; right: 5px; transform: translateY(-50%); color: var(--muted); font-size: 10px; }
    .semana .horas span:first-child { transform: none; }
    .bq { font: inherit; text-align: left; cursor: pointer; border-top: 0; border-right: 0; border-bottom: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; position: absolute; left: 2px; right: 2px; padding: 3px 5px; overflow: hidden; border-left: 3px solid var(--mc); background: var(--mbg); color: var(--ink); line-height: 1.25; text-decoration: none; }
    .foro a.bq:hover { text-decoration: none; filter: brightness(.97); }
    .bq b { display: block; color: var(--mc); }
    .bq.pisa b { color: var(--bad); }
    .bq .mt { display: block; }
    .bq .st { color: var(--muted); }
    .bq.pisa { border: 1px solid var(--bad); border-left: 3px solid var(--bad); background: repeating-linear-gradient(135deg, var(--mbg) 0 6px, var(--bad-bg) 6px 12px); }

    .agenda { border: 1px solid var(--line); margin: 10px 0 12px; background: var(--box); }
    .agenda .ad { display: grid; grid-template-columns: 74px minmax(0, 1fr); border-top: 1px solid var(--line-soft); }
    .agenda .ad:first-child { border-top: 0; }
    .agenda .ad > b { padding: 8px 8px; background: var(--cat); font-size: 12px; }
    .agenda .ad ul { list-style: none; margin: 0; padding: 4px 8px; }
    .agenda li { display: grid; grid-template-columns: 92px minmax(0,1fr); gap: 6px; padding: 4px 0 4px 8px; border-left: 3px solid var(--mc); margin: 3px 0; font-size: 12px; }
    .agenda li.pisa { border-left-color: var(--bad); color: var(--bad); }
    .agenda li .hs { color: var(--muted); }
    .agenda li.pisa .hs { color: var(--bad); }

    .sim-filtro { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; }
    .sim-m { border: 1px solid var(--line); margin-bottom: 10px; }
    .sim-m .plan-h { gap: 8px; }
    .sim-m .plan-h .cuad { width: 12px; height: 12px; background: var(--mc); border-radius: 2px; }
    .sim-m .plan-h .linklike { margin-left: auto; font-size: 11.5px; }
    .op { display: grid; grid-template-columns: 18px 44px minmax(0, 1fr) auto; gap: 2px 8px; align-items: baseline; padding: 7px 10px; border-top: 1px solid var(--line-soft); font-size: 12px; cursor: pointer; background: var(--box); }
    .op:first-of-type { border-top: 0; }
    .op:hover { background: var(--row-hover); }
    .op input { accent-color: var(--mc); margin: 0; align-self: center; }
    .op.sel { background: var(--mbg); }
    .op .cod { font-weight: bold; color: var(--link); }
    .op .hor { grid-column: 3 / 5; color: var(--muted); font-size: 11.5px; }
    .op .pisa-txt { grid-column: 3 / 5; color: var(--bad); font-size: 11.5px; }
    .op .nota { white-space: nowrap; }
    .sim-m .mas { display: block; width: 100%; text-align: left; padding: 6px 10px; border-top: 1px solid var(--line-soft); font-size: 12px; background: var(--row-a); }
    .sim-sumar { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px dashed var(--line); background: var(--row-a); }
    .sim-sumar svg { width: 16px; height: 16px; color: var(--muted); }
    .sim-sumar input { flex: 1; border: 0; background: transparent; font: 13px var(--f-body); color: var(--ink); outline: none; }

    .sim-toque { display: grid; grid-template-columns: 4px minmax(0,1fr); gap: 0 10px; margin: -4px 0 12px; border: 1px solid var(--line); background: var(--box); font-size: 12.5px; }
    .sim-toque > i { background: var(--mc); }
    .sim-toque > div { display: grid; gap: 3px; padding: 8px 10px 8px 0; }
    .sim-toque .acc { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 3px; }
    .bq.tocado { outline: 2px solid var(--mc); outline-offset: 1px; z-index: 2; }
    .sim-agregar { position: relative; }
    .sugerencias { position: absolute; left: 0; right: 0; bottom: calc(100% + 2px); z-index: 5; border: 1px solid var(--line); background: var(--box); box-shadow: 0 4px 14px var(--shadow); font-size: 12.5px; }
    .sugerencias .t { padding: 5px 10px; background: var(--cat); font-size: 11px; color: var(--muted); font-weight: bold; }
    .sugerencias button { display: flex; width: 100%; gap: 8px; align-items: center; padding: 8px 10px; border: 0; border-top: 1px solid var(--line-soft); background: var(--box); color: var(--ink); font: 12.5px var(--f-body); text-align: left; cursor: pointer; }
    .sugerencias button.act, .sugerencias button:hover { background: var(--row-hover); }
    .sugerencias button .sub { margin-left: auto; }
    .sugerencias mark { background: none; color: inherit; font-weight: bold; }
    .single .sim-filtro, .single .sim-agregar { display: none; }

    @container (max-width: 600px) {
      .semana { grid-template-columns: 30px repeat(var(--dias), minmax(0, 1fr)); font-size: 10px; }
      .bq { padding: 2px 3px; left: 1px; right: 1px; }
      .bq .st, .bq .mt-larga { display: none; }
      .op { grid-template-columns: 18px 40px minmax(0, 1fr) auto; padding: 9px 10px; }
    }
  }
</style>

<script>
  type B = [number, string, string];
  type C = { c: string; n: number; p: number; b: B[] };
  type M = { id: string; sigla: string; nombre: string; cursos: C[] };
  const MATERIAS: M[] = [
    { id: 'AM2', sigla: 'AM II', nombre: 'Análisis Matemático II', cursos: [
      { c: '2K1', p: 3.8, n: 14, b: [[1, '9:40', '11:10'], [2, '8:00', '10:25']] },
      { c: '2K2', p: 3.1, n: 9, b: [[2, '8:00', '9:30'], [3, '11:20', '14:00']] },
      { c: '2K3', p: 4.2, n: 11, b: [[1, '11:20', '14:00'], [2, '10:25', '12:05']] },
      { c: '2K4', p: 2.6, n: 7, b: [[1, '8:00', '9:30'], [2, '11:20', '14:00']] },
      { c: '2K5', p: 3.5, n: 4, b: [[3, '14:00', '16:25'], [4, '14:00', '15:40']] },
      { c: '2K6', p: 3.0, n: 6, b: [[1, '14:55', '16:25'], [4, '15:40', '18:05']] },
      { c: '2K8', p: 4.0, n: 8, b: [[1, '18:15', '20:40'], [4, '21:35', '23:05']] },
      { c: '2K9', p: 3.3, n: 5, b: [[2, '19:55', '22:20'], [5, '17:20', '19:00']] },
    ] },
    { id: 'SSL', sigla: 'SSL', nombre: 'Sintaxis y Semántica de los Lenguajes', cursos: [
      { c: '2K1', p: 4.4, n: 16, b: [[2, '10:25', '14:00'], [4, '8:00', '11:10']] },
      { c: '2K2', p: 3.6, n: 10, b: [[3, '8:00', '11:10'], [5, '8:00', '11:10']] },
      { c: '2K3', p: 3.2, n: 6, b: [[1, '8:00', '11:10'], [3, '10:25', '14:00']] },
      { c: '2K5', p: 3.9, n: 5, b: [[1, '12:05', '15:40'], [5, '13:15', '16:25']] },
      { c: '2K6', p: 2.9, n: 4, b: [[2, '12:05', '15:40'], [3, '14:55', '18:05']] },
      { c: '2K8', p: 4.1, n: 9, b: [[2, '17:20', '20:40'], [5, '19:55', '23:05']] },
      { c: '2K9', p: 3.4, n: 3, b: [[1, '19:55', '23:05'], [4, '17:20', '20:40']] },
    ] },
    { id: 'SO', sigla: 'SO', nombre: 'Sistemas Operativos', cursos: [
      { c: '2K1', p: 3.3, n: 12, b: [[1, '8:00', '9:30'], [5, '12:05', '14:00']] },
      { c: '2K2', p: 4.5, n: 15, b: [[2, '9:40', '11:10'], [4, '10:25', '12:05']] },
      { c: '2K3', p: 3.7, n: 8, b: [[2, '12:05', '14:00'], [4, '9:40', '11:10']] },
      { c: '2K4', p: 2.4, n: 5, b: [[1, '9:40', '11:10'], [2, '8:00', '9:30']] },
      { c: '2K5', p: 3.0, n: 3, b: [[3, '12:05', '14:00'], [5, '16:35', '18:05']] },
      { c: '2K6', p: 3.8, n: 6, b: [[1, '16:35', '18:05'], [5, '12:05', '14:00']] },
      { c: '2K7', p: 3.1, n: 4, b: [[1, '14:00', '15:40'], [2, '16:35', '18:05']] },
      { c: '2K8', p: 4.2, n: 7, b: [[3, '19:00', '20:40'], [4, '19:55', '21:25']] },
      { c: '2K9', p: 3.6, n: 5, b: [[3, '17:20', '19:00'], [5, '19:00', '20:40']] },
    ] },
    { id: 'PYE', sigla: 'PyE', nombre: 'Probabilidad y Estadística', cursos: [
      { c: '2K1', p: 3.9, n: 13, b: [[1, '11:20', '14:00'], [4, '11:20', '14:00']] },
      { c: '2K2', p: 3.2, n: 8, b: [[1, '10:25', '12:50'], [4, '8:00', '10:25']] },
      { c: '2K3', p: 4.0, n: 9, b: [[2, '8:00', '10:25'], [5, '10:25', '12:50']] },
      { c: '2K5', p: 3.4, n: 4, b: [[1, '15:40', '18:05'], [4, '15:40', '18:05']] },
      { c: '2K6', p: 2.8, n: 3, b: [[3, '12:05', '14:45'], [5, '14:00', '16:25']] },
      { c: '2K8', p: 3.7, n: 6, b: [[4, '17:20', '19:45'], [5, '17:20', '19:45']] },
      { c: '2K9', p: 3.5, n: 4, b: [[3, '20:40', '23:05'], [5, '20:40', '23:05']] },
    ] },
  ];
  const DIAS = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
  const DC = ['', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
  const min = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const hh = (x: number) => `${Math.floor(x / 60)}:${String(x % 60).padStart(2, '0')}`;
  const turnoDe = (c: string) => { const n = Number(c.slice(2)); return n <= 4 ? 'M' : n <= 7 ? 'T' : 'N'; };
  const TURNO = { M: 'Mañana', T: 'Tarde', N: 'Noche' } as Record<string, string>;
  const nota = (p: number) => p.toFixed(1).replace('.', ',');
  const estrellas = (p: number) => '★'.repeat(Math.round(p)) + `<span class="off">${'★'.repeat(5 - Math.round(p))}</span>`;

  const q = new URLSearchParams(location.search);
  const picks: Record<string, string> = Object.fromEntries((q.get('p') || 'AM2:2K1,SSL:2K2,SO:2K2,PYE:2K1').split(',').map((x) => x.split(':')));
  const abiertas = new Set((q.get('abrir') || '').split(',').filter(Boolean));
  let turno = q.get('turno') || '';
  const vista = q.get('vista') || 'grilla';
  let toque = q.get('toque') || '';
  const compartida = q.get('compartida') === '1';
  const CATALOGO = [
    { n: 'Análisis de Sistemas de Información', y: 2, c: 9 },
    { n: 'Física II', y: 2, c: 10 },
    { n: 'Paradigmas de Programación', y: 2, c: 3 },
    { n: 'Sistemas y Procesos de Negocio', y: 1, c: 16 },
    { n: 'Simulación', y: 4, c: 6 },
    { n: 'Seguridad en los Sistemas de Información', y: 5, c: 4 },
  ];
  if (compartida) {
    document.querySelector('[data-titulo]')!.textContent = 'La inscripción que te pasaron';
    document.querySelector('[data-bajada]')!.textContent = 'Primer cuatrimestre 2027';
    document.querySelectorAll('[data-propia]').forEach((x) => x.classList.add('hidden'));
    document.querySelector('[data-copiar]')!.classList.remove('hidden');
    document.querySelector('.layout')!.classList.add('single');
  }
  const sinTildes = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  function sugerir(texto: string) {
    const box = document.getElementById('sim-sug')!;
    const t = sinTildes(texto.trim());
    const lista = t ? CATALOGO.filter((x) => sinTildes(x.n).split(' ').some((w) => w.startsWith(t))) : CATALOGO.filter((x) => x.y === 2);
    const marcar = (n: string) => t ? n.split(' ').map((w) => sinTildes(w).startsWith(t) ? `<mark>${w.slice(0, t.length)}</mark>${w.slice(t.length)}` : w).join(' ') : n;
    box.innerHTML = (t ? '' : '<div class="t">Materias de 2.º año</div>') + lista.map((x, k) => `<button type="button" class="${k === 0 ? 'act' : ''}"><span class="yr y${x.y}">${x.y}.º</span><span>${marcar(x.n)}</span><span class="sub">${x.c} cursos</span></button>`).join('');
    box.classList.remove('hidden');
  }
  const buscar = document.getElementById('sim-buscar') as HTMLInputElement;
  buscar.addEventListener('focus', () => sugerir(buscar.value));
  buscar.addEventListener('input', () => sugerir(buscar.value));
  if (q.has('buscar')) { buscar.value = q.get('buscar') || ''; sugerir(buscar.value); }

  const curso = (m: M) => m.cursos.find((c) => c.c === picks[m.id])!;
  const bloquesDe = (m: M, c: C) => c.b.map(([d, a, z]) => ({ m, c, d, a: min(a), z: min(z) }));
  const pisa = (x: { d: number; a: number; z: number }, y: { d: number; a: number; z: number }) => x.d === y.d && Math.max(x.a, y.a) < Math.min(x.z, y.z);

  function render() {
    const elegidos = MATERIAS.map((m, i) => ({ m, i, c: curso(m) }));
    const todos = elegidos.flatMap((e) => bloquesDe(e.m, e.c).map((b) => ({ ...b, i: e.i })));
    // Choques
    const choques: string[] = [];
    const conChoque = new Set<any>();
    todos.forEach((x, a) => todos.forEach((y, b) => {
      if (b <= a || x.m === y.m || !pisa(x, y)) return;
      conChoque.add(x); conChoque.add(y);
      choques.push(`${x.m.sigla} (${x.c.c}) y ${y.m.sigla} (${y.c.c}) se pisan el ${DIAS[x.d].toLowerCase()} de ${hh(Math.max(x.a, y.a))} a ${hh(Math.min(x.z, y.z))}.`);
    }));
    const cb = document.getElementById('sim-choques')!;
    cb.classList.toggle('hidden', !choques.length);
    cb.querySelector('div')!.innerHTML = choques.map((t) => `<div>${t}</div>`).join('');

    // Grilla
    const sem = document.getElementById('sim-semana')!;
    const ag = document.getElementById('sim-agenda')!;
    sem.classList.toggle('hidden', vista !== 'grilla');
    ag.classList.toggle('hidden', vista !== 'agenda');
    const dias = 6;
    const desde = Math.floor(Math.min(...todos.map((b) => b.a)) / 60) * 60;
    const hasta = Math.ceil(Math.max(...todos.map((b) => b.z)) / 60) * 60;
    const angosta = sem.getBoundingClientRect().width < 500;
    const ppm = angosta ? 0.62 : 0.8;
    sem.style.setProperty('--dias', String(dias));
    // Horas sin ninguna clase (dos o más seguidas): se achican a una franja
    const HUECO = 26;
    const libre = (h: number) => !todos.some((b) => b.a < h + 60 && b.z > h);
    const huecos: [number, number][] = [];
    for (let h = desde; h < hasta; h += 60) {
      if (!libre(h)) continue;
      const u = huecos[huecos.length - 1];
      if (u && u[1] === h) u[1] = h + 60; else huecos.push([h, h + 60]);
    }
    const cortos = huecos.filter(([a, z]) => z - a >= 120);
    const y = (t: number) => {
      let v = (t - desde) * ppm;
      for (const [a, z] of cortos) { if (t >= z) v -= (z - a) * ppm - HUECO; else if (t > a) v -= (t - a) * ppm - ((t - a) / (z - a)) * HUECO; }
      return v;
    };
    sem.style.setProperty('--alto', `${y(hasta)}px`);
    sem.style.setProperty('--h', `${60 * ppm}px`);
    sem.style.setProperty('--off', `0px`);
    let html = '<div class="dh"></div>' + DC.slice(1, dias + 1).map((d) => `<div class="dh">${d}</div>`).join('');
    html += '<div class="horas">';
    const enHueco = (t: number) => cortos.some(([a, z]) => t > a && t < z);
    for (let t = desde; t < hasta; t += 60) if (!enHueco(t) && !cortos.some(([a]) => a === t && t !== desde)) html += `<span style="top:${y(t)}px">${t / 60}</span>`;
    html += '</div>';
    for (let d = 1; d <= dias; d++) {
      html += '<div class="dia">';
      for (let t = desde + 60; t < hasta; t += 60) if (!enHueco(t)) html += `<i class="hl" style="top:${y(t)}px"></i>`;
      for (const [a, z] of cortos) html += `<i class="hueco" style="top:${y(a)}px;height:${HUECO}px"></i>`;
      const del = todos.filter((b) => b.d === d).sort((a, b) => a.a - b.a);
      // carriles: si dos se pisan, van uno al lado del otro
      const carril = new Map<any, number>();
      const fin: number[] = [];
      del.forEach((b) => { let k = fin.findIndex((z) => z <= b.a); if (k < 0) { k = fin.length; fin.push(0); } fin[k] = b.z; carril.set(b, k); });
      del.forEach((b) => {
        const grupo = del.filter((o) => o === b || pisa(o, b));
        const n = Math.max(...grupo.map((o) => carril.get(o)!)) + 1;
        const k = carril.get(b)!;
        const ancho = n > 1 ? `left:calc(${(k * 100) / n}% + 1px);right:auto;width:calc(${100 / n}% - 2px);` : '';
        const alto = (b.z - b.a) * ppm;
        html += `<button type="button" data-toque="${b.m.id}" class="bq m${b.i + 1}${conChoque.has(b) ? ' pisa' : ''}${toque === b.m.id ? ' tocado' : ''}" style="top:${y(b.a)}px;height:${alto - 2}px;${ancho}">`
          + `<b>${b.c.c}</b><span class="mt">${b.m.sigla}</span>${alto > 50 ? `<span class="st">★ ${nota(b.c.p)} (${b.c.n})</span>` : ''}</button>`;
      });
      html += '</div>';
    }
    sem.innerHTML = html;
    const primera = sem.querySelector<HTMLElement>('.dia')!;
    for (const [a, z] of cortos) {
      const r = document.createElement('div');
      r.className = 'hueco-txt';
      r.style.top = `${primera.offsetTop + y(a)}px`;
      r.style.height = `${HUECO}px`;
      r.textContent = `Sin clases de ${a / 60} a ${z / 60}`;
      sem.appendChild(r);
    }

    // Bloque tocado: el detalle abajo de la semana
    const tc = document.getElementById('sim-toque')!;
    const et = elegidos.find((e) => e.m.id === toque);
    tc.classList.toggle('hidden', !et);
    tc.className = `sim-toque${et ? ` m${et.i + 1}` : ' hidden'}`;
    if (et) {
      tc.innerHTML = `<i></i><div><span><b>${et.m.nombre}</b>, ${et.c.c} · ${TURNO[turnoDe(et.c.c)]}</span>`
        + `<span><span class="stars">${estrellas(et.c.p)}</span> ${nota(et.c.p)} <span class="sub">· ${et.c.n} reseñas</span></span>`
        + `<span class="sub">${et.c.b.map(([d, a, z]) => `${DIAS[d]} ${a} a ${z}`).join(' · ')}</span>`
        + `<span class="acc"><a href="/dictado/1">Ver las reseñas</a>${compartida ? '' : `<button type="button" class="linklike" data-abrir="${et.m.id}">Cambiar de curso</button>`}</span></div>`;
    }

    // Agenda (opción B para el celular)
    let ah = '';
    for (let d = 1; d <= 6; d++) {
      const del = todos.filter((b) => b.d === d).sort((a, b) => a.a - b.a);
      if (!del.length) continue;
      ah += `<div class="ad"><b>${DIAS[d]}</b><ul>` + del.map((b) => `<li class="m${b.i + 1}${conChoque.has(b) ? ' pisa' : ''}"><span class="hs">${hh(b.a)} a ${hh(b.z)}</span><span><b>${b.m.sigla}</b> ${b.c.c}${conChoque.has(b) ? ' · se pisa' : ''}</span></li>`).join('') + '</ul></div>';
    }
    ag.innerHTML = ah;

    // Materias y sus cursos
    const cont = document.getElementById('sim-materias')!;
    cont.innerHTML = elegidos.map(({ m, i, c }) => {
      const otros = todos.filter((b) => b.m !== m);
      const abierta = abiertas.has(m.id);
      const lista = [...m.cursos].sort((a, b) => b.p - a.p || b.n - a.n).filter((x) => x === c || (!compartida && abierta && (!turno || turnoDe(x.c) === turno)));
      const filas = lista.map((x) => {
        const con = bloquesDe(m, x).flatMap((b) => otros.filter((o) => pisa(o, b)).map((o) => `${o.m.sigla} (${o.c.c})`));
        const unicos = [...new Set(con)];
        return `<label class="op${x === c ? ' sel' : ''}">${compartida ? '<span></span>' : `<input type="radio" name="r-${m.id}" value="${x.c}" ${x === c ? 'checked' : ''}>`}`
          + `<a class="cod" href="/dictado/1">${x.c}</a><span>${TURNO[turnoDe(x.c)]}</span><span class="nota"><span class="stars">${estrellas(x.p)}</span> ${nota(x.p)} <span class="sub">· ${x.n}</span></span>`
          + `<span class="hor">${x.b.map(([d, a, z]) => `${DC[d]} ${a} a ${z}`).join(' · ')}</span>`
          + (unicos.length ? `<span class="pisa-txt">Se pisa con ${unicos.join(' y ')}</span>` : '') + '</label>';
      }).join('');
      const resto = m.cursos.length - 1;
      return `<section class="sim-m m${i + 1}" data-m="${m.id}"><div class="plan-h"><span class="cuad"></span><b>${m.nombre}</b>${compartida ? '' : '<button type="button" class="linklike quitar">Quitar</button>'}</div>${filas}`
        + (compartida ? '' : `<button type="button" class="linklike mas" data-abrir="${m.id}">${abierta ? 'Ver menos' : `Ver los otros ${resto} cursos`}</button>`) + '</section>';
    }).join('');
  }

  document.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type !== 'radio') return;
    picks[t.name.slice(2)] = t.value;
    render();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-abrir],[data-turno],[data-toque]');
    if (!(e.target as HTMLElement).closest('.sim-agregar')) document.getElementById('sim-sug')!.classList.add('hidden');
    if (!b) return;
    if (b.dataset.toque) toque = toque === b.dataset.toque ? '' : b.dataset.toque;
    if (b.dataset.abrir) { const id = b.dataset.abrir; abiertas.has(id) ? abiertas.delete(id) : abiertas.add(id); }
    if (b.dataset.turno !== undefined) { turno = b.dataset.turno; document.querySelectorAll('[data-turno]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); }
    render();
  });
  if (turno) document.querySelectorAll<HTMLElement>('[data-turno]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.turno === turno)));
  render();
</script>
