---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { supabase, createSupabaseServerClient } from '../lib/supabase';
import { turnoLabel } from '../lib/format';
import { codigoDe } from '../lib/links';
import Escudo from '../components/Escudo.astro';
import LogroIcono from '../components/LogroIcono.astro';
import { LOGROS, logroPorId, progresoRango, rango } from '../lib/logros';

// Pantalla que aparece después de publicar una reseña (?curso=ID del curso)
const user = Astro.locals.user;
const dictadoId = parseInt(Astro.url.searchParams.get('curso') || '');
if (!Number.isInteger(dictadoId) || dictadoId <= 0) return Astro.redirect('/');
if (!user) return Astro.redirect(`/dictado/${dictadoId}`);

const one = (x: any) => (Array.isArray(x) ? x[0] || null : x || null);
const { client: userClient } = createSupabaseServerClient({ headers: Astro.request.headers, cookies: Astro.cookies });

const [{ data: dictado }, { data: mia }, { data: mias }, { data: logrosRaw }] = await Promise.all([
  supabase.from('dictados').select('id, materia_id, cursos ( identificador, turno ), materias ( id, nombre, nivel )').eq('id', dictadoId).single(),
  userClient.from('resenas').select('id, dictado_id').eq('user_id', user.id).eq('dictado_id', dictadoId).maybeSingle(),
  userClient.from('resenas').select('dictado_id').eq('user_id', user.id),
  userClient.from('logros_usuario').select('logro, ganado_at').eq('user_id', user.id),
]);
if (!dictado || !mia) return Astro.redirect(`/dictado/${dictadoId}`);

const curso = one((dictado as any).cursos);
const materia = one((dictado as any).materias);

// Materias de ese año que todavía no reseñó
const { data: delAnio } = await supabase.from('materias').select('id').eq('nivel', materia?.nivel || 0);
const idsResenados = (mias || []).map((r: any) => r.dictado_id);
let materiasResenadas = new Set<number>();
if (idsResenados.length) {
  const { data } = await supabase.from('dictados').select('id, materia_id').in('id', idsResenados);
  materiasResenadas = new Set((data || []).map((d: any) => d.materia_id));
}
const faltan = (delAnio || []).filter((m: any) => !materiasResenadas.has(m.id)).length;

// Rango y logros (migración 8): lo que ganaste con esta reseña
const n = (mias || []).length;
const miRango = rango(n);
const subiste = !!miRango && miRango.desde === n;
const prog = progresoRango(n);
const ORDEN = LOGROS.map((l) => l.id as string);
const misLogros = (logrosRaw || []).map((l: any) => l.logro as string).filter((l) => ORDEN.includes(l)).sort((a, b) => ORDEN.indexOf(a) - ORDEN.indexOf(b));
const hace15 = Date.now() - 15 * 60 * 1000;
const nuevos = (logrosRaw || []).filter((l: any) => new Date(l.ganado_at).getTime() > hace15).map((l: any) => logroPorId(l.logro)?.nombre).filter(Boolean);

const ruta = `/dictado/${dictadoId}`;
// El link lleva tu código corto (migración 9): no dice quién sos
const codigo = await codigoDe(user.id).catch(() => null);
const rutaCompartida = codigo ? `${ruta}?de=${codigo}` : ruta;
const nombre = `${materia?.nombre || 'la materia'}, ${curso?.identificador || 'tu curso'}`;
const mensaje = `Escribí una reseña de ${nombre} en UTN REP. Si cursaste, sumá la tuya así la próxima camada elige mejor 👉`;
---

<Layout title="Reseña publicada - UTN REP" crumbs={[{ label: materia?.nombre || 'Materia', href: `/materia/${materia?.id}` }, { label: curso?.identificador || 'Curso', href: ruta }, { label: 'Reseña publicada' }]}>
  <div class="layout single">
    <div class="main">
      <div class="done-box">
        <span class="big-check"><Icon name="check" /></span>
        <div>
          <h1>¡Listo! Tu reseña ya está publicada</h1>
          <p>Es de <b>{materia?.nombre}</b>, curso <b>{curso?.identificador}</b>{curso?.turno ? `, turno ${turnoLabel(curso.turno).toLowerCase()}` : ''}. Ya la puede leer cualquiera que busque ese curso.</p>
        </div>
      </div>

      {miRango && (
        <div class="unlock">
          <div class="u-badge"><Escudo rango={miRango.id} /></div>
          <div>
            <b>{subiste ? (n === 1 ? 'Ya sos Ingresante' : `Subiste a ${miRango.nombre}`) : `Sos ${miRango.nombre}`}</b>
            <span class="sub">
              {`${n} ${n === 1 ? 'reseña' : 'reseñas'}. `}
              {subiste && n > 1 ? 'Tu escudo nuevo ya se ve en todas tus reseñas. ' : ''}
              {prog.siguiente ? `Con ${prog.faltan} más llegás a ${prog.siguiente.nombre}.` : 'Es el rango más alto.'}
              {nuevos.length > 0 && <> {nuevos.length === 1 ? 'Logro nuevo' : 'Logros nuevos'}: <b class="inline">{nuevos.join(', ')}</b>.</>}
            </span>
          </div>
          {misLogros.length > 0 && <div class="logros">{misLogros.map((l) => <LogroIcono id={l} />)}</div>}
        </div>
      )}

      <section class="share-box">
        <h2><Icon name="share" /> Pasásela a tu curso</h2>
        <p class="sub" style="margin:0">Es donde se decide la inscripción. Te armamos el mensaje:</p>
        <div class="wa-msg" id="wa-msg" data-ruta={rutaCompartida}>{mensaje} <span class="link-curso">{`utnrep.app${rutaCompartida}`}</span></div>
        <div class="sh-acts">
          <a class="btn wa" id="enviar-wa" href={`https://wa.me/?text=${encodeURIComponent(`${mensaje} https://utnrep.app${rutaCompartida}`)}`} target="_blank" rel="noopener"><Icon name="share" /> Enviar por WhatsApp</a>
          <button type="button" class="btn quiet" id="copiar-link"><Icon name="link" /> <span>Copiar link</span></button>
        </div>
      </section>

      <div class="paths">
        <a href={`/finales/nuevo?materia=${materia?.id}`}>
          <Icon name="final" />
          <b>¿Rendiste el final?</b>
          <span class="sub">Contá cómo fue la mesa</span>
        </a>
        <a href={`/nueva-resena?from=${encodeURIComponent(`/nivel/${materia?.nivel}`)}`}>
          <Icon name="pen" />
          <b>Reseñar otro curso</b>
          <span class="sub">{faltan > 0 ? `Te quedan ${faltan} materia${faltan !== 1 ? 's' : ''} de este año` : 'Ya reseñaste todas las de este año'}</span>
        </a>
        <a href={`${ruta}#resena-${mia.id}`}>
          <Icon name="book" />
          <b>Ver tu reseña</b>
          <span class="sub">Así la ven los demás</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Con el dominio real del sitio donde esté corriendo (en las pruebas no es utnrep.app)
  const msg = document.getElementById('wa-msg');
  const ruta = msg?.dataset.ruta || '/';
  const url = new URL(ruta, location.origin).href;
  const link = msg?.querySelector('.link-curso');
  if (link) link.textContent = url.replace(/^https?:\/\//, '');
  const wa = document.getElementById('enviar-wa') as HTMLAnchorElement | null;
  const texto = (msg?.firstChild?.textContent || '').trim();
  if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(`${texto} ${url}`)}`;
  document.getElementById('copiar-link')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const lbl = btn.querySelector('span');
    try {
      await navigator.clipboard.writeText(url);
      if (lbl) lbl.textContent = '¡Copiado!';
    } catch {
      if (lbl) lbl.textContent = url;
    }
    setTimeout(() => { if (lbl) lbl.textContent = 'Copiar link'; }, 2500);
  });
</script>
