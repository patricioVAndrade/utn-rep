---
/**
 * ReviewCard — una reseña con formato de mensaje de foro.
 * Recibe filas de la vista `resenas_publicas` (sin user_id).
 * Las clases review-card, review-comment, review-edit-form, edit-*, delete-btn,
 * report-btn y btn-votar las usa src/scripts/dictado.ts.
 */
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import ShareButton from './ShareButton.astro';
import Quien from './Quien.astro';
import Escudo from './Escudo.astro';
import LogroIcono from './LogroIcono.astro';
import { COMO_TE_FUE, editadaEl, tiempoRelativo } from '../lib/format';
import { DIBUJOS } from '../lib/perfil';
import { rango } from '../lib/logros';
import type { Autor } from '../lib/fichas';

interface Props {
  resena: any;
  hidden?: boolean;
  esPropia?: boolean;
  votada?: boolean;
  logueado?: boolean;
  userIsAdmin?: boolean;
  /** Nombre real de una reseña anónima (solo se pasa a admins) */
  nombreAnonimo?: string;
  /** Versión de solo lectura (página de materia): sin botones */
  compact?: boolean;
  /** Curso al que pertenece, para mostrarlo en la cabecera */
  curso?: { label: string; href: string };
  /** Foto y ficha de quien la escribió (no se pasa en las anónimas) */
  autor?: Autor;
}

const {
  resena,
  hidden = false,
  esPropia = false,
  votada = false,
  logueado = false,
  userIsAdmin = false,
  nombreAnonimo,
  compact = false,
  curso,
  autor,
} = Astro.props;

const CONDICIONES: Record<string, { label: string; className: string }> = {
  PROMOCIONADO: { label: 'Promocionó', className: 'prom' },
  REGULAR: { label: 'Regularizó', className: 'reg' },
  LIBRE: { label: 'Quedó libre', className: 'libre' },
};
const condicion = resena.condicion_final ? CONDICIONES[resena.condicion_final] : undefined;
const votos = resena.votos_utilidad || 0;
const nombre = resena.es_anonima ? 'Anónimo' : resena.nombre_usuario || 'Estudiante';
const fecha = resena.created_at ? new Date(resena.created_at) : null;
const conAutor = !resena.es_anonima && autor ? autor : undefined;
const dibujo = conAutor?.foto === 'dibujo' ? DIBUJOS.find((d) => d.id === conAutor.dibujo) || DIBUJOS[0] : null;
const ficha = conAutor && !conAutor.ficha.privada ? conAutor.ficha : null;
const suRango = ficha ? rango(ficha.resenas) : null;
---
<article
  class:list={['post review-card', { 'review-extra hidden': hidden }]}
  id={`resena-${resena.id}`}
  data-date={resena.created_at}
  data-rating={resena.calificacion_general}
  data-votos={votos}
  data-id={resena.id}
>
  <div class="post-head">
    <span>
      {curso ? <a href={curso.href}>{curso.label}</a> : <a href={`#resena-${resena.id}`}>#{resena.id}</a>}
      {fecha && <> · <time datetime={resena.created_at}>{tiempoRelativo(resena.created_at)}</time></>}
      <span class="editada">{resena.updated_at ? ` · ${editadaEl(resena.updated_at)}` : ''}</span>
    </span>
    {resena.anio_cursado && <span class="tag">Cursó en {resena.anio_cursado}</span>}
  </div>
  <div class="post-main">
    <div class="author">
      <div class="avatar" aria-hidden="true">
        <span class:list={{ draw: !!dibujo }}>{resena.es_anonima
          ? <Icon name="user" />
          : conAutor?.google
            ? <img src={conAutor.google} alt="" referrerpolicy="no-referrer" loading="lazy" />
            : dibujo
              ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={dibujo.svg} />
              : nombre.charAt(0).toUpperCase()}</span>
      </div>
      <Quien nombre={nombre} anonimo={resena.es_anonima} ficha={conAutor?.ficha} />
      {suRango && <span class="rankline"><Escudo rango={suRango.id} /> {suRango.nombre}</span>}
      {ficha && ficha.logros.length > 0 && <span class="logros extra">{ficha.logros.map((l) => <LogroIcono id={l} />)}</span>}
      {resena.es_anonima && userIsAdmin && nombreAnonimo && (
        <span class="admin-peek" title="Visible solo para admin">({nombreAnonimo})</span>
      )}
      {resena.es_alumno_utn && (
        <span class="utn" title="Entró con un mail de la UTN"><Icon name="check" /> Mail UTN</span>
      )}
      {condicion && <span class:list={['cond', condicion.className]}>{condicion.label}</span>}
    </div>
    <div class="message">
      <div class="rate-line">
        <Stars value={resena.calificacion_general} />
        <b>{resena.calificacion_general} de 5</b>
      </div>
      {resena.comentario && <p class="review-comment">{resena.comentario}</p>}
      {resena.respuesta_moderador && <div class="mod"><b>Respuesta del moderador</b>{resena.respuesta_moderador}</div>}

      {esPropia && !compact && (
        <div class="review-edit-form hidden">
          <label class="sr" for={`edit-${resena.id}`}>Editar comentario</label>
          <textarea id={`edit-${resena.id}`} maxlength="2000" class="edit-textarea" rows="4">{resena.comentario}</textarea>
          <label class="edit-cond">
            <span>¿Cómo te fue?</span>
            <select class="edit-condicion">
              <option value="" selected={!resena.condicion_final}>Prefiero no decirlo</option>
              {COMO_TE_FUE.map((c) => <option value={c.valor} selected={resena.condicion_final === c.valor}>{c.texto}</option>)}
            </select>
          </label>
          <div class="edit-acts">
            <button type="button" class="save-edit-btn btn primary">Guardar</button>
            <button type="button" class="cancel-edit-btn btn quiet">Cancelar</button>
          </div>
        </div>
      )}
    </div>
  </div>

  {!compact && (
    <div class="post-tools">
      <div class="group">
        <button
          type="button"
          class:list={['btn-votar btn', votada ? 'pressed' : 'quiet']}
          data-id={resena.id}
          data-votada={votada ? 'true' : 'false'}
          data-logueado={logueado ? 'true' : 'false'}
          aria-pressed={votada ? 'true' : 'false'}
          title={logueado ? 'Marcar como útil' : 'Iniciá sesión para votar'}
        >
          <Icon name="thumb" /> Me sirvió <span class="votos-count">{votos}</span>
        </button>
        {logueado && !esPropia && (
          <button type="button" class="report-btn btn quiet" title="Reportar reseña"><Icon name="flag" /> Reportar</button>
        )}
        <ShareButton mini titulo="Mirá esta reseña en UTN REP" ruta={`/dictado/${resena.dictado_id}#resena-${resena.id}`} />
      </div>
      {(esPropia || userIsAdmin) && (
        <div class="group">
          {esPropia && <button type="button" class="edit-btn btn quiet"><Icon name="edit" /> Editar</button>}
          <button type="button" class="delete-btn btn danger"><Icon name="trash" /> Eliminar</button>
        </div>
      )}
    </div>
  )}
</article>
