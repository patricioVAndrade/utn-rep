---
/**
 * ReviewCard — tarjeta de una reseña en la página del dictado.
 * Recibe filas de la vista `resenas_publicas` (sin user_id).
 */
import { estrellas, tiempoRelativo } from '../lib/format';

interface Props {
  resena: any;
  hidden?: boolean;
  esPropia: boolean;
  votada: boolean;
  logueado: boolean;
  userIsAdmin: boolean;
  /** Nombre real de una reseña anónima (solo se pasa a admins) */
  nombreAnonimo?: string;
  badgeColor: string;
}

const { resena, hidden = false, esPropia, votada, logueado, userIsAdmin, nombreAnonimo, badgeColor } = Astro.props;

const CONDICIONES: Record<string, { label: string; className: string }> = {
  PROMOCIONADO: { label: 'Promocionado', className: 'bg-green-900/30 text-green-400 border-green-800/50' },
  REGULAR: { label: 'Regular', className: 'bg-yellow-900/30 text-yellow-400 border-yellow-800/50' },
  LIBRE: { label: 'Libre', className: 'bg-red-900/30 text-red-400 border-red-800/50' },
};
const condicion = resena.condicion_final ? CONDICIONES[resena.condicion_final] : undefined;
const votos = resena.votos_utilidad || 0;
---
<div class={`review-card bg-[#242424] rounded-2xl border border-neutral-700/60 p-5 sm:p-6 hover:shadow-md transition-shadow ${hidden ? 'review-extra hidden' : ''}`}
     data-date={resena.created_at}
     data-rating={resena.calificacion_general}
     data-votos={votos}
     data-id={resena.id}>

  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex items-center gap-3">
      <div class={`w-10 h-10 ${resena.es_anonima ? 'bg-neutral-700' : badgeColor} rounded-full flex items-center justify-center text-white font-bold text-sm`} aria-hidden="true">
        {resena.es_anonima ? (
          <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        ) : (
          (resena.nombre_usuario || 'U').charAt(0).toUpperCase()
        )}
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <p class="font-semibold text-neutral-100 text-sm flex items-center gap-2 flex-wrap">
            <span>
              {resena.es_anonima ? 'Anónimo' : (resena.nombre_usuario || 'Estudiante')}
              {resena.es_anonima && userIsAdmin && nombreAnonimo && (
                <span class="text-[10px] text-red-400/70 font-normal ml-1" title="Visible solo para admin">({nombreAnonimo})</span>
              )}
            </span>

            {condicion && (
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border uppercase tracking-wide ${condicion.className}`}>
                {condicion.label}
              </span>
            )}
          </p>
          {resena.es_alumno_utn && (
            <span class="inline-flex items-center gap-0.5 bg-blue-900/40 text-blue-400 text-[10px] font-bold px-1.5 py-0.5 rounded-full border border-blue-700/50" title="Alumno verificado de UTN FRC">
              <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              UTN
            </span>
          )}
        </div>
        <p class="text-xs text-neutral-500 mt-0.5">
          {resena.anio_cursado ? `Cursó en ${resena.anio_cursado}` : ''}
          {resena.anio_cursado && resena.created_at ? ' · ' : ''}
          {resena.created_at ? tiempoRelativo(resena.created_at) : ''}
        </p>
      </div>
    </div>
    <div class="flex items-center gap-1.5 flex-shrink-0" aria-label={`Calificación: ${resena.calificacion_general} de 5`}>
      <span class="text-yellow-500 text-lg" aria-hidden="true">{estrellas(resena.calificacion_general)}</span>
      <span class="font-bold text-neutral-300 text-sm">{resena.calificacion_general}</span>
    </div>
  </div>

  {resena.comentario && (
    <p class="review-comment text-neutral-400 text-sm leading-relaxed">
      {resena.comentario}
    </p>
  )}

  {esPropia && (
    <div class="review-edit-form hidden mt-3">
      <textarea aria-label="Editar comentario" maxlength="2000" class="edit-textarea w-full px-3 py-2 rounded-xl border border-neutral-700 bg-[#1a1a1a] text-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400/50 resize-none" rows="3">{resena.comentario}</textarea>
      <div class="flex gap-2 mt-2">
        <button class="save-edit-btn text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-white px-4 py-1.5 rounded-lg transition-colors cursor-pointer">Guardar</button>
        <button class="cancel-edit-btn text-xs font-semibold text-neutral-400 hover:text-neutral-200 px-3 py-1.5 transition-colors cursor-pointer">Cancelar</button>
      </div>
    </div>
  )}

  <div class="flex items-center justify-between mt-3 pt-3 border-t border-neutral-700/40">

    {(esPropia || userIsAdmin) ? (
      <div class="flex items-center gap-3">
        {esPropia && (
          <button class="edit-btn text-xs text-amber-400 hover:text-amber-300 flex items-center gap-1 cursor-pointer transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            Editar
          </button>
        )}
        <button class="delete-btn text-xs text-red-400/70 hover:text-red-400 flex items-center gap-1 cursor-pointer transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          Eliminar
        </button>
      </div>
    ) : (
      <div></div>
    )}

    <div class="flex items-center gap-3">

      <button
        class={`btn-votar flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg transition-colors border active:scale-95 text-xs font-semibold cursor-pointer ${votada ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' : 'bg-[#2a2a2a] hover:bg-[#333333] text-neutral-400 border-neutral-700/50'}`}
        data-id={resena.id}
        data-votada={votada ? 'true' : 'false'}
        data-logueado={logueado ? 'true' : 'false'}
        aria-pressed={votada ? 'true' : 'false'}
        aria-label="Marcar como útil"
        title={logueado ? 'Marcar como útil' : 'Iniciá sesión para votar'}
      >
        <svg class="w-3.5 h-3.5" fill={votada ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
        </svg>
        <span class="votos-count">{votos}</span>
      </button>

      {logueado && !esPropia && (
        <button class="report-btn text-xs text-neutral-600 hover:text-red-400 flex items-center gap-1 cursor-pointer transition-colors" title="Reportar reseña">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
          Reportar
        </button>
      )}
    </div>

  </div>
</div>
