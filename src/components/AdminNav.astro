---
/** Menú lateral del panel de admin, como en la V6. */
import { supabaseAdmin } from '../lib/supabase-admin';

interface Props {
  actual: 'resumen' | 'reportes' | 'finales' | 'importar';
}
const { actual } = Astro.props;
const { count: reportes } = await supabaseAdmin.from('reportes_resenas').select('id', { count: 'exact', head: true });
const cur = (s: string) => (s === actual ? 'page' : undefined);
---
<nav class="anav" aria-label="Secciones del panel">
  <a href="/admin" aria-current={cur('resumen')}>Resumen</a>
  <a href="/admin/reportes" aria-current={cur('reportes')}>Reportes{(reportes || 0) > 0 && <span class="cnt">{reportes}</span>}</a>
  <a href="/admin/gestion#resenas">Reseñas</a>
  <a href="/admin/finales" aria-current={cur('finales')}>Finales</a>
  <a href="/admin/gestion#dictados">Materias y cursos</a>
  <a href="/admin/gestion#profesores">Profesores</a>
  <a href="/admin/importar" aria-current={cur('importar')}>Importar cuatrimestre</a>
  <span class="later">Usuarios <span class="soon">etapa 3</span></span>
  <span class="later">Cambios de profesores <span class="soon">2027</span></span>
</nav>
