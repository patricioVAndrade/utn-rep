---
/**
 * Botón "Compartir": en el celular abre el menú para compartir del teléfono
 * y en la compu abre WhatsApp Web con el texto y el link.
 */
import Icon from './Icon.astro';

interface Props {
  /** Texto que acompaña al link */
  titulo: string;
  /** Ruta a compartir (por defecto, la página actual sin parámetros) */
  ruta?: string;
  /** Botón chico, para usar dentro de una reseña */
  mini?: boolean;
  label?: string;
  /** Sin la etiqueta "Nuevo" de Compartir (cuando hay otro botón de compartir en la página) */
  sinNuevo?: boolean;
}
const { titulo, ruta, mini = false, label = 'Compartir', sinNuevo = false } = Astro.props;
---
<button type="button" class:list={['btn', mini ? 'quiet' : 'wa']} data-share data-titulo={titulo} data-ruta={ruta} title={label} data-nuevo={mini || sinNuevo ? undefined : 'compartir'}>
  <Icon name="share" /> <span class="lbl">{label}</span>
</button>

<script>
  import { conCodigo } from '../scripts/links';
  // El link lleva tu código corto (?de=) si iniciaste sesión: no dice quién sos.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-share]');
    if (!btn) return;
    const url = conCodigo(new URL(btn.dataset.ruta || location.pathname, location.origin).href);
    const texto = btn.dataset.titulo || document.title;
    const celular = matchMedia('(pointer: coarse)').matches;
    if (celular && navigator.share) {
      try { await navigator.share({ title: texto, text: texto, url }); } catch { /* lo cerró */ }
      return;
    }
    window.open(`https://wa.me/?text=${encodeURIComponent(`${texto} ${url}`)}`, '_blank', 'noopener');
  });
</script>
