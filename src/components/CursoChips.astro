---
/** Chips de un curso: turno, cuatrimestre, contracuatrimestre, intensivo y electiva. */
import { turnoClase, turnoLabel } from '../lib/format';

interface Props {
  turno?: string | null;
  periodo?: string | null;
  contra?: boolean | null;
  intensivo?: boolean | null;
  electiva?: { puntos?: number | null } | null;
  /** Versión chica para tablas */
  mini?: boolean;
}
const { turno, periodo, contra, intensivo, electiva, mini = false } = Astro.props;
const PERIODOS: Record<string, string> = {
  PRIMER_CUATRIMESTRE: '1.er cuatrimestre',
  SEGUNDO_CUATRIMESTRE: '2.º cuatrimestre',
  ANUAL: 'Anual',
};
const esAnual = periodo === 'ANUAL';
---
<span class="chips">
  {turno !== undefined && (mini
    ? <span class:list={['tt', turnoClase(turno)]}>{turnoLabel(turno)}</span>
    : <span class:list={['chip turno', turnoClase(turno)]}>Turno {turnoLabel(turno).toLowerCase()}</span>)}
  {periodo && PERIODOS[periodo] && <span class="chip">{PERIODOS[periodo]}</span>}
  {contra && !esAnual && <span class="chip" title="Se dicta en el cuatrimestre contrario al habitual">Contracuatrimestre</span>}
  {intensivo && <span class="chip">Intensivo</span>}
  {electiva && <span class="chip elec">Electiva ({electiva.puntos || 0} pts)</span>}
</span>
